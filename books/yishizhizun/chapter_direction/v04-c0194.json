{
  "schema_version": 1,
  "chapter_id": "v04-c0194",
  "title": "第一百九十四章 装疯卖傻",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "69815e207c3f0e279dfb0dd932ce2de52c331346cdca72b792d45b57889943c7",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S19",
  "pov": "兄弟话坐实暂合作、搜殿后离开获准与装疯说玉珑紫要求",
  "attribution_caution": "合作是真已同意但非永久结拜共王，均分未执行、退获许还未离。人皇剑难久只部分醒高私说非耗尽，天帝玉册部分不是孟得到；玉珑紫要求未施行不医学定论。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 16,
      "label": "落地兄弟套话顾主动认亲",
      "direction": "孟顾没逃虚云高抓落地，韩不反驳是忌剑己方法王崔追利益不能翻。高说昔韩帝高皇共界亲兄弟口话无拜仪，顾两伯伯小媳妇角色接话提暂合作，婚称不等正式婚。",
      "evidence": [
        "v04-c0194:p0001",
        "v04-c0194:p0016"
      ]
    },
    {
      "paragraph_start": 17,
      "paragraph_end": 28,
      "label": "法王现韩应探索分宝",
      "direction": "高取面具性情人意，邀法王宝均秘籍各记，法王担圣女话止。原高挡法王韩杀孟顾计划叙明被变。韩断高道德说教应就这么办，高宣布顾释三生天帝行宫韩答好，合作获同意物未实分。",
      "evidence": [
        "v04-c0194:p0017",
        "v04-c0194:p0028"
      ]
    },
    {
      "paragraph_start": 29,
      "paragraph_end": 46,
      "label": "孟仍防韩唤醒正常高并获退出许",
      "direction": "孟知道自己顾雷字今生镜唤疯，早知陆大触转换亦新防冲和。提出探索三生后离去，高考天庭崔援许，韩秘密传音已实危险没消。三殿过去来世几毁今生劈半镜名功能明确，没收镜或新治疗。",
      "evidence": [
        "v04-c0194:p0029",
        "v04-c0194:p0046"
      ]
    },
    {
      "paragraph_start": 47,
      "paragraph_end": 55,
      "label": "高秘密讲装疯算计与剑代价",
      "direction": "高传音警顾难降、称装疯坐实韩借兄弟防韩罗教忽翻盟，剑微醒难久、韩玉册部分助醒。是本人说明，孟认为仍真疯但不傻；不得代一方断全装或绝没战略。",
      "evidence": [
        "v04-c0194:p0047",
        "v04-c0194:p0055"
      ]
    },
    {
      "paragraph_start": 56,
      "paragraph_end": 61,
      "label": "遮传音禁触名与顾杀玉珑紫要求",
      "direction": "孟求高遮掩实告顾别陆冲，顾答记得真疯，孟提玉珑紫顾说若再见一定杀她。未来指令而非已杀、两身份谜未解，最终嗯属孟心疑。",
      "evidence": [
        "v04-c0194:p0056",
        "v04-c0194:p0061"
      ]
    }
  ],
