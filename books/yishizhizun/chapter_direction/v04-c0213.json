{
  "schema_version": 1,
  "chapter_id": "v04-c0213",
  "title": "第二百一十三章 古镜",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "d37865f107494d886a81cfd36da08b41d6bca7cc8598b9053336f8164d0eaf56",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S20",
  "pov": "幻宫诸界古镜、宋表象揭罗刹化身，树触镜握符未决",
  "attribution_caution": "宋真实本源本章才揭，化身宗师左右七重为孟评，本体法身未到；镜来历与传说法理归罗刹授说。树触未吞、符握未用，真实昊天镜与来世镜碎片分开。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 15,
      "label": "诸界光门与同一个地球自己",
      "direction": "幻宫凝虚墙反光场景万千，孟由自身世界观解释万界投影猜仙关联。小如称每门不同我，孟实感所有脸皆地球时代自己、止感复原，鱼垂钓区分仍疑，未穿每门游万界。",
      "evidence": [
        "v04-c0213:p0001",
        "v04-c0213:p0015"
      ]
    },
    {
      "paragraph_start": 16,
      "paragraph_end": 25,
      "label": "分身护皮试触镜失败，大道树轻应",
      "direction": "孟试手分身显化外皮小心触古镜虚无穿过，树轻应让其认为仙界相关；小如说万年无法触收真身，镜纹非篆孟不识，未获完整镜实体或传承。",
      "evidence": [
        "v04-c0213:p0016",
        "v04-c0213:p0025"
      ]
    },
    {
      "paragraph_start": 26,
      "paragraph_end": 41,
      "label": "宋突至，罗刹化身身份揭明",
      "direction": "阴冷声宋血瞳高深出现，孟挡小如由功法问尊者，宋自称被扰转世孟认罗刹，叙述后沿罗刹名。化身宗师左右孟评七重非法身本体已到，感危被境界压制。小如仇恨收养质问，罗刹承杀尾才知所在故扮师等醒忆为其说明。",
      "evidence": [
        "v04-c0213:p0026",
        "v04-c0213:p0041"
      ]
    },
    {
      "paragraph_start": 42,
      "paragraph_end": 53,
      "label": "昊天镜来历与他我法理属罗刹讲述",
      "direction": "罗刹称镜精气源昊天上帝镇世镜破、青帝重铸又碎，此处残丝衍化可通万界照他我。血线包幻宫实见；法身感他我踏传说之路、秘法可提前而大患为他授说，孟理解秘法真用是感他我，不等自己法身或传说已达。",
      "evidence": [
        "v04-c0213:p0042",
        "v04-c0213:p0053"
      ]
    },
    {
      "paragraph_start": 54,
      "paragraph_end": 61,
      "label": "孟指出拖延、血煞大阵暗布威胁",
      "direction": "孟评化身七重怕神兵宝物故等万虫或本体，真实援者未到；罗刹承阵布未必拿下但可困为其威胁，小如冷汗心跳。现身仅化身，不能追加本体实体或孟已被永困。",
      "evidence": [
        "v04-c0213:p0054",
        "v04-c0213:p0061"
      ]
    },
    {
      "paragraph_start": 62,
      "paragraph_end": 66,
      "label": "孟轻快转招，树触镜、四臂握符尚未决",
      "direction": "孟未必哦轻笑左碧树触昊镜，长另两臂拉小如紧捏古符，内心拿不到喂树。四臂非已再法天两头、古符未实催末次未耗，树尚无吸收描。罗刹首变脸血海凸，章末逃脱或胜负未给。",
      "evidence": [
        "v04-c0213:p0062",
        "v04-c0213:p0066"
      ]
    }
  ],
