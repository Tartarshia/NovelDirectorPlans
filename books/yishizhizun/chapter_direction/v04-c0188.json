{
  "schema_version": 1,
  "chapter_id": "v04-c0188",
  "title": "第一百八十八章 一个妖异的桃子",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "583f1be2887cbb74ddd0744e42345e93d4bfc5dd0cbe7dec04e488196450920d",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S19",
  "pov": "园内夹击脱险、规则解释与桃子追随",
  "attribution_caution": "第一雷击刺空后仍有寒气，第二似击物也不知敌名死活；寿星头活是动作非人格复活。出园已实似恢复，十年是回看预警未损实数。桃近未知善恶，三生殿未至。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 21,
      "label": "雷刺未明结果、枝蔓与后影双夹",
      "direction": "寿星眼空不等复生说话。孟至阳倒刺刺空结果不知，血根藤网实起顾漩涡牵孟流火分光挡。后冷风仍来，雷刀敛成古拙刚猛融八九预危似击古怪物借震腾跃，脑身不转。",
      "evidence": [
        "v04-c0188:p0001",
        "v04-c0188:p0021"
      ]
    },
    {
      "paragraph_start": 22,
      "paragraph_end": 40,
      "label": "疑翻天印与脑桃、四臂借冲脱束",
      "direction": "孟见裂头五指痕猜翻天印又疑不合，非认凶手。头内妖异桃血脉皮令幻觉，树轻异动未吞。实再两臂持玄龟紫电雷刀，头活摇束缚增，双沉刀剑碰造冲短抵束飞扑，树全未断。",
      "evidence": [
        "v04-c0188:p0022",
        "v04-c0188:p0040"
      ]
    },
    {
      "paragraph_start": 41,
      "paragraph_end": 56,
      "label": "林边根绊应对与出园恢复征象",
      "direction": "孟顾不语奔，孟根绊将倒喷白气击穿石借力折身实出林，动静危险消。顾赞后两人外貌自感似复原未服药，孟欲回看先问未回，顾说回看至少损十年。二人接受继续赶路非已到目的地。",
      "evidence": [
        "v04-c0188:p0041",
        "v04-c0188:p0056"
      ]
    },
    {
      "paragraph_start": 57,
      "paragraph_end": 69,
      "label": "传音宇宙法理与三灯解释",
      "direction": "顾传音九重天法理源，孟忆黄粱真实界宇宙论，仙界破碎疑。顾说蟠桃寿一纪元、法身三百余因天地变、园为显化小源与三灯回头易灭，孟归纳遵规则防影响。均角色理论不自动已用实验证全古史，瑶池例未到。",
      "evidence": [
        "v04-c0188:p0057",
        "v04-c0188:p0069"
      ]
    },
    {
      "paragraph_start": 70,
      "paragraph_end": 76,
      "label": "三生殿说与追来血桃",
      "direction": "孟郑重问顾目的，顾称三生殿永随相公，孟只猜目标之一真非全信情话。身旁云中半个血桃怯探，桃追来为当下见与推认，未接收食用收存或新敌战开始。",
      "evidence": [
        "v04-c0188:p0070",
        "v04-c0188:p0076"
      ]
    }
  ],
