  "chapter_id": "v04-c0310",
  "title": "第三百一十章 真身",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "82d01a1ec0997fbd21d99d434e1341fe52990914f1c0654f3b95b66b6409c5eb",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S39",
  "pov": "神兵极速来援扰计、幽冥真身与幻域事故扩大",
  "attribution_caution": "叶真持寒光剑、哈射日弓身上明确。断左臂匿名武士非哈，未死；明曾局转未全解危。幽冥真身半法身与黄泉骨明确，形似神兵不全构造定。碎物未知开域实扩千里，孟安全停也入雾非八九全免；峰叹未真名真实认证。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 13,
      "label": "明曾求援与叶实持寒光神兵极速赴湖",
      "direction": "明法水月庵曾若瑄碧月剑派被哈+4围、已放信等待援为自身估。哈身带射日弓未暴露留援，棺伏铁黑。叶察险领队责任拿冰魄寒光剑神兵、催速两三呼息感到二人，神兵本章明确不是专属孟神兵。",
      "evidence": [
        "v04-c0310:p0001",
        "v04-c0310:p0013"
      ]
    },
    {
      "paragraph_start": 14,
      "paragraph_end": 26,
      "label": "计划受突发神兵扰乱、幽冥双笔介入",
      "direction": "哈众卖力演留敌，叶先众来寒斩，惊叶有神兵导致未集众开域不值/不开难抗两难。幽冥生死双判官笔太极阻寒光，哈猜外人未知陷位尚可诱，26除了拉弓更全力封二女逃，未此刻射箭命中。",
      "evidence": [
        "v04-c0310:p0014",
        "v04-c0310:p0026"
      ]
    },
    {
      "paragraph_start": 27,
      "paragraph_end": 39,
      "label": "叶星雪剑域救势与匿名武士断臂、神弓显",
      "direction": "叶见双笔警张窍法相百里星域星化雪剑，袭棺哈五。匿名武士肩冻自右银爪扯左肩臂冰碎，非哈再断/该人死。明千臂曾碧月反局，37短抗法身泛实力说明非实际新法身入战，38射日弓哈身前39弦微动大日消雪无飞箭明确击人。",
      "evidence": [
        "v04-c0310:p0027",
        "v04-c0310:p0039"
      ]
    },
    {
      "paragraph_start": 40,
      "paragraph_end": 50,
      "label": "幽冥开棺真身、黄河相与叶凝重交战",
      "direction": "黑大掌白毛棺盖掀黄雾温泉状，十丈玄衮高冠坐起震空二三百里兽木虫生机毁不人全死。后虚血黄河似法相，46幽冥半法身真身神兵组成感比喻非全神兵确镶。生死笔接攻雪被刷，叶评强残法身而己相未全显，冰湖裂浪冻雕战未胜负。",
      "evidence": [
        "v04-c0310:p0040",
        "v04-c0310:p0050"
      ]
    },
    {
      "paragraph_start": 51,
      "paragraph_end": 59,
      "label": "援众包括何休、孟预警陈刘真跟与超域事故",
      "direction": "几息援宗来含何休，孟近湖少危险停陈带刘追问名新实跟。幽冥待大部入围碎未知物55开域，黄泉骨与魔气因没棺隔勾实际扩千里超自身预计。安全距孟也包雾吸扭似九幽不真九幽认证，未全同伴死亡。",
      "evidence": [
        "v04-c0310:p0051",
        "v04-c0310:p0059"
      ]
    },
    {
      "paragraph_start": 60,
      "paragraph_end": 62,
      "label": "孟元心佛镇查幻见峰叹、陈刘传音比禁法",
      "direction": "孟疑幻暗元心印金佛镇琉璃眼神光穿雾见巍峰叹61坐化句，声来源真名及真实/幻像未证不魔君本人实认证。陈护刘传音像冰雪仙宫外禁为其疑似比较，不他们已经进宫/已懂破域。",
      "evidence": [
        "v04-c0310:p0060",
        "v04-c0310:p0062"
      ]
    }
  ],
