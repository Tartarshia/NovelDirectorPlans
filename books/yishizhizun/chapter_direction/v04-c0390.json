  "title": "第三百九十章 四象印",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "5865bd36928f2386176ccc5e0ff3ec003e9f33b827661f0d5e2567cdd1de331f",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S56",
  "pov": "反控取印行动进入宫内，先机与多方拦截",
  "attribution_caution": "短抗法身不新法身晋；发丝分身受拳灰灭非真孟死，八真为齐推、起源据说。四象印未领、唐弹指点向未命中；镜为唐功法显化不高览今生镜借到。源紫白金黄三色按紫/白/金黄可通，不误造色数矛盾。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 7,
      "label": "宫感引来诸王，孟齐先行抵达",
      "direction": "楚金光洞醒持如意出，唐汉秦明诸王感；孟齐有准备先裹金莲穿虚空到古井宫前，近无处不在感觉非传说晋。",
      "evidence": [
        "v04-c0390:p0001",
        "v04-c0390:p0007"
      ]
    },
    {
      "paragraph_start": 8,
      "paragraph_end": 18,
      "label": "楚挪移拳拦路，发丝代灾真身抢入",
      "direction": "楚认有缘墨家苏墨=孟而非齐，右如意缠齐左拳逐孟；逐去实发丝分身灰灭，孟借刀虚空藏真身现于楚上闯门。外景巅峰持兵短抗法身非同阶长期胜，赶先机不等齐联杀楚。",
      "evidence": [
        "v04-c0390:p0008",
        "v04-c0390:p0018"
      ]
    },
    {
      "paragraph_start": 19,
      "paragraph_end": 30,
      "label": "楚一次木偶解袖与八门，齐现神身追阻",
      "direction": "楚撕虚空并木偶投袖，仅抵消一次；八身气真齐识八门推近距八真/据说天仙为突破传说创，不楚已传说。齐神身庆云灯莲持鞭仿旗追，未击杀楚或八身入门结果。",
      "evidence": [
        "v04-c0390:p0019",
        "v04-c0390:p0030"
      ]
    },
    {
      "paragraph_start": 31,
      "paragraph_end": 36,
      "label": "孟刀光开混沌奔四象，唐镜锁定",
      "direction": "孟冲房舍奔四象殿，诸帝法身到各面，唐文王明确面白无须斯文金袍玉冠不急入，神功凝镜照孟；路线剩四象至开天便锁，不借高今镜到手/旧匿名皇者自动全合名。",
      "evidence": [
        "v04-c0390:p0031",
        "v04-c0390:p0036"
      ]
    },
    {
      "paragraph_start": 37,
      "paragraph_end": 40,
      "label": "四象虚盒与镜中唐手，抢印突遇袭",
      "direction": "门开白赤青黑殿虚玉盒半开地火风水生灭；孟封神知识恍悟四象对应何物但本章未直命名独断神器，与传说三霄假设比较非有人被杀。到殿门未取印，左清镜唐伸手弹指点向，袭击结果未知。",
      "evidence": [
        "v04-c0390:p0037",
        "v04-c0390:p0040"
      ]
    }
  ],
