{
  "schema_version": 1,
  "chapter_id": "v04-c0264",
  "title": "第二百六十四章 云鹤的要求",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "e0a3db0c8587991439ac558ac5ad4792d6f1b3d9d413628e43b0757a7caa3d18",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S32",
  "pov": "云鹤条件援助协商、双印换得与毒手身份实际金帐入局",
  "attribution_caution": "阳神云鹤确、门暂保管获答非已交毁永久送、两后条件仅有边界撮合；孟真宗师公开毒手六重，已到门口元心影响两守，核验替换计划未完。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 12,
      "label": "双印实际换得、入洞天见阳神云鹤与熟人打趣",
      "direction": "2以总纲元心感悟机会交换翻天戊己传承实成五印，恐怕天庭后最多是推语不是全球绝对榜。3门入洞天到主峰7被移静室；5/8云鹤阳神确认，多年与掌纲助因6孟推。9第三梯数年未来玩笑非已晋。",
      "evidence": [
        "v04-c0264:p0001",
        "v04-c0264:p0012"
      ]
    },
    {
      "paragraph_start": 13,
      "paragraph_end": 24,
      "label": "云鹤愿助但三条件、孟自决一项余两需传话",
      "direction": "孟全告局势与叶评力量，云鹤承担道门兼宗门责任。18门暂保管事不谐毁以保洞天19孟答应，未逐物实际交付；20无主山头重新立派愿望、21雪山祖师情报需法身协调，孟23不越权许后两件24告辞传话。",
      "evidence": [
        "v04-c0264:p0013",
        "v04-c0264:p0024"
      ]
    },
    {
      "paragraph_start": 26,
      "paragraph_end": 40,
      "label": "画眉协商条件与北上投靠的分层计划",
      "direction": "陆冲还未北上叶未曹试26，27主界隔日叶见已宗师不同封神月数。陆冲容无主地建派、撮合雪山不强迫除非同邪，35门由孟自决。36再答同意余让前辈商谈、北上。毒手公开六重是伪装不降真宗师；39在顾素女识之前替核心宗师只是计划，40三人嘱小心未所有人同往。",
      "evidence": [
        "v04-c0264:p0026",
        "v04-c0264:p0040"
      ]
    },
    {
      "paragraph_start": 42,
      "paragraph_end": 48,
      "label": "初春金帐区域、两守戒备及叛徒怨念不指名",
      "direction": "古纳河浮冰入海口百丈金帐为古汗住随季移，广金帐几百里圈。两守武士祭司戒备想中原突袭48怨叛徒未姓名，不旁白指定某人。地理演氛围而非外百科补位置。",
      "evidence": [
        "v04-c0264:p0042",
        "v04-c0264:p0048"
      ]
    },
    {
      "paragraph_start": 49,
      "paragraph_end": 61,
      "label": "毒手马甲元心魅力实用、核验待宗师避罗素",
      "direction": "孟儒雅青袍斑鬓温和负手，51毒手投奔是假身份战略并非真正叛正道。两守好感55受魅力欲帮，56让青帐等待查身份未真正核完或进核心，58要找认得宗师60祭司接受避罗素59要求并转离。61孟感元心强非整个金帐都被洗脑；50/52/56共声未分人待录制。",
      "evidence": [
        "v04-c0264:p0049",
        "v04-c0264:p0061"
      ]
    }
  ],
