{
  "schema_version": 1,
  "chapter_id": "v04-c0296",
  "title": "第二百九十六章 过门而不入",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "c6b29645fe969cba16b221176e151553d5809f0eff0eb6f541ee116b61f938d4",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S38",
  "pov": "素女交涉受拒、成长反审与避亲求东海",
  "attribution_caution": "双修执刀正式条件而未接受；两月再半月不等停修。王似提前域不新宗师，孟离院院未毁。柳旧掩辞与元心无谎分，吴亡妻玄女为应当/多半。家人未见未亡、顾警告回想非新传音，匿名阻悟任务仍未识收信者。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 5,
      "label": "两月等待兼修旧法、反审霸王招带歪开天",
      "direction": "阳春至隆夏两月非闲等停修。多法尚浅嫌时少，哈斯战后发现霸王六斩带歪开天，重审旧融会为螺旋成长，非新已全悟或弃武。",
      "evidence": [
        "v04-c0296:p0001",
        "v04-c0296:p0005"
      ]
    },
    {
      "paragraph_start": 6,
      "paragraph_end": 16,
      "label": "虚幻连院、素女正式条件与退进话术",
      "direction": "王看孟虚幻连物非实际院离毁，王树枢机仿提前域不已宗师。7传正式入玄女应身双修才可悟/可执掌条件未孟答允。9–15孟嫌束缚拒风险、贬霸王结局是对方转告话术以退进非原文判绝刀废物；王16不再提断过去非忘却已证。",
      "evidence": [
        "v04-c0296:p0006",
        "v04-c0296:p0016"
      ]
    },
    {
      "paragraph_start": 17,
      "paragraph_end": 29,
      "label": "半月再拒、疑另依仗改寻柳漱玉",
      "direction": "再大半月回信孟概括不要拉倒非素女真人四字现场说；王或依仗和孟其他掌刀法疑未独证。柳受顾要挟的把柄可用是计划，先找柳父。成长重新看紫鹏普通不柳境界已掉。29王看连线断院恢复未随孟离毁。",
      "evidence": [
        "v04-c0296:p0017",
        "v04-c0296:p0029"
      ]
    },
    {
      "paragraph_start": 31,
      "paragraph_end": 45,
      "label": "神都潜居烛屏、柳惊差距仍客套",
      "direction": "柳仆视信重、采补妾候选念内，感应未察孟坐烛后也忽略直至饮茶。柳冷汗问差距内、老捕经验重整笑，三四年孟成长对二十七年未越第二梯为自述不补准境。孟不接感叹问来意。",
      "evidence": [
        "v04-c0296:p0031",
        "v04-c0296:p0045"
      ]
    },
    {
      "paragraph_start": 46,
      "paragraph_end": 58,
      "label": "试问漱玉、旧掩辞被揭与土遁失败",
      "direction": "子悦唠叨是孟来意说辞未子悦此时现场；柳游尼苦禅20年说与孟素女仙界亲见针锋。柳鹏上形土下遁实撞地钢血不死，孟身坐不动不实挥刀。柳称已被先帝总捕识脱素女、孟元心印察无谎提升可靠不全历史独验。",
      "evidence": [
        "v04-c0296:p0046",
        "v04-c0296:p0058"
      ]
    },
    {
      "paragraph_start": 59,
      "paragraph_end": 68,
      "label": "吴季真与玄女线索、皇帝采补辅助之说",
      "direction": "柳给东海三仙岛六洋狂客吴季真地9大宗师线索，亡妻应当玄女应缘显化、多半知苦守皆推测；孟无谎检非所有传闻独证。仆报皇召为叙述消息不新编对白，柳说帝欲采补助众生力炼化未独验术有效，柳赴宫孟未同进。",
      "evidence": [
        "v04-c0296:p0059",
        "v04-c0296:p0068"
      ]
    },
    {
      "paragraph_start": 69,
      "paragraph_end": 70,
      "label": "过家门而不入、避祸东海",
      "direction": "哭死后本想见赵老五子悦顾长青回家，想顾鱼不安分亲友亡警告失兴远离带祸走。未三人现身/已死、不是与家断绝关系或客观所有警告已验；叹遁东海未抵岛会吴。",
      "evidence": [
        "v04-c0296:p0069",
        "v04-c0296:p0070"
      ]
    }
  ],
