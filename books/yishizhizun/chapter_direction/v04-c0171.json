{
  "schema_version": 1,
  "chapter_id": "v04-c0171",
  "title": "第一百七十一章 天马拉车",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "25462739a1495be84c768420cad6fb60be3106aa2eefd67741da8a3f0d3213f0",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S18",
  "pov": "受伤感知、有限遥感与克制取宝后的追踪",
  "attribution_caution": "通天剑心初成有限；猪尸身份仍人物推断，潜逃只是想象；铜门打开不等车门开，天马未取得，狼嚎未知。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 18,
      "label": "眼痛与猪尸身份的认知差",
      "direction": "孟八九已炼掉眼罩门故未瞎，仍痛闭眼。江通天剑心初成模糊感猪尸，不是遍照寰宇已成。孟说应是天蓬，以别处消息解释猪妖出身；伙伴各猜仙迹或结队前，没获知穿越记忆。老猪潜逃叙述仍孟推想。",
      "evidence": [
        "v04-c0171:p0001",
        "v04-c0171:p0018"
      ]
    },
    {
      "paragraph_start": 19,
      "paragraph_end": 33,
      "label": "死因推理与遥搜无物",
      "direction": "赵惊体量，孟猜法天象地后凝固，阮提尸可探天庭谜，江明确无法近尸。突袭或不防对象、无战痕、尸未取都是孟推测，综合实力包含宝阵不等境界。江再遥感未见钉耙遗物，未取宝未验尸。",
      "evidence": [
        "v04-c0171:p0019",
        "v04-c0171:p0033"
      ]
    },
    {
      "paragraph_start": 34,
      "paragraph_end": 42,
      "label": "感官误差撞出铜门",
      "direction": "赵催追妖，孟眼痛稍缓而精神感知仍受限，返池水道撞底露铜门；不是故意机关解谜、头破血流或恢复禁飞。铜门自缓开似无封禁，众警戒。",
      "evidence": [
        "v04-c0171:p0034",
        "v04-c0171:p0042"
      ]
    },
    {
      "paragraph_start": 43,
      "paragraph_end": 55,
      "label": "凝固车马与不开车厢",
      "direction": "广场余车无马有封禁，门口一乘四天马金车题天河水师。马未达法身但特殊神通不明，破虚巡视是孟猜。马和封禁凝固，孟伸手却没摸没收。齐问内人，车隔感且无声，孟克贪转身不打开，巡逻者或逃难重要人均猜。",
      "evidence": [
        "v04-c0171:p0043",
        "v04-c0171:p0055"
      ]
    },
    {
      "paragraph_start": 56,
      "paragraph_end": 64,
      "label": "恢复视觉并转到妖后",
      "direction": "孟略变后探气确认妖已过才出水，具体变形未明。江见兵未醒齐评经验，孟眼大概恢复见物未动。五人隐匿缀妖，尚无猎杀收益；彼岸楼阁林木显形，赚回善功为期待非已获。",
      "evidence": [
        "v04-c0171:p0056",
        "v04-c0171:p0064"
      ]
    },
    {
      "paragraph_start": 65,
      "paragraph_end": 68,
      "label": "远处狼嚎而未知杀机",
      "direction": "狼嚎惨叫远来，身份死活未确证，不与狼王师父或既有人名硬合。队伍起寒意，自相残杀或怪物是疑问，凶手未明。",
      "evidence": [
        "v04-c0171:p0065",
        "v04-c0171:p0068"
      ]
    }
  ],
