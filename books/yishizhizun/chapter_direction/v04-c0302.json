{
  "schema_version": 1,
  "chapter_id": "v04-c0302",
  "title": "第三百零二章 驱“羊”探路",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "995c56b64fe80c06f753d242647d126e0de20893728e3730a1a4c7cd8b0034f5",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S39",
  "pov": "断气机护送与驱兰高探魔土门",
  "attribution_caution": "孟断联未明道一招名、二难受未伤死，三徒明确开窍本章新证。魔土情报古孙拷已做身份未名、神兵阵图/二宗师/门通九幽未全实见。兰土克水与高金水寒影响分观点条件，39双方心名非合喊。护送未送回长乐，门未开未宝获/胜负死亡。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 9,
      "label": "三宗气机互激、孟主动断联背向使二谨慎",
      "direction": "高巨虫法相令牌浮寸、兰土空间球虚光曲，孟不显相气血武意实冲。互牵谁先动遭二联只是势，孟5转断源洒无招名不替道一。6难受欲呕非真吐伤，二怕显隐藏问题不盲攻，三徒开窍明确知危却疑为何安。",
      "evidence": [
        "v04-c0302:p0001",
        "v04-c0302:p0009"
      ]
    },
    {
      "paragraph_start": 10,
      "paragraph_end": 17,
      "label": "护送三徒出危险视野、二收遁且兰土克水信",
      "direction": "孟平笑先送离缓行不视二背随，二谨慎想攻未动不是实战败死。14高内怪成长莫测，15高无相剑蛊虚藏兰土藏实。16兰知诡似蓝血自信土克水为己判断非万法必克。",
      "evidence": [
        "v04-c0302:p0010",
        "v04-c0302:p0017"
      ]
    },
    {
      "paragraph_start": 18,
      "paragraph_end": 29,
      "label": "阴土线与裂隙、古孙拷情和贪利临盟入",
      "direction": "阴冷污土波一闪兰喜找萨满旧驻、高也找东西；兰开裂黑墨雾。25抓古孙拷知幽冥邪阵残九幽缝已强力弥魔土数/十几年才复为情报与内认，未知弥者。26队藏宝秘密神兵阵图可能不射日弓已证、27兰坏评贪护恶；28估路≥2宗师己胜但难留物借高临盟未协议平分。29两实入裂非独孟先进。",
      "evidence": [
        "v04-c0302:p0018",
        "v04-c0302:p0029"
      ]
    },
    {
      "paragraph_start": 30,
      "paragraph_end": 36,
      "label": "球相移污、泥血冰坡与高金水非普通冻弱",
      "direction": "兰法相牵雾入落泥下坡冰浓，32兰利寒认为蓝血弱、33过极寒蓝血限制条件非全无例外。高34冷无情疑嘲35己金水无相剑蛊比兰想小寒影响，未真高已冻僵/方全功变金族。各鬼胎继续行。",
      "evidence": [
        "v04-c0302:p0030",
        "v04-c0302:p0036"
      ]
    },
    {
      "paragraph_start": 37,
      "paragraph_end": 44,
      "label": "感孟刀血临界尾随、彼此不肯反击驱羊压力",
      "direction": "两顿感边缘气血刀意，39脑浮狂刀名非说出；40感/想孟负后提刀傲行不掩，41距离精准压比狼驱羊非真羊变身。两想另一反攻不火栗42，未真达牢盟、43兰先不管44步心压自负探路是兰内责，不孟亲口威胁杀羊。",
      "evidence": [
        "v04-c0302:p0037",
        "v04-c0302:p0044"
      ]
    },
    {
      "paragraph_start": 45,
      "paragraph_end": 49,
      "label": "路尽黑冰石门、魔土范围与九幽问皆未答",
      "direction": "前方无路黑石门冰晶实，46魔土止？47武士？48进门？49九幽魔门？兰疑非确门后九幽/人藏、未开门进入/藏宝得、两宗师未死。",
      "evidence": [
        "v04-c0302:p0045",
        "v04-c0302:p0049"
      ]
    }
  ],
