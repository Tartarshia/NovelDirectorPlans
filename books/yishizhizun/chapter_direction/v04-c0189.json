{
  "schema_version": 1,
  "chapter_id": "v04-c0189",
  "title": "第一百八十九章 天罚门",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "3515e14f608d52b40909f17bf14c8e0722bad14bbd957c7845fc8348d2eb44f5",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S19",
  "pov": "血桃暂失、纪元释义与天罚压制，三路追进",
  "attribution_caution": "顾古史纪元和桃成因以其说法保留，血桃未取未吞。动物死亡明述、塔为羲功法影未知名。朝廷真入与神话上行发生，孟主材没实用、后敌未追上。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 22,
      "label": "血桃藏避与纪元更正",
      "direction": "桃探缩使孟失锁，树桃互应是孟猜未告顾。顾承见桃，说园负象吸寿星精华、未知后手成因，寿元变为同一未终事件，古纪元不等后人时代太古多纪元。桃似吓走未证离永远，孟留大道树秘密。",
      "evidence": [
        "v04-c0189:p0001",
        "v04-c0189:p0022"
      ]
    },
    {
      "paragraph_start": 23,
      "paragraph_end": 28,
      "label": "天罚门诸刑台名与阴风",
      "direction": "顾名五刑处、说强者执念未消九重天碎应纪元终却拖，皆口述。孟感耳畔惨骂影响元神、前世猴受罚联想非本界史证。尚没见具体敌复生。",
      "evidence": [
        "v04-c0189:p0023",
        "v04-c0189:p0028"
      ]
    },
    {
      "paragraph_start": 30,
      "paragraph_end": 44,
      "label": "北斗羲实入、动物试死与守禁",
      "direction": "二人入园，羲赤火鸟北斗雪貂放前回头瞬生机无，尸命运实明不等每法理机制独立测全。羲似忆规则刻字提醒韩高，黄金三十三塔影紫气护己前行北斗跟。非使用赵已经毁秘宝塔。",
      "evidence": [
        "v04-c0189:p0030",
        "v04-c0189:p0044"
      ]
    },
    {
      "paragraph_start": 46,
      "paragraph_end": 58,
      "label": "朝廷队实入遇阵韩高取舍上行",
      "direction": "崔司马神捕朝臣率队已入见根基禁阵，韩操雷水阻高估久耗可重伤大晋。韩全激阵留拖自己及高上行，未摧毁杀光来队，选探索因忧未知外援是其理智非外援已来。",
      "evidence": [
        "v04-c0189:p0046",
        "v04-c0189:p0058"
      ]
    },
    {
      "paragraph_start": 60,
      "paragraph_end": 66,
      "label": "孟顾到门龙念压元神",
      "direction": "古门后血刑台虚幻龙念，孟金莲元始勉稳感勾天地难，主材恐十不足一是未实用评估。顾解释刑场压强者、眼白莲开，孟勉走未过完整刑区。",
      "evidence": [
        "v04-c0189:p0060",
        "v04-c0189:p0066"
      ]
    },
    {
      "paragraph_start": 68,
      "paragraph_end": 71,
      "label": "跟进者已出园但追及未成",
      "direction": "北斗氤路松气说寿星死、羲疑提前觉，前者赞孟顾开路顺利预计快追。羲点前天罚门两人不能速过是其判断，尚未碰面交战。",
      "evidence": [
        "v04-c0189:p0068",
        "v04-c0189:p0071"
      ]
    }
  ],
