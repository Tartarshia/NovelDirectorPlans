  "title": "第二百二十四章 枭雄",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "7e54e6ca5d2d0d40ddb12fe17d23ff6e0c0cb159cf798ed0c27fc5e0ebc71866",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S22",
  "pov": "真召执念非苗聪、杜复起与试苗枭雄应变",
  "attribution_caution": "死者非苗聪为执念称主公后的齐推断，苗承假死确但绑子胁迫仍口述。真执念非完整魂证；杜能走持剑实际，病榻杜是孟变化；苗暂表归心未绝对忠，救儿未做，神魔怒火未解。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 18,
      "label": "真召执念、主公疑与尸身份推断",
      "direction": "齐真法印阴风出人执念叫主公，执念非魂念只死前盘念。孟江封声音，赵察苗独子何称主公齐判死者非苗聪，江阮推新来不认尸和梁伪失手毁特征；三友疑齐一年变化欲孟询，尚没深谈。",
      "evidence": [
        "v04-c0224:p0001",
        "v04-c0224:p0018"
      ]
    },
    {
      "paragraph_start": 19,
      "paragraph_end": 34,
      "label": "孟分身再留、杜能走与试苗策略",
      "direction": "队伍推苗替身栽赃为当前判断，孟真留分身入中营转述，杜已能走金眼。顽石反省丧子可信差误扶；杜想再试挽一臂孟认可不行则果断处置。提影王死半时敌奸未闻应假昏暗邀苗，该时点不强对齐京都谱插叙。",
      "evidence": [
        "v04-c0224:p0019",
        "v04-c0224:p0034"
      ]
    },
    {
      "paragraph_start": 36,
      "paragraph_end": 44,
      "label": "侯真引苗、昏床表象与顽石诈扶",
      "direction": "侯泄口风重伤无首请秘谈实引苗，苗自恃暗赴床见假杜。顽石借朱冯刘缺点夸苗仁名实力劝担首鼎助是试探话，不其客观评价全翻或真已拥苗。苗忧喜顾心沉。",
      "evidence": [
        "v04-c0224:p0036",
        "v04-c0224:p0044"
      ]
    },
    {
      "paragraph_start": 45,
      "paragraph_end": 51,
      "label": "苗坦承假死、绑儿胁迫口述与枭雄感",
      "direction": "苗承聪死作假，自说儿绑经梁威胁引内讧，听夸后称舍子顾天下，未独证绑处绑人及其觉悟。旁听杜孟顽石枭雄感、机会难再子可再生是众感慨，不内心证每字实际苗真实意图。",
      "evidence": [
        "v04-c0224:p0045",
        "v04-c0224:p0051"
      ]
    },
    {
      "paragraph_start": 52,
      "paragraph_end": 62,
      "label": "杜持剑真现、床上孟变形与苗暂归救子请求",
      "direction": "杜金承天剑真从帐后出，床人实变回白衣孟，说明装昏者是孟非实际杜还伤血。杜称上师治复试奸，苗看剑三人调整恭喜。孟首次口述当地单称始、昨留化身实杀影王给信心，苗惊暂愿马首是瞻求救儿；未真救子或消灭内奸全数。",
      "evidence": [
        "v04-c0224:p0052",
        "v04-c0224:p0062"
      ]
    }
  ],
