  "chapter_id": "v04-c0214",
  "title": "第二百一十四章 又",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "fe7a02d4cc0a37e7dabd7aab0752a7957ada47ff8b075f44e72bc4a6eafe2446",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S20",
  "pov": "镜残精实吸古符末次实耗、罗刹本体追至净土避难后告别",
  "attribution_caution": "古符最后一次瞬燃已耗至零，即使被干扰也不恢复；树实吸的是昊镜残存精气不完整神器，未新数叶或全镜功能。罗刹本体追来并寻空，与未详化身终态分开；净土避脱后未见冲和未实践小如居处。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 14,
      "label": "树破不可触并吸残镜、末次古符实际催发",
      "direction": "孟出行带树缘由为回述，树触本体让镜化混沌气涌入，失支撑虚空裂血海破冻。小如惊，孟不欲主材苦战化身等援遂催古符最后一次、瞬燃拉她选北遁。化身仍阴郁未描击杀，完整太古镜非所得。",
      "evidence": [
        "v04-c0214:p0001",
        "v04-c0214:p0014"
      ]
    },
    {
      "paragraph_start": 15,
      "paragraph_end": 27,
      "label": "本体追干扰古符，南荒未知地危险迫近",
      "direction": "破空中元神晕颤，本体意念锁定追来阴声给老夫停，符被干扰中止出南荒林山未离区。孟后悔听秘晚动，小如恐绝望、误猜孟闭眼放弃，未证孟放弃或小如死亡。",
      "evidence": [
        "v04-c0214:p0015",
        "v04-c0214:p0027"
      ]
    },
    {
      "paragraph_start": 28,
      "paragraph_end": 36,
      "label": "罗刹本体追空，新仇升级不死不休",
      "direction": "本体虚空赤流欲夺更非凡小树，出锁定点二人消失推天机无用，宣仇五雷轰顶为誓非遭雷。鸟只皮兽狂是怒波真后果；镜计划自证法身始毁使恼转不死不休，但未获得树。",
      "evidence": [
        "v04-c0214:p0028",
        "v04-c0214:p0036"
      ]
    },
    {
      "paragraph_start": 38,
      "paragraph_end": 41,
      "label": "孟小如现净土，菩萨又来一句",
      "direction": "青山寺路二人实现兰柯净土，孟合十惫懒菩萨又来，小如呆又内问；未给菩萨现场答话、名字或具体入净土术材，非孟正面战败法身。",
      "evidence": [
        "v04-c0214:p0038",
        "v04-c0214:p0041"
      ]
    },
    {
      "paragraph_start": 43,
      "paragraph_end": 53,
      "label": "北周纯阳附近告别，转世无助依谷的后续",
      "direction": "离净土实到北周纯阳附近，孟拟告冲和法、再告韩高合作求遮掩尚未见道人。建议小如住三正道法身附近避三城是建议非已落户，八九遮不瞒法身为孟警惕。她谢别、叹谷特异将消再无转世族为判断，鱼区别仍不知；孟推无转世或破限尚未突破，飞别孟往纯阳。",
      "evidence": [
        "v04-c0214:p0043",
        "v04-c0214:p0053"
      ]
    }
  ],
