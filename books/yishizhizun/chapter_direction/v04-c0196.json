{
  "schema_version": 1,
  "chapter_id": "v04-c0196",
  "title": "第一百九十六章 想太多",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "5784fbc256080ed10fb1909aed920bec3163d723e5a5d3c5db1e950fb289e76c",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S19",
  "pov": "误判高转冷却已破空滑逃、顾独离停步与来世残迹多像",
  "attribution_caution": "破空古符实用1次按原2可用尚1，175给江后回孟未描。天心主材只备用未用、没治背伤。高本章触名不变不保证永远不再变；多像未确认命运人物真实身份，顾停步未跟入。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 18,
      "label": "逃险预判与古符真正催",
      "direction": "孟把触名会高转冷当急险，顾有后手为己推。自述袁只请灵宝不换保命、之前不敢符有九天空间风险。握符全力涌选择台阶方向，出后天心主材抗乱击仅备案未用。",
      "evidence": [
        "v04-c0196:p0001",
        "v04-c0196:p0018"
      ]
    },
    {
      "paragraph_start": 19,
      "paragraph_end": 35,
      "label": "高未变而符已遁，孟滑下苦笑",
      "direction": "高笑剑微醒不惧陆冲依旧豪迈，孟呆古符已亮裂空。受九天似压仅到门，按旧计划选自身左殿右跃变鹰滑；高喊三弟未抓回，孟懊想过多仍担顾救恩回报。不是成功离九天或此章高曾冷。",
      "evidence": [
        "v04-c0196:p0019",
        "v04-c0196:p0035"
      ]
    },
    {
      "paragraph_start": 36,
      "paragraph_end": 48,
      "label": "各方反应与顾离殿犹疑",
      "direction": "高慢抓被云隔韩欲乱击见高疯撤。顾解要事高茫然许，韩由反应悟旧触点失效仍试，顾取果已足求离高许法王放心留挑未得，韩目送。顾殿外左行数步顿思，未追上孟。",
      "evidence": [
        "v04-c0196:p0036",
        "v04-c0196:p0048"
      ]
    },
    {
      "paragraph_start": 50,
      "paragraph_end": 64,
      "label": "当前层落地多陌生身影",
      "direction": "孟改气血身体适滑感知不足十丈、明确仍这层并非落下层，人形实云地找路。钟声僧念、悲吼、黑服喝刀来紫刀气还有诸形，未知幻象机制、不直接为真实霸王法身。",
      "evidence": [
        "v04-c0196:p0050",
        "v04-c0196:p0064"
      ]
    },
    {
      "paragraph_start": 65,
      "paragraph_end": 72,
      "label": "众像皆孟脸与未来解释待证",
      "direction": "僧及强刀悲剑道脸逐现全孟样，孟内问我、醒自己在来世殿毁处，猜来世或未来可能、毁后只得将来且有限清晰，是推理未知真假无新功法获得。",
      "evidence": [
        "v04-c0196:p0065",
        "v04-c0196:p0072"
      ]
    }
  ],
