{
  "schema_version": 1,
  "chapter_id": "v04-c0233",
  "title": "第二百三十三章 兔起鹘落",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "c9281a4fa3d1e3ef49611442b4baa5eb63faace636436a4b46bca125742d573a",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S23",
  "pov": "齐分离法相抢刀锁、双兵自战与孟赶表未成",
  "attribution_caution": "葬星河身前危害被昆仑实催挡，法天两头四臂18停止；齐法相消回肉身重伤非死。太子重伤弱未死帝刀真实催后自主护台，承天主动非杜第二手动催。孟56吃东极自用1剩1暂封，最后沾因果未用。千字血光是视觉非63朗读，罗刹67远声未肉身降；通路光贯未终结任务。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 19,
      "label": "枪三重暗劲、身前葬星河自波及与昆仑实催",
      "direction": "斩玉侧枪被暗旋加速穿流火网，孟玄龟天伤起势即交葬星河范围压第三劲，自己受热冲昆仑实际催借力跃避。枪落台白痕，孟没重伤但大耗法天两头四臂终止。不是昆仑直接被枪穿。",
      "evidence": [
        "v04-c0233:p0001",
        "v04-c0233:p0019"
      ]
    },
    {
      "paragraph_start": 20,
      "paragraph_end": 30,
      "label": "黄表燃与沈实际催帝刀锁孟、心诀只是拟",
      "direction": "宝尸献完黄表逐燃全燃通天路才立，沈趁孟定身真实帝皇刀全力催锁，孟僵佛争清明转元始相拟天心我意闯生，树对兵无兴趣。没沾因果实际施。",
      "evidence": [
        "v04-c0233:p0020",
        "v04-c0233:p0030"
      ]
    },
    {
      "paragraph_start": 31,
      "paragraph_end": 39,
      "label": "齐分离法相六臂潜击解刀锁、九张已燃",
      "direction": "齐本尊顾牵独孤法相人首龙身血红六臂潜顶，刀催瞬血珠拍沈背融弱飞失锁斩天，孟赞魔主。十六表烧九留七，不太子明确死或帝刀被毁。",
      "evidence": [
        "v04-c0233:p0031",
        "v04-c0233:p0039"
      ]
    },
    {
      "paragraph_start": 40,
      "paragraph_end": 55,
      "label": "帝刀自主护台、齐破禁受重伤与承天自主",
      "direction": "帝刀龙吟飞起护台齐六臂破九层禁剩六表，横刀法相消回本尊吐污血真重伤不齐死亡。齐回望杜，承天得敌气、杜沟与齐秘惊主动发力，双兵战余波死众杜已回船剑护阮赵，不第二杜手动耗。",
      "evidence": [
        "v04-c0233:p0040",
        "v04-c0233:p0055"
      ]
    },
    {
      "paragraph_start": 56,
      "paragraph_end": 69,
      "label": "孟实际服东极复峰、斩玉赶表却罗刹字挡通天",
      "direction": "孟东极真实服复全峰不再法天，步罡危感闪双兵赴九层承天拦敌刀，余最后表斩玉开天与左剑追。血光天地玄黄字实际挡两击最后纸烧融，远血海罗刹熟声死定讥，光上云下地孟冷。没毁台成功、没罗刹实体已降、没有己阵全任务已失败提示。",
      "evidence": [
        "v04-c0233:p0056",
        "v04-c0233:p0069"
      ]
    }
  ],
