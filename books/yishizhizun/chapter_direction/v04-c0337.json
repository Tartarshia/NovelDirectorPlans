  "stage_id": "V04-S42",
  "pov": "搜索范围到定位、分头协作与鬼字待救",
  "attribution_caution": "范围信息已得不等政府搜查机密结果全拿；三候选后安南因果匹配及片在此明确，未原物得。董危险解读不孟确滥杀，监冲升级实禁陌电未全成，冲主动经文平情不同持续被孟控。孟多宿主换附实际、最后融电话电流未法身。鬼字规则群推请愚命令未治疗完成。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 7,
      "label": "新人绝望与天师请愚未治疗",
      "direction": "宗师也不幸、天师未止使四人险晕，3入缝速死/随强弱字渐深为群问推不已规则证。5天师细问6命道童请愚，7地藏手书克鬼理由，未愚实到诵经/字解除/碑施害确定。",
      "evidence": [
        "v04-c0337:p0001",
        "v04-c0337:p0007"
      ]
    },
    {
      "paragraph_start": 9,
      "paragraph_end": 19,
      "label": "搜索范围实得、三候选与董反制",
      "direction": "董惧倒沙9口问10孟求搜索哪些区，11大搜不能藏范围但结果未知分明。12董认为冷杀强者屈服无条件说所知非孟客观滥杀，13魂不灭元始相结合三地方14最疑安南。16右搭电话散走17董回拨18提醒监冲19禁陌电指令，38监视升级已成而隐秘禁电未逐地成。",
      "evidence": [
        "v04-c0337:p0009",
        "v04-c0337:p0019"
      ]
    },
    {
      "paragraph_start": 21,
      "paragraph_end": 37,
      "label": "吃够误解、主动分工与旧法实用",
      "direction": "冲暴吃未来有害标食怕训练规定25孟否是以后少吃先够自己回味不是武功必秘食。28/31正常生活吸监目而自己分头34不能再控冲目的解释校园激励。冲35不满中热36自我安慰不必以后真摆脱，37实际默念旧功经平情正常一日，未九窍成/杜来/徒伤。",
      "evidence": [
        "v04-c0337:p0021",
        "v04-c0337:p0037"
      ]
    },
    {
      "paragraph_start": 38,
      "paragraph_end": 45,
      "label": "实际监冲与多次换附、监外缘线吻合",
      "direction": "38特工受提醒警戒最高聚焦，39孟附别人换人按图路线到安南重型周边，宿主未名无新被杀声明。40空旷士兵射陌戒描述未孟被枪实击。41因果密难分但只看外界缘43特征吻合44有缘口评45旁白明确躲此片在此，未已接触原物或三候选都核。",
      "evidence": [
        "v04-c0337:p0038",
        "v04-c0337:p0045"
      ]
    },
    {
      "paragraph_start": 46,
      "paragraph_end": 49,
      "label": "公话问手续、实际电流潜入",
      "direction": "孟退找公话46拨安南，47匿名严肃接线，48问探访手续同时身虚入话筒融电，实际开始沿通信进入非出于正规批准探访；章内未掩体内具体位置/夺片/重组停。49无肉方便与法身三特征是境界知识非孟现在已法身。",
      "evidence": [
        "v04-c0337:p0046",
        "v04-c0337:p0049"
      ]
    }
  ],
