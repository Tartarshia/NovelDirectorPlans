{
  "schema_version": 1,
  "chapter_id": "v04-c0143",
  "title": "第一百四十三章 两大邪魔",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "928fd71caa498317f1c5eebdee1e5099262bf5147e52d7113a37ccad3d018484",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S15",
  "pov": "众外景震惊转末蓝血自毁视角，再孟奇护琴与两邪魔争路",
  "attribution_caution": "142五敌伤亡由本章补明，不倒改142当时悬念；末敌临终念非喊话。玄水旗只是想用，黄泉骨已拿出但未发动，分身未执行。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 8,
      "label": "众人推测克制原因",
      "direction": "旁观者先惊孟如宗师，后猜秘法宝物，非孟已宗师或确定借宝才赢。评价碾压二绝顶三一流是战果补证，控水以外剑蛊仍有同境实力。",
      "evidence": [
        "v04-c0143:p0001",
        "v04-c0143:p0008"
      ]
    },
    {
      "paragraph_start": 9,
      "paragraph_end": 25,
      "label": "同归剑蛊与大日变",
      "direction": "残余绝顶禁法以命化入元气，孟不闭窍让入却内景大日焚蛊，其念消失死亡。22明确大日变首梯后练成，当前仅内景，不是真身太阳或永久身体天体。",
      "evidence": [
        "v04-c0143:p0009",
        "v04-c0143:p0025"
      ]
    },
    {
      "paragraph_start": 26,
      "paragraph_end": 30,
      "label": "五敌清除与第一蛊战利",
      "direction": "27明确第一个已杀，后面范围妖魔授首连蛊泯灭，末者大日蒸发，回补142不明伤亡。孟收一暗蓝蛊非水蓝石；第一刀开天辟地包仙神辟易小技巧再转柔杀，非完整第一斩。",
      "evidence": [
        "v04-c0143:p0026",
        "v04-c0143:p0030"
      ]
    },
    {
      "paragraph_start": 31,
      "paragraph_end": 46,
      "label": "柔刀送琴被截与阮援",
      "direction": "孟不抓只柔气推琴免误会，被旁门剑挡；几十外景非皆当地世家，亦有帮阮者。孟想用玄水旗因四重能用旗骨，但阮众拦敌故未实用旗；法身不会觊觎是孟估计。",
      "evidence": [
        "v04-c0143:p0031",
        "v04-c0143:p0046"
      ]
    },
    {
      "paragraph_start": 47,
      "paragraph_end": 57,
      "label": "两邪魔与王无声现身",
      "direction": "令狐涛六极真魔黑榜93元磁似掌令刀不稳，孟避。顽石准黑榜灰肤瘦高也到；孟拟分身取琴尚未实行。王突然到孟身旁没察，遁一屏蔽危感仅孟猜。",
      "evidence": [
        "v04-c0143:p0047",
        "v04-c0143:p0057"
      ]
    },
    {
      "paragraph_start": 58,
      "paragraph_end": 63,
      "label": "竞速约与手骨亮出",
      "direction": "王提一人一敌比先解决，邪魔怒被轻视，孟答应取出黄泉手骨。只亮物未出手，胜负与琴归属仍未定。",
      "evidence": [
        "v04-c0143:p0058",
        "v04-c0143:p0063"
      ]
    }
  ],
