{
  "schema_version": 1,
  "chapter_id": "v04-c0282",
  "title": "第二百八十二章 正道的布置",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "93160eccec6707425366f6a5b1bf57e1cc134bdf1b10d48567fc9636cc7be0b5",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S35",
  "pov": "孟反抗与寄莲转查内应，正道集中力量部署后陆冲赴战",
  "attribution_caution": "莲实种荷池布禁法，孟随身莲0但种子未毁。孟情报叶已收到含伪装多半识破，战略是据风险推部署未实际截杀；无面藏剑楼仍嫌疑。叶未完表意、陆一心旧妻不新增接受恋情，旧孟话由陆当场引用不另过去声。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 11,
      "label": "离草原重拾反抗心，种莲布禁法后奔藏剑楼",
      "direction": "孟已出草原才缓压，乐观执拗不服命但决更慎借玉虚碧游免亲友灾，为未来方针非已经永久屏大能。9实际种顾莲废寺荷池、11禁法后遁向藏剑楼，未到楼/开花；防定位是孟疑顾布置非真检测。",
      "evidence": [
        "v04-c0282:p0001",
        "v04-c0282:p0011"
      ]
    },
    {
      "paragraph_start": 13,
      "paragraph_end": 24,
      "label": "情报到画眉，三人分析投效世家与大势",
      "direction": "叶大半日已收孟信，四家暗投高氏除外。冲和评胜后清洗是未来风险，陆区分曹和少数更深、其余下注风向而关键不能露颓；不已清洗北周/所有世家当场改向。陆笔直如学童按膝旁剑，稳声指核心。",
      "evidence": [
        "v04-c0282:p0013",
        "v04-c0282:p0024"
      ]
    },
    {
      "paragraph_start": 25,
      "paragraph_end": 35,
      "label": "计划放空蒙南法身防御，凭情报与性格复核",
      "direction": "孟新信承多半假身识破旧报可能假，陆冲独立比修罗寺关系性格一致认犹豫可信；集中局部优势不蒙南真已放弃出手。叶陈地理与收缩弱宗、兰柯菩萨会管是判断，不菩萨已到。陆估苏无名司马因持兵可拖、苏特殊无处不在是冲和远感，不已晋法身。",
      "evidence": [
        "v04-c0282:p0025",
        "v04-c0282:p0035"
      ]
    },
    {
      "paragraph_start": 36,
      "paragraph_end": 42,
      "label": "拦大满与伏血海，预备妖族变局",
      "direction": "陆提何庄主拦大满；冲和血衣借蛊神或韩古暗示、妖可由此入是推。拟云鹤暗阵空闻崔清河出面三人短杀罗刹，若妖入也挡，为条件部署不已成阵/罗刹死/妖到。",
      "evidence": [
        "v04-c0282:p0036",
        "v04-c0282:p0042"
      ]
    },
    {
      "paragraph_start": 43,
      "paragraph_end": 50,
      "label": "高览牵法王与韩觊刀推测，无面需查叶拟留守",
      "direction": "叶以孟报推韩法王不冒命护古；冲和推高人皇剑利益牵法王、韩或趁乱光阴刀，陆知其神话天帝支持，不已夺刀。拟告守静防内应互监尚未信达。叶说藏剑楼无面尽快抓、请持神兵去，冲和怕孟已赴且她须守庄；真身份仍嫌疑未确定。",
      "evidence": [
        "v04-c0282:p0043",
        "v04-c0282:p0050"
      ]
    },
    {
      "paragraph_start": 51,
      "paragraph_end": 62,
      "label": "守夜到天明，二人赴战与叶未完表意",
      "direction": "陆感古气机将战抚剑闭目、冲和养神，朝霞后54冲升空55陆提剑。叶情态开口心意未完、陆问旧绰号援孟旧说表眷恋、60实际剑光升；62叶似自语一心人叹，非新婚恋互许/妻复活/大战已经分胜负。",
      "evidence": [
        "v04-c0282:p0051",
        "v04-c0282:p0062"
      ]
    }
  ],
