{
  "schema_version": 1,
  "chapter_id": "v04-c0267",
  "title": "第二百六十七章 以元心通他心",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "6e83bf29a68168a828d1e745ce30174a5a26e3f1400b51b90f83733e832cadd1",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S32",
  "pov": "假极恶遭法身偶遇、有限他心通收集部署与策反试探起步",
  "attribution_caution": "真魂被扰片忆避核心，肉身血收化准备面对韩未用上；韩未当场揭破不全知没识；宗师以上感不到群念匿名非口语，各派部署未亲见/女性名单未知，黄帐出发非策反已成。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 9,
      "label": "部分记忆读取已成、极恶住帐遇韩与七重伪装界限",
      "direction": "1在地仙自然感应前扰真魂得碎忆避核心反弹找住帐；不是全搜魂。韩3/5确出现，孟6八九七重可瞒无克制外景半法但法身仔查不行，7冲赠颠倒大衍符仅略遮卜算非面对法身保险。",
      "evidence": [
        "v04-c0267:p0001",
        "v04-c0267:p0009"
      ]
    },
    {
      "paragraph_start": 10,
      "paragraph_end": 23,
      "label": "惊惧锁灵台、极恶假说逃与韩重要事未详",
      "direction": "肉魂入微约束念不改心血，咚不拍心跳骤快。韩11自说曾方丈兴趣佛魔12禅卖相非皈佛证。13天帝糅不足孟猜；15说毒手重伤逃为新造谎非真经过。韩21几日重要事未内容，孟装恭心腹赌韩不疑，韩未当场揭穿不独证真没识。",
      "evidence": [
        "v04-c0267:p0010",
        "v04-c0267:p0023"
      ]
    },
    {
      "paragraph_start": 24,
      "paragraph_end": 29,
      "label": "血肉气息准备未能用与内应资料不足",
      "direction": "25实际之前收极恶血肉化有灵鲜血、封真魂气息拟短时遮未细疑法身，26韩突然来没用上。碎忆28内应似韩无面负责、只知部分已撤或暴露身份不全表；29拟重要事突破。",
      "evidence": [
        "v04-c0267:p0024",
        "v04-c0267:p0029"
      ]
    },
    {
      "paragraph_start": 30,
      "paragraph_end": 41,
      "label": "元心连接低层众心、无词心跳与匿名内声",
      "direction": "宗师以上32感不到，34–39是别人念化声音非实际讲话/孟念，身份未知不按内容猜人。40巨佛与不灭镇防心念冲散风险，当前非全范围无代价读心。",
      "evidence": [
        "v04-c0267:p0030",
        "v04-c0267:p0041"
      ]
    },
    {
      "paragraph_start": 42,
      "paragraph_end": 50,
      "label": "九道部署分派情报、来源念与记忆而非各宗师脑",
      "direction": "修罗黄帐罗睺、血衣万虫近青、素女玄女只承诺中立欢喜派进金、欢喜庙六欲代商女性名不详、长生黑帐生死入其中、不仁楼未掺但接委托、罗教众人和灭门四天魔三宗师；42–49由他念梳理，50极恶忆，不实见所有首领或感宗师心。",
      "evidence": [
        "v04-c0267:p0042",
        "v04-c0267:p0050"
      ]
    },
    {
      "paragraph_start": 51,
      "paragraph_end": 57,
      "label": "愤怒回稳、均势策反理由与实出发黄帐",
      "direction": "女性名单未详孟猜会有哪些生怒非名单已获取。53–55古地仙斧天仙是角色此时认知，均势会否改主意为孟策略假设未成功策反；56起身前往黄帐借担心反悔试口风57代表魔师是伪极恶借势非韩明确派此任务。",
      "evidence": [
        "v04-c0267:p0051",
        "v04-c0267:p0057"
      ]
    }
  ],
