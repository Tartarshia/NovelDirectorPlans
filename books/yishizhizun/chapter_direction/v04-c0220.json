  "title": "第二百二十章 闻景",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "0ba3e42b763efba0d38b1e1d629cbb4c3afef17732b63a6c83f5c3b520b3ae59",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S22",
  "pov": "毒水封锁、闻景谋划与十息制服潜伏、留营迁帐",
  "attribution_caution": "银鱼近敌岸、蓝血涉毒、抓踝封森罗、昆仑袍变靴并假扮待换防均已作；丹未耗本尊未登岸蛊主未见。敌帐闻景真实名明但主世界身份未揭、老师老者未直接名，五日瓦解是敌承诺；营侧孟是分身，森罗真身结局未写。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 17,
      "label": "上游鱼渡与敌岸毒水巡船封锁",
      "direction": "孟依顽石胡消息绕上游避正面三处关口，实际变银鱼游近敌岸。慧眼見黑水使水族腐化、巡船八九品统兵中央黑甲将；下属认为森罗继武皇，叙28岁六品异魔血脉。孟想换渡口最近飞半月不及，尚未登岸。",
      "evidence": [
        "v04-c0220:p0001",
        "v04-c0220:p0017"
      ]
    },
    {
      "paragraph_start": 19,
      "paragraph_end": 31,
      "label": "敌帐闻景谈清源变化旧亏、五日内瓦解计划",
      "direction": "明黄宽袍帝气金龙男子与内敛高大老者、玄袍银丝慵懒闻景真实对话。闻景说曾吃清源变化险丧命而防疏漏，老者赞同、太子口称老师未弟子礼；太子问细作，闻景建议两日攻、五日见叛军崩溃为承诺未结果。老者虽似武皇未直接点名，不擅合身份。",
      "evidence": [
        "v04-c0220:p0019",
        "v04-c0220:p0031"
      ]
    },
    {
      "paragraph_start": 33,
      "paragraph_end": 45,
      "label": "权衡一击拿强、蓝血化水涉毒十息限",
      "direction": "孟怕动静宗师来与杜只撑几日导致任务失败，决只一机制服最强巡将。观不灭相定心、变蓝血模拟十八变化稍化水非全融合。黑气使眩晕观佛稍清醒、身体腐化元神消融感，定十息限以免需丹与气息泄露，非已服丹。",
      "evidence": [
        "v04-c0220:p0033",
        "v04-c0220:p0045"
      ]
    },
    {
      "paragraph_start": 46,
      "paragraph_end": 58,
      "label": "十息等待、禅手抓踝穿甲封禁森罗",
      "direction": "三五七八九十息等待到对侧，森罗血统预感脚印幻步未躲，孟禅意手抓踝、玄黄黑白紫气手指破腿甲封气精神。森罗实无声被制服，仍未写死或击杀奖励；禅意不自赋不明新招或武皇境界。",
      "evidence": [
        "v04-c0220:p0046",
        "v04-c0220:p0058"
      ]
    },
    {
      "paragraph_start": 59,
      "paragraph_end": 63,
      "label": "船舱换形、昆仑靴遮迹与本尊毒化解",
      "direction": "孟跳蚤落森罗眼，森罗入舱后出来表象其人、加双靴由昆仑道袍变化，63实际孟巡视待天明换防。真人森罗舱内具体处置未写不能认已杀；孟肉身强横化毒未需丹，43暂神晕与62深侵未及区分，未登岸或找蛊主。",
      "evidence": [
        "v04-c0220:p0059",
        "v04-c0220:p0063"
      ]
    },
    {
      "paragraph_start": 65,
      "paragraph_end": 68,
      "label": "徐巍请转镇海营、齐接话踏帐",
      "direction": "义军侧深夜徐转达平海令几人去镇海军，面对孟分身江等非本尊回归。齐答好众踏帐，仅迁营开始非已到目标营、调查找到内奸。两线间18/32/64分隔保留。",
      "evidence": [
        "v04-c0220:p0065",
        "v04-c0220:p0068"
      ]
    }
  ],
