{
  "schema_version": 1,
  "chapter_id": "v04-c0203",
  "title": "第二百零三章 南荒事",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "ba0d29baaa9d7e1b02619d2b32b2b22d358fe6c5c0576ddd54fc074f6cca4ef7",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S20",
  "pov": "南荒实际问元央、血衣威慑与永生族灭转世线索",
  "attribution_caution": "V04-S20从此章南荒实地探查开始，五重延续无本章升级。元央七窍、兄不知道轮回；永生和血衣数目均转述不可升全知历史。杜怀伤关系仅孟疑，挑分坛和断渗透皆未完成，善功装备寄树仍未描落实。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 12,
      "label": "南荒雨季兄妹与元央七窍成长",
      "direction": "元文二十余嫌湿热少练羡妹妹又烦被比，异草与北游是其所知非全轮回实史。元央北游开眼仍七窍内天地成、轮回危险不松懈，避兄争小事。",
      "evidence": [
        "v04-c0203:p0001",
        "v04-c0203:p0012"
      ]
    },
    {
      "paragraph_start": 13,
      "paragraph_end": 22,
      "label": "屋内孟已在，元央整理后供地域情报",
      "direction": "元央见白公子烤薯激动压声族人似不见闻，不给阵法名或全体被控。孟等她整好礼坐问南荒，她尽晋文雅词讲百万山瘴雾邪道保护压迫格局，区分情报来源。",
      "evidence": [
        "v04-c0203:p0013",
        "v04-c0203:p0022"
      ]
    },
    {
      "paragraph_start": 23,
      "paragraph_end": 28,
      "label": "血衣教恐惧与组织报复说法",
      "direction": "元央怕血衣、称残酷灭族八成及群报复、消息难也限制嚣张，总坛深及长老外分山是她讲。未实测八成统计未直接与长老打架。",
      "evidence": [
        "v04-c0203:p0023",
        "v04-c0203:p0028"
      ]
    },
    {
      "paragraph_start": 29,
      "paragraph_end": 42,
      "label": "转世调查目的与永生族传闻灭族",
      "direction": "孟两个目标血衣功法虚实备死亡、灵童线能断血海渗透最好。元央忆长老说永生每死找孩子全记人格相同、生孩子需死及十几年前教主灭族、后来搜捕无下文。孟联杜怀伤疑关联非查实、没明确遗孤幸存名字。",
      "evidence": [
        "v04-c0203:p0029",
        "v04-c0203:p0042"
      ]
    },
    {
      "paragraph_start": 43,
      "paragraph_end": 48,
      "label": "问长蛇位置，拒带路将先挑分坛",
      "direction": "孟问清长蛇起、元央愿导，孟说先血衣找麻烦笑拒。控制不招顶层是自身策略不等南荒无敌，元央忧族报复不能一走。孟迈步消失只离屋未打到分坛。",
      "evidence": [
        "v04-c0203:p0043",
        "v04-c0203:p0048"
      ]
    }
  ],
