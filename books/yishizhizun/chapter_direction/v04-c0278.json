{
  "schema_version": 1,
  "chapter_id": "v04-c0278",
  "title": "第二百七十八章 现世报，来得快",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "fb5d7c09a3fd860c260b02196f8a9d9508dc116752390bf7290949bb9558daf3",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S33",
  "pov": "斩哭沾因果即时天罚与阴阳元磁抵，戒杀失效断臂服团队丹、顾幕后说",
  "attribution_caution": "沾因果斩哭今证未直接总余次数，最大宏因果未接、合杀债风源未揭。元始领域完整呈仍雏时空微乱不是全熟；左臂自断未明确再生，东极团队一粒实吞别回填个人旧疑。戒杀重创逃匿名追未擒，顾警告大能为分析。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 5,
      "label": "匿名后手毒手段被怪剑破、戒杀见哭实亡",
      "direction": "毒沼秽龙化灵毒均剑斩、老者残缺黑雾疯偏掌点穴迫难而游斗避命。仍未真姓名。戒杀可再数息逃或换命是假若未来，4见哭载倒无气5想无解刀；哭死亡加明不魂群解放。",
      "evidence": [
        "v04-c0278:p0001",
        "v04-c0278:p0005"
      ]
    },
    {
      "paragraph_start": 6,
      "paragraph_end": 23,
      "label": "沾因果斩哭确认、最大因果避而杀债合线天怒",
      "direction": "道一仅存染气助诸果之因粗辨方向未真正参悟。哭百万级杀债细线、大方向师父苏等避，最大瀚海西宏因果孟感觉接必死而刀避。14怪风合无辜债粘刀即时天报，源何操暗算孟疑、顾无施术迹象不独证没暗中动。17天怒宣叙非天道新口角色。",
      "evidence": [
        "v04-c0278:p0006",
        "v04-c0278:p0023"
      ]
    },
    {
      "paragraph_start": 24,
      "paragraph_end": 32,
      "label": "第一紫罚锁魂、雷痕法天吸雷刀抵与真元耗",
      "direction": "紫罚孟感近半法全击非自身晋半法，法天雷痕令稍慢、天之伤力坍刀尖漩虚雷。海浪小半湖水源多拉/多伦异写留案；32未伤但半体麻真元近掏，非抵所有天罚结束。",
      "evidence": [
        "v04-c0278:p0024",
        "v04-c0278:p0032"
      ]
    },
    {
      "paragraph_start": 33,
      "paragraph_end": 49,
      "label": "青雷持续、阴阳生力开光守域及元磁偏末电",
      "direction": "阴阳印实际转生死榨力、开光斩青海入微自开小界不是新真实世界。末电孟信中必死，天心我意诀完整呈元始雏领域时空略乱缓雷，真两极元磁玄光兽变偏电，49云散48十里虚无地火真实范围，未额外未叙人群死亡。",
      "evidence": [
        "v04-c0278:p0033",
        "v04-c0278:p0049"
      ]
    },
    {
      "paragraph_start": 50,
      "paragraph_end": 62,
      "label": "怪剑补袭、沾因果首失效、左臂自斩与戒杀伤逃",
      "direction": "戒杀不理背掌命只杀孟，孟看到她单黑杀因斩尽别线沾不能用，是首次失效非再成功一刀。雏元始减杀乱时空侧仅左臂中、金黯侵神59自切臂八九缓才来得及；老者掌背让戒杀黑血腐重伤62逃被紧追。没她死/被擒，孟断臂未重生。",
      "evidence": [
        "v04-c0278:p0050",
        "v04-c0278:p0062"
      ]
    },
    {
      "paragraph_start": 63,
      "paragraph_end": 70,
      "label": "团队丹实吞、顾暂不杀与大能警告说法",
      "direction": "63孟拿团队那粒东极没别法，64服前顾杀夫问65、孟口有余勇，67顾退说没时机实际看吞丹。丹现团队一粒耗不补旧个人疑账/全队零库存，回复断臂尚未给。顾七八成潜伏率与幕后警告/试底牌为她分析，不因天罚就证幕后真名/韩已识心理；孟仍谷内未去北周。",
      "evidence": [
        "v04-c0278:p0063",
        "v04-c0278:p0070"
      ]
    }
  ],
