{
  "schema_version": 1,
  "chapter_id": "v04-c0243",
  "title": "第二百四十三章 可怕的刺客",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "fd9cf73c5f2a82907864013eabae1b9927d95ed0d212b667250afa13fc77d3c1",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S25",
  "pov": "同护出发、刺客诱导破识、实脑伤后第二头元神转栖的悬战",
  "attribution_caution": "19兄妹误估孟顶多五重不真实六重降境；47剩一次是人物次数期待不可覆盖2414超过三失败规则。第二遭掌伤真，第三后脑中剑也真但72元神入另头未死亡，73抓住你了未擒敌结果。38未及催昆仑不证明已修复或实际开启；44主材未取。真实出发近范围尚未到画眉。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 12,
      "label": "凌舍命共护、毁堡示警疏散后实际出发",
      "direction": "晨景昨夜乱；凌赞豪杰愿舍命护，提制造大动静引武林强者顾忌。楼会放弃是宽慰不是事实，实际火云冲光建筑近三成毁女心痛，小当已疏散其余人；孟先飞长老卷兄妹凌压阵三光赴画眉。",
      "evidence": [
        "v04-c0243:p0001",
        "v04-c0243:p0012"
      ]
    },
    {
      "paragraph_start": 13,
      "paragraph_end": 26,
      "label": "护人心态与刀感、截晓秀背心刺",
      "direction": "孟料仍会袭全运八九危险心感、精神刀眼耳防先杀同行乱心。兄妹怕孟顶多五重为其误估非实际降境，听心跳女绝望；天伤骤斩女背心层炸加速截莫名剑尖力抵无风身影出现，不孟攻击女。",
      "evidence": [
        "v04-c0243:p0013",
        "v04-c0243:p0026"
      ]
    },
    {
      "paragraph_start": 27,
      "paragraph_end": 42,
      "label": "转虚再实诱错防、长掌挡剑血伤敌退",
      "direction": "孟流火分千光罩后，敌正面忽实后杀意消风龙挑天伤袭眉心刀剑回不及；新掌淡金被刺血肉糊握尖，来不及取斩玉玄龟催昆仑。39右斩玉将斩流火天伤回转，敌怪劲抽剑虚退攻击只裂气流、凌棒反应晚落空。",
      "evidence": [
        "v04-c0243:p0027",
        "v04-c0243:p0042"
      ]
    },
    {
      "paragraph_start": 43,
      "paragraph_end": 53,
      "label": "公开豪语稳众、内慎不弃与领域复盘",
      "direction": "凌骂跑快孟想若缠可取神兵主材未实际取用；孟公开偷袭轻伤不足道是稳恐惧，兄妹咽自请留下话、孟仍慎决不弃免违心破绽。领域用于隐身分化切换不削孟正常实力，敌看似略差正常七重却更危险，法天结束前可战普通七重是比较假设非本段实用。",
      "evidence": [
        "v04-c0243:p0043",
        "v04-c0243:p0053"
      ]
    },
    {
      "paragraph_start": 54,
      "paragraph_end": 73,
      "label": "近画眉感应边界、影活后脑实中与第二头反击",
      "direction": "两多时辰飞至距法身自然感应范围百里未入山门，孟推敌等耗精力。刀轻危来妖魔授首束雷几十丈避同行，自己影活剑玉枕穿新两臂后脑淡金略破劲摧脑、女尖叫。孟巨身实际膨胀斩玉拷心非普通攻击，元神临危变遁至另头活，抓住你了孟喊但结果未现。",
      "evidence": [
        "v04-c0243:p0054",
        "v04-c0243:p0073"
      ]
    }
  ],
