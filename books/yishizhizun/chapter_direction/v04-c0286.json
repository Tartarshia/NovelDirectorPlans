  "chapter_id": "v04-c0286",
  "title": "第二百八十六章 宿敌",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "fce29f014fe15784ff96b53fc2cf4c10d7688581ebcdcadab998107576c5cf25",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S35",
  "pov": "罗刹阵场崔死太离伤、兰柯灭火与高剑玺应激",
  "attribution_caution": "崔死58明、至戈北返无落太离；兰柯三弹灭火不千里实际尽灭。白虎重伤未死、舍利幻元空不本人活，空召回未新招。高剑自应宿敌双持玺但王道效果/醒境未给，孟本章未新场。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 12,
      "label": "崔紫霞至戈争喘息、无色火吞火与兰柯救生",
      "direction": "正常人仙持兵可避醒地仙枪但刷后元神晕给威胁窗口，非枪绝对无条件杀全部法身。紫阳球被吞，至戈挡却附力火逼切联系甩焰，神兵本体没燃。湖水燃千里将焦为未遂，兰柯手三弹实灭，崔又刷未立刻亡。",
      "evidence": [
        "v04-c0286:p0001",
        "v04-c0286:p0012"
      ]
    },
    {
      "paragraph_start": 13,
      "paragraph_end": 21,
      "label": "罗刹逼云鹤先守，万象牵岩星攻太离",
      "direction": "云欲聚阵救崔被血影化血刀逼，太阳真火日被染血崩本刀无burn。云新晋道术未全熟还削夔虎；星线牵不大岩星陨，非操所有宇宙星/已砸死太离。",
      "evidence": [
        "v04-c0286:p0013",
        "v04-c0286:p0021"
      ]
    },
    {
      "paragraph_start": 22,
      "paragraph_end": 37,
      "label": "元空舍利挡夔、空闻神掌重伤白虎又被牵",
      "direction": "元空第六迦叶法身罗汉果舍利幻化灵智低，不活僧复生。空神掌拈花一笑多年总纲后登堂，白虎头重伤未死未真成佛；夔诈开当助挡空救援，空急稍降收心净，未脱身救崔。",
      "evidence": [
        "v04-c0286:p0022",
        "v04-c0286:p0037"
      ]
    },
    {
      "paragraph_start": 39,
      "paragraph_end": 58,
      "label": "赤刷枪循环崔拼日、陨联击伤太离，崔死至戈北返",
      "direction": "太离刷枪封逃循环，崔法身日至强以攻求命百丈非正式接近传说真正太阳。陨刷后枪火包日太离血羽伤、崔严重再刷枪中身烧，58干掉明确崔死。57至戈剑遁北平津太离未夺；源58陨石弄伤保原与49刷陨并存勿脑补未描撞击。",
      "evidence": [
        "v04-c0286:p0039",
        "v04-c0286:p0058"
      ]
    },
    {
      "paragraph_start": 59,
      "paragraph_end": 65,
      "label": "空闻召回舍利义无反顾，高剑玺宿敌应激",
      "direction": "空召回元空舍利还未新绝招/身亡。高宝座眼电人皇自发光61站起喝62兵抗妖圣史解释，双持人皇北周帝玺65低语王道未实际演示。人皇醒几阶未给、高未亲临罗刹场/已拦法王。",
      "evidence": [
        "v04-c0286:p0059",
        "v04-c0286:p0065"
      ]
    }
  ],
