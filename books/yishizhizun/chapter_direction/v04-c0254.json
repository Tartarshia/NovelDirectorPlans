{
  "schema_version": 1,
  "chapter_id": "v04-c0254",
  "title": "第二百五十四章 玉虚宫前",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "ee7902ebd08e049eed1d7298773d8826a488ac1877d3caa4a2e0794bb06a099a",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S28",
  "pov": "玉虚宫前两路齐赴、临梯未晋的修行成果与法身余威宇宙震撼",
  "attribution_caution": "孟30明确未宗师、落宫前朱门未入；杨师转述未实名，顾横无口词。两法身48明、师人仙楚推。招近法身非境界；打神鞭姜传为孟猜，古井危险齐说未触，万界拳齐识袖困齐报未见胜。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 19,
      "label": "楚与来客互探、杨兮之顾横具名和均分协议",
      "direction": "如意亮源楚再感宫，两客名杨兮之顾横由杨自报；顾木讷无话。师诅咒伤难离乌巢与大劫是杨转述，楚猜师人仙乃至更强非确。土行孙传承楚说辅修，杨道德天鉴顾广成图录，钉头七箭斩仙飞刀略有所得/师赐宝未名，合作护持均分只是约定未得。",
      "evidence": [
        "v04-c0254:p0001",
        "v04-c0254:p0019"
      ]
    },
    {
      "paragraph_start": 20,
      "paragraph_end": 23,
      "label": "如意开启、楚卷两客入莫名界",
      "direction": "如意紫白升不同前亮，楚说开启，实裹两客借如意遁莫名之界，不等已经进宫深处。",
      "evidence": [
        "v04-c0254:p0020",
        "v04-c0254:p0023"
      ]
    },
    {
      "paragraph_start": 25,
      "paragraph_end": 33,
      "label": "门槛未晋、齐拉同行与八九月修成果",
      "direction": "宫感更清，齐传音拉住金莲裹两人入虚空。孟仍非宗师没预邀帮手，真实八九月易筋二辅助内景肉身与变天不死进；自创招近法身是招式品阶，自评普通举手勉抗宗师非实战胜或已法身。",
      "evidence": [
        "v04-c0254:p0025",
        "v04-c0254:p0033"
      ]
    },
    {
      "paragraph_start": 34,
      "paragraph_end": 42,
      "label": "宫前金钉古井与木鞭、姜系来源仅猜",
      "direction": "实体落地见玄黄宫朱门紧闭365金钉；不识字义自映，三面各九井所见，36井通界危险为齐说明不窥落。齐带穿井至门右持21节四印木鞭，孟认打神鞭并猜姜传后，不定已证来源或齐当前姜子牙本人。",
      "evidence": [
        "v04-c0254:p0034",
        "v04-c0254:p0042"
      ]
    },
    {
      "paragraph_start": 43,
      "paragraph_end": 53,
      "label": "两法身笑中突袭、玄磁挡部分诅咒",
      "direction": "楚三人现两师叔笑各打杀手，齐袖里乾坤楚拳宇宙眼。孟被余威晕撕感不晋法身，换穿玄磁扭多数冷咒但部分直中八九血灭又生消；护具非绝对免疫。",
      "evidence": [
        "v04-c0254:p0043",
        "v04-c0254:p0053"
      ]
    },
    {
      "paragraph_start": 54,
      "paragraph_end": 60,
      "label": "大日实际御寒咒、陌生星球与宇宙推测",
      "direction": "孟内景大日升整化太阳实抵冷咒，再见虚空星与土黄大球失重推在宇宙、拳余波送太空与功法问是内惊；不编星球名/恒星已成/科学环境测定。太阳抽出四肢抱胸呆滞留观感尺度。",
      "evidence": [
        "v04-c0254:p0054",
        "v04-c0254:p0060"
      ]
    },
    {
      "paragraph_start": 61,
      "paragraph_end": 65,
      "label": "玉清元始身出现、万界挪移拳与袖困转报",
      "direction": "神人庆云金莲持鞭玄黄小旗，孟识齐玉清元始身，旗未实名。孟飞问齐凝重称楚练万界挪移拳并被袖困，扬袖不直接见楚囚内，更无死亡或胜定。",
      "evidence": [
        "v04-c0254:p0061",
        "v04-c0254:p0065"
      ]
    }
  ],
