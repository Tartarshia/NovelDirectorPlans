  "title": "第二百六十八章 震撼消息",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "be850efcc740485921cc34790ccb2f7f7f757f0898c7fe5be5d9ff9afac9501e",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S32",
  "pov": "黄帐情绪试探被圣女打断、顾的联盟说法与曹首级震撼揭露",
  "attribution_caution": "罗睺真名沙麻火非神话另罗睺，情绪纳掌非全面他心读宗师；顾圣洁公众像未识假孟，高曹政治说法带来源孟疑虚实；首级孟认曹死亡表象强但死因真魂未解，顾未现场杀人。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 13,
      "label": "黄帐实入、沙麻火罗睺别称与万虫现场",
      "direction": "黄帐杀血气、两开窍弟子被极恶念慑让入，蒙南是其感觉比非真正来。罗睺乃沙麻火修罗睺相世代称，楼伽未过首梯、另一年轻硬朗弟后17小罗睺，万虫联络使真在；万虫血教二弟子不同黄门二开窍勿混。",
      "evidence": [
        "v04-c0268:p0001",
        "v04-c0268:p0013"
      ]
    },
    {
      "paragraph_start": 14,
      "paragraph_end": 27,
      "label": "以宗师气派绕题激情、亲传小罗与楼伽比较",
      "direction": "孟先不直答品酒香问弟，16粗感法相非宗师读心全知，17小罗新外景19过去人榜前三非当前榜一。20傲楼怒21血弟比较25罗不耐26孟纳变化修元心，不等全面控两宗师或突破267他心通限制。",
      "evidence": [
        "v04-c0268:p0014",
        "v04-c0268:p0027"
      ]
    },
    {
      "paragraph_start": 28,
      "paragraph_end": 31,
      "label": "万虫称古打退、孟表面胜势宣言中嵌跟随之疑",
      "direction": "万虫28说古打退陆冲是其立场版本，265二人从容离不可换成败逃。孟30看似卖联古胜好处实际上跟随古埋从属问题，两修罗弟子31皱眉，未罗万明确策反同意。",
      "evidence": [
        "v04-c0268:p0028",
        "v04-c0268:p0031"
      ]
    },
    {
      "paragraph_start": 32,
      "paragraph_end": 44,
      "label": "顾与掌灯实际来、公众圣女与孟私熟形象反差",
      "direction": "铃钟诵无原词不造经句。顾白靴白莲、掌灯青灯老者33后41地榜66宗师侍，弟子及两宗主视色多看但无控心认证。孟35认顾内惊未顾识假孟；38/39弟子群内赞未分，42–44反思何为真顾不旁白判真性。",
      "evidence": [
        "v04-c0268:p0032",
        "v04-c0268:p0044"
      ]
    },
    {
      "paragraph_start": 45,
      "paragraph_end": 56,
      "label": "顾高览曹氏口述、万虫先承诺与孟怀疑虚实",
      "direction": "顾47不可挽回未解释，48万虫情微起后承血教襄且49孟疑未见血海发话。50高谋斩正一人反水、三位晋导致失衡，是顾消息而非独证全过程，52罗万共同惊问53谁喜谁忐忑未明。54孟知虚实人皇剑省略55泄密不怕疑；56曹抛高臣古为顾自述。",
      "evidence": [
        "v04-c0268:p0045",
        "v04-c0268:p0056"
      ]
    },
    {
      "paragraph_start": 57,
      "paragraph_end": 64,
      "label": "首级展示与孟曹识别、八九死因矛盾未解",
      "direction": "顾拿带血首级，58孟认清源曹、59/60死亡惊问，61/62八九危预逃能为何失败是孟疑。63美脸血头对比64妖女评是此刻孟视角，不新增顾当场斩首/谁杀过程、元神灭亡真相。",
      "evidence": [
        "v04-c0268:p0057",
        "v04-c0268:p0064"
      ]
    }
  ],
