{
  "schema_version": 1,
  "chapter_id": "v04-c0178",
  "title": "第一百七十八章 反常",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "a16520ebc27210fd9b64164f95191434e97c0e80cfee5ca62f28e6711ceb8fe6",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S19",
  "pov": "梳理所学的准备、兑换落定与仙迹邀请分歧",
  "attribution_caution": "区分价格与善功实扣，阮借额未明不可填；上品刀剑实升但白虹流火只是近极品。齐拒的真实原因未知，阮选称号不等入会完。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 14,
      "label": "招式融合与半年计划",
      "direction": "第一梯后闭关难单升但孟所学杂需半年贯通，过去开天和日陨只是两项初步融合，非已经道成；江认同以道传框架融合，斩道见我仍孟描述表象。",
      "evidence": [
        "v04-c0178:p0001",
        "v04-c0178:p0014"
      ]
    },
    {
      "paragraph_start": 15,
      "paragraph_end": 23,
      "label": "三刀与上品刀实兑",
      "direction": "孟三刀千刀不尽十刀破极一刀绝空8800、半年1200、天伤升级1200，余1190借款前。天伤上品重700斤以上价6700非卖钱。流火吸牛血已近极品但未升，二悟树收入等为未来来源。",
      "evidence": [
        "v04-c0178:p0015",
        "v04-c0178:p0023"
      ]
    },
    {
      "paragraph_start": 24,
      "paragraph_end": 33,
      "label": "赵拒额外闭关阮借江买",
      "direction": "赵料不久三重但第一梯需磨砺，没借时没晋。阮材料够想加时，28约后借而33明已借数不详。江实际半年、养剑酒2200、无缝天衣8800，白虹未极品，护衣催防相当当前孟不等永远同。",
      "evidence": [
        "v04-c0178:p0024",
        "v04-c0178:p0033"
      ]
    },
    {
      "paragraph_start": 34,
      "paragraph_end": 40,
      "label": "齐一年与寒螭上品",
      "direction": "齐一年2400、第二暗混沌晶2000、寒螭带材升级4600，余额190可算。寒螭上品价6400，冰封数十里是全催描述未当场发动。赵寒暄实际离广场，三人拟闭关。",
      "evidence": [
        "v04-c0178:p0034",
        "v04-c0178:p0040"
      ]
    },
    {
      "paragraph_start": 41,
      "paragraph_end": 54,
      "label": "阮同意而齐拒邀请",
      "direction": "孟才公开仙迹于留下众，阮接受因信任有益无害家，齐称不喜约束拒并直接入房闭关。孟疑与阮江回想齐触树惊相，原因未知别补魔主等。孟拟离轮回谈齐、江带阮入仙迹，尚未执行。",
      "evidence": [
        "v04-c0178:p0041",
        "v04-c0178:p0054"
      ]
    },
    {
      "paragraph_start": 55,
      "paragraph_end": 57,
      "label": "选广寒并感树开始修炼",
      "direction": "阮选广寒仙子因音律掩饰与轻功保命，未正式签约授全法。阮实际感悟大道之树后孟压担忧开始闭关，没半年已过或升五重。",
      "evidence": [
        "v04-c0178:p0055",
        "v04-c0178:p0057"
      ]
    }
  ],
