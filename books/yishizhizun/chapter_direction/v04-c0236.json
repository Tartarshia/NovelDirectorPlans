  "title": "第二百三十六章 各自的轮回",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "8202ff8eceb2e70bab76e2a3fffb3a0c4520674294c910c91d4c58f7e0277caa",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S24",
  "pov": "各自单人任务与保命兑换、广场孤坐赴谢陆",
  "attribution_caution": "易筋二书实得不是即功全升，孟15余额推；江新欠500玩笑利息非已900/1300实际债。孟单任务内容三友禁知；赵阮时间已兑目的世界未抵明、江时间费2400账推。明确余赵100阮125江725查询费用差保留；栖凤已中品借七仙未还昆仑碎未实修。孟返纯阳赴画眉未见陆。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 9,
      "label": "易筋三卷价制、江借500孟实兑第二卷",
      "direction": "孟认二卷最合适前两不用专任务，三卷10万需任务；江九出十三归玩笑借500真实过账，孟出40000拿二卷33姿书不是已练完。齐生离仍笑掩怅。",
      "evidence": [
        "v04-c0236:p0001",
        "v04-c0236:p0009"
      ]
    },
    {
      "paragraph_start": 10,
      "paragraph_end": 28,
      "label": "先查单人任务、孟私闻兰若黑山与赵神魔修行装备",
      "direction": "孟问赵先查，赵因怕死急修作自省非反事实齐拖真成。单人信息400M实际付私心接4000兰若找黑山真身根脚除、泄露抹，不立即入任务。赵选神魔世界年2400叠符2月，金光符6300两次、龙蛇赎从1800到100价1700推，余额明100差额保留。",
      "evidence": [
        "v04-c0236:p0010",
        "v04-c0236:p0028"
      ]
    },
    {
      "paragraph_start": 29,
      "paragraph_end": 41,
      "label": "阮封神学传琴江游剑结伴、孟请搜玉虚",
      "direction": "阮拟前第一梯不满实力江问弱强选择，阮封神琴江封神游剑墨家同伴。江闻战触升感觉非明确新境，孟暂自己宗师后封神请三仙迹可用积累搜玉虚非宫消息已得，赵外围仙迹不formal自动。",
      "evidence": [
        "v04-c0236:p0029",
        "v04-c0236:p0041"
      ]
    },
    {
      "paragraph_start": 42,
      "paragraph_end": 50,
      "label": "新假形护元神防绑与琴中品、赊丹建议",
      "direction": "阮云霄真形7000假形替打2次+广寒配，栖凤4000实际中品封神后还七仙计划，年2400余额明125；江大罗翠坠7000神护被动2义人桩6000代绑2配无缝余额725。查询费未逐列保账疑；孟建议碧游赊丹她们点头未真买或借。",
      "evidence": [
        "v04-c0236:p0042",
        "v04-c0236:p0050"
      ]
    },
    {
      "paragraph_start": 51,
      "paragraph_end": 54,
      "label": "三友离广场孟独冷清、回纯阳赴画眉未到",
      "direction": "三友消失广场未逐描抵封神神魔或一年修完，孟怔问最后谁，良久真回纯阳因陆隐私暂不告冲和那剑，告辞直往画眉还未到或见陆。",
      "evidence": [
        "v04-c0236:p0051",
        "v04-c0236:p0054"
      ]
    }
  ],
