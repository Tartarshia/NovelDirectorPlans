{
  "schema_version": 1,
  "chapter_id": "v04-c0211",
  "title": "第二百一十一章 前有剑神苏无名",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "fda8cdb06dea517fbe84bb77cb54dcb2dfde61453643cfacbaa880184c0fe286",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S20",
  "pov": "双葬星河杀离别、假旗吓退两魔，再迎兽神龙熊带师徒走",
  "attribution_caution": "真假玄水旗与过去传闻分开，实杀离别本章才证；两魔兽神龙熊活逃，兽神人六重兽宗师战力，未再用法天天心古符。收银钩两未名材无袋，最大秘密未讲。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 17,
      "label": "两重葬星河终杀离别，范围爆炸阻两援",
      "direction": "万物返虚道传演葬星河本非范围技但爆炸等效，白芒高温毁山林两援只能防，第二重落离别看似冲出旋崩灰确死。银钩少损两同强天材漂未此时直接当取得，外围有灼伤。",
      "evidence": [
        "v04-c0211:p0001",
        "v04-c0211:p0017"
      ]
    },
    {
      "paragraph_start": 18,
      "paragraph_end": 43,
      "label": "狂刀身份被识与毛发假旗骗退敌",
      "direction": "血婴认狂刀苏孟，脑内旧传闻包括旗还能一次是其消息非实况。孟拿假旗作欲攻，血婴血光逃、枯骨见主事逃不再怕罚黑霞遁。旗实际变回毛发，实摄银钩两材；真旗早毁未修，210假孟术材仍未证。",
      "evidence": [
        "v04-c0211:p0018",
        "v04-c0211:p0043"
      ]
    },
    {
      "paragraph_start": 44,
      "paragraph_end": 58,
      "label": "法天结束、兽神与龙熊实体到",
      "direction": "孟法天结束师徒惊、外围震慑，但兽神和龙熊实到外围欢师徒沮。兽神六重佛门堕弟，龙熊宗师战力低智未化，一兽一人不同实力层；孟短时难再法天除非天心但未用。蛮祖万虫未到。",
      "evidence": [
        "v04-c0211:p0044",
        "v04-c0211:p0058"
      ]
    },
    {
      "paragraph_start": 59,
      "paragraph_end": 74,
      "label": "初攻兽神转阴雷缠龙熊，硬接人掌继续压兽",
      "direction": "孟剑百光先点兽神，人退兽青焰掌孟闪，天伤阴雷蚀身缠兽，兽神莲花金刚堕掌打背毁衣无本体伤；孟万物返虚伤兽头迎第二掌再劈，流火避引眉心攻击不失防，秘宝掌如叮无效。",
      "evidence": [
        "v04-c0211:p0059",
        "v04-c0211:p0074"
      ]
    },
    {
      "paragraph_start": 75,
      "paragraph_end": 90,
      "label": "龙熊重伤仍活，兽神遁逃师徒实脱围",
      "direction": "孟暴喝给我开斩混沌阴阳击兽深血痕倒飞非已断杀。打够了没震兽神保命符遁地，兽缓随逃孟不追，喊还有谁来外围藏群心以苏无名相并。孟五重未宗师，南荒前十仅观感，实带师徒飞走未获最大秘密。",
      "evidence": [
        "v04-c0211:p0075",
        "v04-c0211:p0090"
      ]
    }
  ],
