{
  "schema_version": 1,
  "chapter_id": "v04-c0301",
  "title": "第三百零一章 再遇蓝血人",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "33d7f5417c1525b6752264514e7f2c92cf5eab267e9cdcd560d024101e9140a2",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S39",
  "pov": "金帐遇袭幸存者、戊己土行逼兰与大日显高",
  "attribution_caution": "右手实际已用过程未描不倒补300。莫死师尸及三徒袭报、狂刀万能是徒仰期非全作者实。射日弓部众分藏非孟得。戊己土波未直接洞察兰人、撞未死；大日显高只显身不已杀或证所有失踪他因。深处未揭、两目标哈斯戒杀未新死。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 12,
      "label": "金帐暮败心映寻线、收暗器见莫师尸和三徒",
      "direction": "金帐几百里败草尸阴鸟，孟猜失踪哈斯等非确定；左鞘右掀帘收暗器证右可用非300已证。二男一女年轻武者持剑悲惧、白发师尸内脏窍坏未先取名/死于谁确。孟无新杀三人，他们庆非敌。",
      "evidence": [
        "v04-c0301:p0001",
        "v04-c0301:p0012"
      ]
    },
    {
      "paragraph_start": 13,
      "paragraph_end": 23,
      "label": "蓝衣半茶遇袭口报、女识狂刀与地24信赖",
      "direction": "蓝衣少侠改前辈怕外貌老怪不是孟老化，师半盏茶吓退敌但亡为口说。女子惊识蓝男特刀故事比确认孟，徒夸狂刀侠与地24顶尖安保是期盼非孟可胜所有左道。22无形袭口报23孟保持戒问过程不已全识敌。",
      "evidence": [
        "v04-c0301:p0013",
        "v04-c0301:p0023"
      ]
    },
    {
      "paragraph_start": 24,
      "paragraph_end": 33,
      "label": "莫邵天名号一流判、寻宝坦陈与宝库分散撤离",
      "direction": "长乐铁背苍龙莫师身份蓝口报25尸一流孟判。复南侵仇与见识目的、金帐寻宝贪坦陈孟量力不鄙。九娘随叶首搜是孟所知非此章会面金额，30作者射日弓宝库武士萨满分藏源实不孟夺/弓毁。33多日死失师决离帐遭影为蓝说。",
      "evidence": [
        "v04-c0301:p0024",
        "v04-c0301:p0033"
      ]
    },
    {
      "paragraph_start": 34,
      "paragraph_end": 46,
      "label": "戊己察土微非直接窥人、脚震逼出变钢拒再遁",
      "direction": "止说金帐静阴凉，35孟平淡土朋友36实尚没察人只戊己土细波，37朗邀无响39内真找40脚土浪三十丈喷影41想远土遁42二步地钢43/44撞晕滚非已死，46孟刀斜垂非好杀不实际砍兰。",
      "evidence": [
        "v04-c0301:p0034",
        "v04-c0301:p0046"
      ]
    },
    {
      "paragraph_start": 47,
      "paragraph_end": 54,
      "label": "九袋兰惊天藏暗与大日显九指高乾元",
      "direction": "47脏泥九袋凶眼当丐帮宗师兰，48老朽暗习退49莫杀意他感。50孟大日火显原无形苍老九指，51认52高乾元与东海剑庄蓝血明确；53高叹平起是认孟成长非自身降级/孟已大宗师新境。54望金帐深似藏物未揭，与无形死伤谁全因未定。",
      "evidence": [
        "v04-c0301:p0047",
        "v04-c0301:p0054"
      ]
    }
  ],
