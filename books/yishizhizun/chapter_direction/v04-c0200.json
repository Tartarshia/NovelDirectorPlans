{
  "schema_version": 1,
  "chapter_id": "v04-c0200",
  "title": "第二百章 来自万古前的攻击",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "ab0caba785eaa4d6c5c49e11756623c1b51e222cffee21d6d67100fe6b3dfe03",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S19",
  "pov": "冰眼实催与跨古火劫、顾救合挡羲逃和镜片丹药后封神",
  "attribution_caution": "冰眼本章先冰羲再借阴阳印两次施展后裂，下一用损主材不杜撰固定次数；天心实催、药师心丹实服但反噬未愈。古符末次未用，羲活逃不获神躯整传承。来世镜碎实收，大日品阶次数只孟目测。顾救与封都实事动机未知，未完成安全疗养或两果分配。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 11,
      "label": "晶魄真正冰羲，孟强退保古符",
      "direction": "幽蓝实发羲回忆乱短暂后压住但来不及避，五德凤凰冻。孟要的是机会不是心破不战胜，道传总纲修刀剑融通，强忍虚脱退。10可约本愿但羲不退；古符末次仍留未用。",
      "evidence": [
        "v04-c0200:p0001",
        "v04-c0200:p0011"
      ]
    },
    {
      "paragraph_start": 12,
      "paragraph_end": 24,
      "label": "神君醒隔古火威，符欲催而不及",
      "direction": "金影睁日起身火从过去到现在，孟震慑袍燃唯我内佛解些仍高热焦金。似法身跨古威传说，并不孟已传说。天心运危险来不及主材，古符要用能用都不等实遁。",
      "evidence": [
        "v04-c0200:p0012",
        "v04-c0200:p0024"
      ]
    },
    {
      "paragraph_start": 25,
      "paragraph_end": 43,
      "label": "顾白莲救与孟天心借晶魄阴阳印合挡",
      "direction": "顾真实现救白莲神音发声本体未定，喷血清光只削火。孟天心彻底实催不灭相道人显如形不是元始真人，借冰眼阴阳印转火冷，两人合挡均伤虚；冰眼裂再用会伤主材品质，不定填剩次数。",
      "evidence": [
        "v04-c0200:p0025",
        "v04-c0200:p0043"
      ]
    },
    {
      "paragraph_start": 44,
      "paragraph_end": 56,
      "label": "神君入今衰化进羲，羲伤逃双方重伤",
      "direction": "神君跨过去来今万古冲刷缩衰化光入羲眉，冻解面具碎灰露古拙脸、羲吐火血逃差但活。孟重伤反噬无力催符，顾咳弱求助孟扶她，她笑又救眼波未知真意。",
      "evidence": [
        "v04-c0200:p0044",
        "v04-c0200:p0056"
      ]
    },
    {
      "paragraph_start": 57,
      "paragraph_end": 65,
      "label": "服丹与实际收镜片，焰心吸血火变化",
      "direction": "顾服未名疗丹孟实际药师心丹。指残留羲火血及小琉璃片，孟大日焰心实吸火血强而内敛，品阶升一层和次数恢复为目测似。顾多年布局与两者冲突为说法，孟摄来世镜碎实识已获不再只找。",
      "evidence": [
        "v04-c0200:p0057",
        "v04-c0200:p0065"
      ]
    },
    {
      "paragraph_start": 66,
      "paragraph_end": 77,
      "label": "互扶到无人灰殿，顾古史转注意后封元神",
      "direction": "顾提安全处孟同意，求扶真假为孟疑不能抹她真实喷血与弱气；互扶今生方向入无人灰殿确认安全仅当时。顾说两镜殿后来刻毁，孟疑雷神等未证。趁分神反噬顾实点胸封元神，孟问她答你猜；目的未揭，不提前婚情或杀人。",
      "evidence": [
        "v04-c0200:p0066",
        "v04-c0200:p0077"
      ]
    }
  ],
