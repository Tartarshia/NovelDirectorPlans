{
  "schema_version": 1,
  "chapter_id": "v04-c0144",
  "title": "第一百四十四章 轰轰烈烈葬星河",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "007bf598ded7675090e5be5d94a9d10bc92be4220e31e33accecf295ab48a26f",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S15",
  "pov": "孟王双战含令狐求生视角，转宗师夺琴加码",
  "attribution_caution": "九指高乾元从59才明确同一；手骨挥出威胁但47明确省一次，不能误扣。令狐两断臂与顽石逃非死亡，血神珠已用与玄水旗亮出区分。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 13,
      "label": "手骨威慑与王兴奋",
      "direction": "王疑认骨来历兴奋咳血仍闪顽石，不作确认识全来历。令狐惧骨欲退却寿短不甘犹豫，孟抓心理空隙，非对方毫无战力。",
      "evidence": [
        "v04-c0144:p0001",
        "v04-c0144:p0013"
      ]
    },
    {
      "paragraph_start": 14,
      "paragraph_end": 35,
      "label": "两头四臂与未完善日陨",
      "direction": "孟四臂兵器刀骨流火雷刀、法相对应法理，日陨改大日混洞撞震伤下方邪魔；葬星河属描述不真毁宇宙。令狐以肉脂抵冲、增四臂元磁吸抗仍损一臂；34指出未完善可被抢先破，勿当无条件胜技。",
      "evidence": [
        "v04-c0144:p0014",
        "v04-c0144:p0035"
      ]
    },
    {
      "paragraph_start": 36,
      "paragraph_end": 47,
      "label": "阴雷断第二臂与骨未耗",
      "direction": "天伤阴雷腐蚀迫令狐自断第二臂，手骨藏空作杀招，令狐精血催相反磁逃，孟不追保护琴。47省一次骨明确未耗一次，即使已挥骨逼近不等命中发动。",
      "evidence": [
        "v04-c0144:p0036",
        "v04-c0144:p0047"
      ]
    },
    {
      "paragraph_start": 48,
      "paragraph_end": 58,
      "label": "顽石反复遗忘与竞速",
      "direction": "王反复刺眉心，顽石忘人忘战，最终怕遁未死。孟推有宝物辅助非全知确认。两邪魔俱逃，孟笑先解决，王无不满，未写王认输长篇。",
      "evidence": [
        "v04-c0144:p0048",
        "v04-c0144:p0058"
      ]
    },
    {
      "paragraph_start": 59,
      "paragraph_end": 67,
      "label": "九指实名与符令加力",
      "direction": "59明确九指蓝血就是高乾元，回补此前暂不合人。强催令改元气蛊攻逼阮伯高全守钟音，阮众援差境难牵，乾元欲先抢尚未到手。",
      "evidence": [
        "v04-c0144:p0059",
        "v04-c0144:p0067"
      ]
    },
    {
      "paragraph_start": 68,
      "paragraph_end": 77,
      "label": "奉典血神珠与戒赌脱身",
      "direction": "血神珠主材两百多年最珍贵、此前有别延寿丹未换东极；本次实际用一次不等珠毁。血海逼戒赌逃，钵失光但身有不明护无伤；乾元惧停，琴将被卷尚未得。",
      "evidence": [
        "v04-c0144:p0068",
        "v04-c0144:p0077"
      ]
    },
    {
      "paragraph_start": 78,
      "paragraph_end": 78,
      "label": "孟巨大身与裂旗亮出",
      "direction": "孟巨大法理身、取满裂红雾深黑旗，承前为玄水荡魔旗；仅到亮旗，不预写使用成功或归琴结果。",
      "evidence": [
        "v04-c0144:p0078",
        "v04-c0144:p0078"
      ]
    }
  ],
