{
  "schema_version": 1,
  "chapter_id": "v04-c0172",
  "title": "第一百七十二章 杀妖",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "502ced822cb7ae75c7b148ad2267b27e3f57bc49751039ebcbed95598b537e87",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S18",
  "pov": "迷阵分队后孟奇杀牛，江齐各自遇敌",
  "attribution_caution": "战利品保实得但不估善功；宝塔持赵本章明确。三线人物知识分隔，迷阵假孟非真实分身，黑袍与黑胖不混。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 13,
      "label": "谨慎试探仍未识迷阵",
      "direction": "狼嚎断仍不明死者。众先快后慢，阮常识与食物直觉警戒；孟八九玉虚神算慧眼加试攻击，斩断一树未收。只能发现无实质杀伤禁制，非绝对安全。",
      "evidence": [
        "v04-c0172:p0001",
        "v04-c0172:p0013"
      ]
    },
    {
      "paragraph_start": 14,
      "paragraph_end": 23,
      "label": "同伴消失与阵内受限",
      "direction": "孟欲示意却见林边无人，冲回场景变石道，迷阵隔感禁跃。信任务难度可控是孟判断非六道保证，真武曾为阵法操纵者优势今不适用。印记推演尚未走出。",
      "evidence": [
        "v04-c0172:p0014",
        "v04-c0172:p0023"
      ]
    },
    {
      "paragraph_start": 24,
      "paragraph_end": 46,
      "label": "遭牛与纯力压制",
      "direction": "重遇暗记遇无名牛妖，牛看孟四重轻视。孟单手普通刀力压，不用法天或法身招。牛黄命中脸仅红印，自身裂而被新增双臂收，牛怕逃；非牛黄无命中或孟全无伤。",
      "evidence": [
        "v04-c0172:p0024",
        "v04-c0172:p0046"
      ]
    },
    {
      "paragraph_start": 47,
      "paragraph_end": 61,
      "label": "拦牛斩首与选择收获",
      "direction": "踏虚筋斗步截逃，牛真身两丈角增，孟剑引手握角止牛、刀落紫电斩首。玉瓶收血，角皮等进环，有限空间弃低值；牛胃内收藏和钉耙收取，暂没可即用物，未兑换或善功自动结算。",
      "evidence": [
        "v04-c0172:p0047",
        "v04-c0172:p0061"
      ]
    },
    {
      "paragraph_start": 62,
      "paragraph_end": 67,
      "label": "关切队友与未知黑袍",
      "direction": "孟担心被假示意骗入阵；阮镜赵塔江战力为其风险估，赵持天地玄黄玲珑宝塔本章明。最忧齐不等齐已遇难。危险感触发藏石后，黑袍腐朽阴冷强者未名，非169已死大鹏同人。",
      "evidence": [
        "v04-c0172:p0062",
        "v04-c0172:p0067"
      ]
    },
    {
      "paragraph_start": 69,
      "paragraph_end": 74,
      "label": "江顺觉寻路遇虎",
      "direction": "江见假孟示意才带队入，几步全散。冷静不后退按直觉行到渐见宫殿，未已破阵；王字虎妖从侧路出现，未交战胜负。",
      "evidence": [
        "v04-c0172:p0069",
        "v04-c0172:p0074"
      ]
    },
    {
      "paragraph_start": 76,
      "paragraph_end": 80,
      "label": "齐遇黑胖敌仍无惧",
      "direction": "齐持龙纹赤金剑前行，黑胖汉撞碎侧石后轻蔑称弱小。齐扬剑不惊，具体敌名境界与战果未示；孟的担心不等齐真实实力已弱。",
      "evidence": [
        "v04-c0172:p0076",
        "v04-c0172:p0080"
      ]
    }
  ],
