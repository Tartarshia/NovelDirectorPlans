  "title": "第一百三十章 姜是老的辣",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "b736d0ce7cb4fb90c452da6a390a141f32920938da26e1de6491ac5b48cd0a07",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S14",
  "pov": "孟柳殿内知情与顾携女孩旁线交替；全知叙述仅用于读者",
  "attribution_caution": "孟未获顾旁线内容；表面母女不认证亲缘；轮回符只准备，尚未用。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 6,
      "label": "顾独自离开与留发",
      "direction": "顾放真商水留真郭喜，化虚而去；砖缝头发尚未解释，保留后备伏笔，不提前说孟知道顾目标。",
      "evidence": [
        "v04-c0130:p0001",
        "v04-c0130:p0006"
      ]
    },
    {
      "paragraph_start": 8,
      "paragraph_end": 30,
      "label": "柳共享感官入殿",
      "direction": "孟石饰不外探，借柳共享视听触觉知殿内；柳盼履约脱钳成为真传本尊。男弟子无所得再摸刀，孟雷痕熟悉感不等已感悟。柳借暂停观刀询安置得首次入殿。",
      "evidence": [
        "v04-c0130:p0008",
        "v04-c0130:p0030"
      ]
    },
    {
      "paragraph_start": 32,
      "paragraph_end": 44,
      "label": "楼阁女孩与母女称谓",
      "direction": "顾绕已查地带到唯一活树边，从袋放六七岁女孩梳头。娘称呼不证明血缘，熟悉此地与家的说法待揭。场景不加情色或成人化。",
      "evidence": [
        "v04-c0130:p0032",
        "v04-c0130:p0044"
      ]
    },
    {
      "paragraph_start": 46,
      "paragraph_end": 67,
      "label": "本尊守刀破乐观预案",
      "direction": "玄女安排碧落殿，柳闻声惊本尊竟未离。外面应身加神兵以假乱真；此前129本尊外出叙述按此新揭修正，非两本尊。她坚持所有入殿者检查，柳欲坦白却怕契约，孟逼近无路。",
      "evidence": [
        "v04-c0130:p0046",
        "v04-c0130:p0067"
      ]
    },
    {
      "paragraph_start": 68,
      "paragraph_end": 80,
      "label": "后备分身与古玄女揭露",
      "direction": "孟留发新分身引注意，准备触刀同时轮回符但未用，非129已毁分身复活。转顾称女孩不是流罗而九天玄女，女孩天真褪去，混合寄存机制仍待下章。",
      "evidence": [
        "v04-c0130:p0068",
        "v04-c0130:p0080"
      ]
    }
  ],
