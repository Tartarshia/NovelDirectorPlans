  "chapter_id": "v04-c0239",
  "title": "第二百三十九章 石家堡",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "5b70da652c3624a199d3c3e5aff697a50c05740ff6a7a33ac889d6c8fb5be609",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S25",
  "pov": "名望促见证生死战、失约引石堡魂灯谜",
  "attribution_caution": "S25石家堡案起，凌八袋癫棍身份明确不宗师已成，M声望近宗师不真实宗师。魂灯灭子女报强信号未尸死因凶，子女44共声、49二兄不能把43迎男自动同一二兄。贫乞多数恶是凌观点/M聚焦不现实事实，帮仍敌感非永久友盟。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 18,
      "label": "谢扰梦辨八袋凌跃、侠义不护贩者与丐帮戒心",
      "direction": "孟道歉忧隐气强宗师或秘法推；八袋缺耳老者先认狂刀礼叫少侠M忆情报认癫棍凌跃。凌嫡乞世侠直提后惩帮败支持江东诛拐卖，祖守助但败类多激批为观点，M仍认为帮强兔悲会暗报不能当全帮免仇。",
      "evidence": [
        "v04-c0239:p0001",
        "v04-c0239:p0018"
      ]
    },
    {
      "paragraph_start": 19,
      "paragraph_end": 31,
      "label": "请见生死约孟声望虚荣应、往事回忆",
      "direction": "M要离凌请见石天奇真生死为迈第二梯，立约死无仇称找外公证难此夜决，石草原北周商豪判官笔六欲宗师資料不出场。M原无趣拒被称声望近宗师暗喜改应，狂刀赞反嫌名而聊凌威风旧事非本章实际新伏草原战。",
      "evidence": [
        "v04-c0239:p0019",
        "v04-c0239:p0031"
      ]
    },
    {
      "paragraph_start": 32,
      "paragraph_end": 39,
      "label": "石失约两次等、未神算强行定位与同行",
      "direction": "凌飞感石守信却过半时再等半时又未来判事，友情叙明请M作没赴证，他答应两人流光北奔。M不知道石故玉虚无着不新神算已查凶或预言死。",
      "evidence": [
        "v04-c0239:p0032",
        "v04-c0239:p0039"
      ]
    },
    {
      "paragraph_start": 40,
      "paragraph_end": 50,
      "label": "石堡真正抵、子女魂灯口供与狂刀声望",
      "direction": "大半时到险禁堡嘈乱落，二十岁儿女迎44报父灯灭凌惊，紫女石晓秀问M名凌介群静。晓秀哭礼说父未夜突离没留言午夜二兄发现灭请做主为口供，M重要事推冷静还没看魂灯尸或凶是谁。",
      "evidence": [
        "v04-c0239:p0040",
        "v04-c0239:p0050"
      ]
    }
  ],
