{
  "schema_version": 1,
  "chapter_id": "v04-c0284",
  "title": "第二百八十四章 围攻藏剑楼",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "3b1da903c19adc7e87696b79e4fce264684f700055060b5f997438b257f74198",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S35",
  "pov": "陆冲与古交战、孟留窥助楼、双内应暴起身份更新",
  "attribution_caution": "战术担忧仍条件，四冲是同冲和分身不是四真人。邱头被刺仍斥未死；南宫非无面徒弟羽为其说，末勾陈内声暂待审。孟观前三准法/Cao蜕推似不敌全名确证，符未耗/未实救。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 7,
      "label": "陆专注与冲和担忧局部战术，尽人事平静",
      "direction": "陆只见古斧，冲和仍忧高是否拦法王韩是否觊刀/参另一战，局部快杀罗刹返援均条件预测。6叹语后平静7大局肯定不糜是内信不是作者胜局保证。",
      "evidence": [
        "v04-c0284:p0001",
        "v04-c0284:p0007"
      ]
    },
    {
      "paragraph_start": 8,
      "paragraph_end": 17,
      "label": "天诛首雷斧与陆拆解结构",
      "direction": "雷斧几千丈来、九纹威势；一心点结构崩雷反挡古进，实化首攻。古内觉陆似天仙微妙但没其力量，为敌评价不正式陆晋天仙。",
      "evidence": [
        "v04-c0284:p0008",
        "v04-c0284:p0017"
      ]
    },
    {
      "paragraph_start": 18,
      "paragraph_end": 33,
      "label": "火海细剑破与蛮力漩涡，四冲阵介入",
      "direction": "第二火斧细剑消海点斧回，古天罚体几十丈使千里暗气象非皆死；第三纯力漩涡吸城人物树石，陆微变不能用改直刺庚金体。四剑扭曲截地吸时间乱古遁阵，物能填涡未单署施者；四冲再斩欲拉古入阵，古水雾斧令四剑普通不地仙永久掉阶/已胜。",
      "evidence": [
        "v04-c0284:p0018",
        "v04-c0284:p0033"
      ]
    },
    {
      "paragraph_start": 35,
      "paragraph_end": 36,
      "label": "玄天守静刀前等待",
      "direction": "守静坐光阴刀前像等谁，未韩实际来偷或已夺、未证通知收到的过程。",
      "evidence": [
        "v04-c0284:p0035",
        "v04-c0284:p0036"
      ]
    },
    {
      "paragraph_start": 38,
      "paragraph_end": 41,
      "label": "江东妖族家庭秘术与未来不必伪装说法",
      "direction": "蛇眼孩子拒练妖皇典术，金离要夫人劝，沈若璇笑宽纵称将来或能大摇摆，只是未来期待不妖族已掌人间/正式三妖出战名单。孩子名未给。",
      "evidence": [
        "v04-c0284:p0038",
        "v04-c0284:p0041"
      ]
    },
    {
      "paragraph_start": 43,
      "paragraph_end": 58,
      "label": "孟遁高窥围攻，留助不计私怨",
      "direction": "孟收火相信楼防，游击凭符元心是计划未耗符。见军来实升高隐慧眼，阵外已猛烈攻。前三准法及曹蜕是孟推似，三黑榜前四神兵二十来宗师陈势不精总人数。孟忧破楼风向未撤寻帮机会，未实际出手。",
      "evidence": [
        "v04-c0284:p0043",
        "v04-c0284:p0058"
      ]
    },
    {
      "paragraph_start": 59,
      "paragraph_end": 76,
      "label": "祖师四剑残意稳阵后双内应伤邱",
      "direction": "邱祈祖无生光入剑坟，四法身祖残剑实凝加入阵稳，不四祖肉身复活。南宫先偷侧邱有备躲口果然你；羽秘长剑真背贯头口出、邱仍斥未死。南宫攀挡马李口否无面认徒弟、末我勾陈第一人称暂内念未口标签。双叛层次不可提前把南宫无面/羽清白，精确新境未给。",
      "evidence": [
        "v04-c0284:p0059",
        "v04-c0284:p0076"
      ]
    }
  ],
