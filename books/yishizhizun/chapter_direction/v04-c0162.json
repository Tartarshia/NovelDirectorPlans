{
  "schema_version": 1,
  "chapter_id": "v04-c0162",
  "title": "第一百六十二章 空有蛮力",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "03bea0c19c741f8eaec366373a955a1002ccb5f0e3ca475b583f80dfa681583f",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S16",
  "pov": "取宝、禁法破围与三人撤离",
  "attribution_caution": "宝物由所见改实获，天心未用、旗已毁、失败阵图江收回；遗蜕不取、雷痕身份不确证，三人撤离完成。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 6,
      "label": "外场识破与支援调整",
      "direction": "曹主飞月等识被调动欲返，冲和不能破联合防御但可苦撑短阻。城内高手被阵困，外来者赴湖，江收回阵图离谷拟拦。",
      "evidence": [
        "v04-c0162:p0001",
        "v04-c0162:p0006"
      ]
    },
    {
      "paragraph_start": 8,
      "paragraph_end": 23,
      "label": "借反震近树并停爆发诀",
      "direction": "玄水旗碰雷，殿禁隔余波，孟力量抽干借反震近树原是刻意。欲用天心我意却见尸抢六物而停止，未发动；六物诅咒循电绳反噬尸。",
      "evidence": [
        "v04-c0162:p0008",
        "v04-c0162:p0023"
      ]
    },
    {
      "paragraph_start": 24,
      "paragraph_end": 46,
      "label": "谨慎经验与执念消散",
      "direction": "鉴宝防险原则和神掌取宝教训相区分。尸执念全消倒地、肉身有损，非全灰灭；孟抓树入芥环。补叙真武教找藏开门解咒驱禁，未给物品具体信息，孟先识树无咒，才计划只取树。",
      "evidence": [
        "v04-c0162:p0024",
        "v04-c0162:p0046"
      ]
    },
    {
      "paragraph_start": 47,
      "paragraph_end": 58,
      "label": "六宝实收与旗毁",
      "direction": "六咒被尸承担，孟解咒检查无黑气再收六宝：大日焰心冰眼晶魄天河剑玄龟剑破空古符、疑玄冥造化丹一枚。旗耗尽毁明确，丹仍疑。因同道曹不拿遗蜕，见腕雷痕猜雷神传人未证、霸王前后未知。",
      "evidence": [
        "v04-c0162:p0047",
        "v04-c0162:p0058"
      ]
    },
    {
      "paragraph_start": 59,
      "paragraph_end": 77,
      "label": "禁法一次破阵逃离",
      "direction": "积攒余力激殿禁全力一次，殿塌宝界破灭，光裹孟冲寒乳与阵；天尊外斩合力裂隙，孟变出，江剑卷、天尊摄三人离。不是孟独力破阵或单独逃，乏力未证治疗；曹主怒忍双星仍不动。",
      "evidence": [
        "v04-c0162:p0059",
        "v04-c0162:p0077"
      ]
    },
    {
      "paragraph_start": 79,
      "paragraph_end": 82,
      "label": "道士记忆松动",
      "direction": "东海道士称是它似记起身份，表情喜烦并存，仍未实名或完全恢复记忆，孟未知。",
      "evidence": [
        "v04-c0162:p0079",
        "v04-c0162:p0082"
      ]
    }
  ],
