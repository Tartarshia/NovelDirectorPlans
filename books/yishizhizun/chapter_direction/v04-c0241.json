{
  "schema_version": 1,
  "chapter_id": "v04-c0241",
  "title": "第二百四十一章 瓮中捉鳖",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "1c8b024e4efb2da1c395b9e1d9a01a5733417e4aa4131a10df09e5f134d448b3",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S25",
  "pov": "禁法保护后揭周泄密疑、未供暗火与六道相似疑",
  "attribution_caution": "不仁楼阶杀目标非本人境，逾三失败传闻勿写三次必止。重构孤狼自毁区别240雇主毁尸解释，两者不同层证未亲历。周疑背叛反应吞毒真被止暗火灰死真、没供雇流程、不是已认六道轮回或某凶手操火。M落魂早猜50自己说明已回防护非盲，主队单任务秘密没泄。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 14,
      "label": "刺阶按能杀目标与传闻、M天伤守感平众",
      "direction": "晓秀惊凌棒戒，不仁楼北周总部传闻九成任务成功失败超过三弃退酬常无报为群知识。红半步橙黄一流弱强绿青绝顶弱强蓝宗师紫半法身天更上仅三史，不自身固定境。M推留下因任务未完成天伤极品感窥略强八九半心附刀双守，家人视感宗师是评价非孟晋。",
      "evidence": [
        "v04-c0241:p0001",
        "v04-c0241:p0014"
      ]
    },
    {
      "paragraph_start": 15,
      "paragraph_end": 29,
      "label": "枯木笔批死章、反推孤狼欲擒自毁与后手",
      "direction": "小当认父笔批死章M用两尸近且无移动伤控只一凶先攻孤狼父帮绕后杀重构；凌行踪若知应早杀反推M欲封元神擒活口孤狼自毁创造父出手而被杀后凶返视，未目击确认。草原谣言真假列例不古尔多实际地仙，周有妻子不知带南，M后手可能太多先回安尸。",
      "evidence": [
        "v04-c0241:p0015",
        "v04-c0241:p0029"
      ]
    },
    {
      "paragraph_start": 30,
      "paragraph_end": 44,
      "label": "真回禁法开、密关系仅三人推跟石到会",
      "direction": "众回堡晓秀等开启禁法书房霞盾M窗静再问唯父周狼知，中间线断周坚谨，M论孤狼未早被查则杀者跟石会面知狼所以内情泄目锁周。不是已找到留在堡里的新情报物。",
      "evidence": [
        "v04-c0241:p0030",
        "v04-c0241:p0044"
      ]
    },
    {
      "paragraph_start": 45,
      "paragraph_end": 55,
      "label": "周吞毒被电封、家属远送补证尚未供暗火死",
      "direction": "周白死目牙微毒被电光封元神止，子女斥背叛长老补儿游长乐女补周婶随，M说涧猜故回禁足拷。周支吾欲供未知正文之前暗火体内瞬灰孟救不及，类似六道M疑不是系统宣布抹或轮回身份证，杀手仍未擒名。",
      "evidence": [
        "v04-c0241:p0045",
        "v04-c0241:p0055"
      ]
    }
  ],
