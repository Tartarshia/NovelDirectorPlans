{
  "schema_version": 1,
  "chapter_id": "v04-c0255",
  "title": "第二百五十五章 失望与希望",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "96880730c48b1c0a7f3d910f6264e78a8af52f4ea8f356118d5f016b9ed207e2",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S28",
  "pov": "强求突破未成的失落、树牌重建感应与齐送孟单独真正入宫",
  "attribution_caution": "突破25止26需两三月估，仍非宗师；15旗确后土云中子仿不杏黄，53鞭暂交不永久。34顾实推门57孟实入，两客未直接描进内。齐袖困后手6/7报告与32宫前证区分，黑袍电弧眸未知不合赤尸影，收药观法仍约定。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 8,
      "label": "大日耗极与过门失落、楚后手留两客",
      "direction": "孟推异宇宙失路、大日至多几十息为自估限，齐在侧安生存却渴宫。再感失败，齐述上次困秦穆助楚得如意今两败俱伤，并新悟楚主动入袖留杨顾，袖鼓困不久未真脱。",
      "evidence": [
        "v04-c0255:p0001",
        "v04-c0255:p0008"
      ]
    },
    {
      "paragraph_start": 9,
      "paragraph_end": 18,
      "label": "试突破得护旗、旗仿名与榜去向未明",
      "direction": "孟据内景世界观提任宇宙可感宫，齐认可可试非保证。挥旗真隔冷咒孟解除大日，问杏黄旗后齐明确是云中子仿后土玄黄旗，真正杏黄祖收回鞭留。封神榜齐称周台后不知被谁盗走，鞭榜控神幻想未实现。",
      "evidence": [
        "v04-c0255:p0009",
        "v04-c0255:p0018"
      ]
    },
    {
      "paragraph_start": 19,
      "paragraph_end": 30,
      "label": "法相异相与强求失败、愧失落转世界诅咒问",
      "direction": "孟法相混沌无上下一点道人，齐惊自语疑元始真身非已确孟法身，姜缺金章法身篇外景仍可艰难证。星闪变化止，孟说还两三月仅估未晋；暴躁深吸转问，齐配说无当圣母洞后易名灭土行孙，残天法身诅咒寿减洞天维护是齐说明非主界普律。",
      "evidence": [
        "v04-c0255:p0019",
        "v04-c0255:p0030"
      ]
    },
    {
      "paragraph_start": 32,
      "paragraph_end": 37,
      "label": "杨顾从呆滞决行、顾推开宫门引诸方",
      "direction": "两客还宫前有直接描支持齐后手推断；杨说先进去、顾无话运功实推365钉门，开见长明灯幽深地火风水躁。秦唐几处洞天帝装强者抬头未具名、非已抵宫或全部法身出场，杨顾已进入脚步未直接描。",
      "evidence": [
        "v04-c0255:p0032",
        "v04-c0255:p0037"
      ]
    },
    {
      "paragraph_start": 39,
      "paragraph_end": 46,
      "label": "失落未排、旧腰牌应门与树触再感",
      "direction": "腰牌震热握映门开但没高处位置，孟失笑仅场景疑异宇宙。实暗握大道树接牌再感高宫、树欲又怯是比拟不口语，非任务结算新道具或树已吞宫。",
      "evidence": [
        "v04-c0255:p0039",
        "v04-c0255:p0046"
      ]
    },
    {
      "paragraph_start": 47,
      "paragraph_end": 55,
      "label": "传音喜感但壁阻、齐仅送一人并交鞭",
      "direction": "孟密传感到，齐旗裹二人试跃被晶壁，只能强打一位、楚快脱齐留缠为其决策未实际后战。莲台真托孟送，53木鞭手中齐交借本次探索不永久售赠、55仅观功法拿不死药是约定未到物。",
      "evidence": [
        "v04-c0255:p0047",
        "v04-c0255:p0055"
      ]
    },
    {
      "paragraph_start": 56,
      "paragraph_end": 61,
      "label": "实际回门踏入快进、未名电弧黑袍尾随",
      "direction": "56宫前再落57实踏入59过灯深入，本章首次孟实际入宫但没突破。争分不缠先取物是方略未已拿。黑袍阴影出现电弧眸悠跟身份未知，不强等赤尸影或古熟人。",
      "evidence": [
        "v04-c0255:p0056",
        "v04-c0255:p0061"
      ]
    }
  ],
