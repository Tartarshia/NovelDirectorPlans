  "title": "第二百六十一章 玉虚异变",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "0857b9811935c7cbcac1e811e77201823ccc4fbb6f2a6444d2b82813b4700fbc",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S30",
  "pov": "宗师领域与双躯试操、宫排返回及双经法身资料、合作补教和镇鞭借限",
  "attribution_caution": "领域真初成但最深7条件；旧地球躯同步宗师元神入返且道一唯独树桃四物转。17双经实收63太乙持确认不倒补257取动作。宫波黑袍躯泥39意念被吞不真主体死确；洞旧身位置未知遥操一次耗大。六道瞒/棋手/合躯是推计划，五印换后未来、袖教获允未已学，长借鞭被拒齐带帮提未轮回同去。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 14,
      "label": "宗师不灭领域形成、两躯同步与棋子疑",
      "direction": "法相法理初融领域真使周力虚、方向时机难判，最深凝时空点只是未来条件。地球躯同步宗师形体内景，生机内藏眼闭非另人格独魂；本尊分辨旧己/附苏子远，如何在宫与棋子为疑。",
      "evidence": [
        "v04-c0261:p0001",
        "v04-c0261:p0014"
      ]
    },
    {
      "paragraph_start": 15,
      "paragraph_end": 28,
      "label": "双经实收、元神试旧身与四物随转、瞒六道计划",
      "direction": "棺两侧氤氲真八九法身篇/金章总纲得，孟探陷收两团，元神入旧身无拒睁动显相真宗师。道一唯独两真意+树+妖桃随元神实转，23治疗隐患担心似解、灰石可瞒推玉虚亦可只是计划。魂回苏身谨慎不永久换躯/真合证唯，留带法犹豫。",
      "evidence": [
        "v04-c0261:p0015",
        "v04-c0261:p0028"
      ]
    },
    {
      "paragraph_start": 29,
      "paragraph_end": 40,
      "label": "黑袍找至门、宫震弹身与排人波、黑袍身肉泥",
      "direction": "黑袍找到口声元磁电遁现铜门殿，宫如感应震棺弹地球躯向孟未接住波排孟。秦穆等被排真实口惊短期开；黑袍躯垮肉泥意念问何物回被波吞，身毁不主体真死确，不证其就是赤或是谁操盘关闭。",
      "evidence": [
        "v04-c0261:p0029",
        "v04-c0261:p0040"
      ]
    },
    {
      "paragraph_start": 42,
      "paragraph_end": 51,
      "label": "临淄回归、旧身未知洞遥坐耗大与下棋推",
      "direction": "孟实回临淄齐静室，旧身感在未知何方洞无魂无念。元神全转试操真令坐起眼浑吃力，耗极大撤停靠洞，非长期自走第二分身任作。瞒六道似可与元始/杨戬棋手为内猜，恐惧后平和取互牵机会。",
      "evidence": [
        "v04-c0261:p0042",
        "v04-c0261:p0051"
      ]
    },
    {
      "paragraph_start": 52,
      "paragraph_end": 61,
      "label": "检金章总纲、八九仅法身前三与杨戬留言",
      "direction": "金章精神探得短文复杂金图，换翻天戊己后总纲五印未来计划未已交换。八九法身前三篇已得，末杨戬意念留学传说先见自我、勿先前人而重复，联陆指导理解。三基础法身招/各兽神变对应招岁月流觞是资料未已掌全部变化。",
      "evidence": [
        "v04-c0261:p0052",
        "v04-c0261:p0061"
      ]
    },
    {
      "paragraph_start": 63,
      "paragraph_end": 69,
      "label": "齐实返回分配补教袖、延借镇鞭拒带帮轮回受限",
      "direction": "齐静室见蟠桃双经元心太乙确此次持有太乙，道一孟内暗爽未公开亮物。齐受心虚拟教袖里补联获孟口接受，尚无实际授/修完；长期借鞭问被镇国不外借拒但齐可带帮提，轮回困难孟内知不同行已落实。不详细移交每物/归还鞭动作补造。",
      "evidence": [
        "v04-c0261:p0063",
        "v04-c0261:p0069"
      ]
    }
  ],
