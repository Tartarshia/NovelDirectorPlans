{
  "schema_version": 1,
  "chapter_id": "v04-c0300",
  "title": "第三百章 路遇",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "89cc4bbcd465f1d1e2642b4e5e33f73a2e717a5f7ab6c79156ce3cd511a8f189",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S39",
  "pov": "漫游道心与海眼路遇、战后草原异事",
  "attribution_caution": "短期道心非圆满、果用孟推未来，寿法身丹仅假设。青怪道未知不我是谁者已证无新对白，海眼未硬潜亦非291同一眼确。云鹤墓见未披露建派未成。邪师徒死整伙未知量、招名未知，哈斯戒杀被追目标未被杀。右手再生无新明确。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 11,
      "label": "离岛漫游、旧果联系推与情绪转短期动力",
      "direction": "3暂缓绝刀等秘密机会不真永弃，返回江东旅。4/5果特联系唤醒抗垂钓/附身、好益是孟推及关键future非果已实发功或全无坏处客观。6/7顾利己相似处境孟分析。9沉悲怒变短期道心动力等不盲，11不能牵亲友决释压非完全解决轮回。",
      "evidence": [
        "v04-c0300:p0001",
        "v04-c0300:p0011"
      ]
    },
    {
      "paragraph_start": 12,
      "paragraph_end": 18,
      "label": "海上高歌、超凡常人价值重构与有情不累",
      "direction": "沧海歌找初江湖洒不抹死师悲史，13渺小体可毁壮阔是体感非实毁海。14心态不当石规律构价值人观，15法身长寿闭关朋友亡是假设未自己法身服丹延寿/友已亡。17欣前辈有情不累庄妻鼓盆典故非前辈在场，全心感开不真造物无远届已能。",
      "evidence": [
        "v04-c0300:p0012",
        "v04-c0300:p0018"
      ]
    },
    {
      "paragraph_start": 19,
      "paragraph_end": 28,
      "label": "青怪袍道士舟掠与旧我是问疑、筋斗追不到",
      "direction": "心灵活泼早察比通常快不晋神境，年轻道虚气无法判强亲和互笑舟中土。24宁台旧口与东阳墨/无忧真武黄泉旧讯对比25/26现神清无自语、孟不敢肯定身份，27追筋斗失踪28猜海底未确认道真进去。",
      "evidence": [
        "v04-c0300:p0019",
        "v04-c0300:p0028"
      ]
    },
    {
      "paragraph_start": 29,
      "paragraph_end": 34,
      "label": "蓝血潜海遗迹海眼精神绞痛、门槛估未进",
      "direction": "深海吐纳困难变蓝血29，30旧烂迹未知连海眼黑旋。31估半法才硬抗或神级避水珠为未来条件不已半法/兑珠，32精神伸海眼绞碎疼是探精神分支不是元神死散。33道士入海眼猜34日后机会探未真穿眼新路确立。",
      "evidence": [
        "v04-c0300:p0029",
        "v04-c0300:p0034"
      ]
    },
    {
      "paragraph_start": 36,
      "paragraph_end": 42,
      "label": "陆守外、云鹤入雪山仙墓后不语与建派拟",
      "direction": "雪山守陵知万象来不刁允进九墓之一陆不能随；小半时云出凝惊所见未说陆不问，别编祖尸大能或第几墓。40云提西域无主绿洲建派好陆随意，41蒙死苏下区域当前无新法身非已建派/所有宇宙西域永无。",
      "evidence": [
        "v04-c0300:p0036",
        "v04-c0300:p0042"
      ]
    },
    {
      "paragraph_start": 44,
      "paragraph_end": 55,
      "label": "金帐混乱杀祖灵与邪徒、孟返北磨砺查失踪",
      "direction": "45大满死古失踪正道外景宗师猎草原强祖灵抢资断未来为实后果非纯正义凯旋，古失踪不古真灵已死。47邪师仪折磨开窍武士死、48刀喉困元神49师死50徒内反讽52认孟53last54孟杀一伙未知总人数刀招名不沾计耗。55返中土来追哈斯戒杀磨砺闻数外景失踪来查，不已寻杀两人/揭异事因。",
      "evidence": [
        "v04-c0300:p0044",
        "v04-c0300:p0055"
      ]
    }
  ],
