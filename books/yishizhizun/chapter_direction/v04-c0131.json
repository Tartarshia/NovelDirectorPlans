  "title": "第一百三十一章 抵天之树",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "c1d5a4e3898bf4c2cfc640abdd418be562531f59e1a2ae22177e4caaed565a76",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S14",
  "pov": "殿内危机、诸界异象、顾与女孩及孟传承体验交叉",
  "attribution_caution": "树路目的地未此章明确；诸界异象不并成孟记忆；神霄示三式与后章四式所得结合复核。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 16,
      "label": "分身识破与遗蜕异动",
      "direction": "玄女困弱分身；遗蜕气息冲乱封界，诸世界牌位庙像反应属于读者视角，孟不能自动知道。诸界唯一是传说说明；玄女压分身返发未必明说完全销毁。",
      "evidence": [
        "v04-c0131:p0001",
        "v04-c0131:p0016"
      ]
    },
    {
      "paragraph_start": 17,
      "paragraph_end": 36,
      "label": "注意转移与触刀",
      "direction": "孟疑顾后手，柳装惊近刀，玄女重遗蜕过暂不能用绝刀，遣应身两宗师补守。遗蜕飞楼阁且阵乱妨挪移，孟趁时间差精神触刀，首次实感悟启动。",
      "evidence": [
        "v04-c0131:p0017",
        "v04-c0131:p0036"
      ]
    },
    {
      "paragraph_start": 38,
      "paragraph_end": 62,
      "label": "女孩混入存在与建树离开",
      "direction": "顾点女孩后脑变其气息，口述流罗余肉体仙灵残念并混入某物，女孩相认顾而顾否认，谜未解。遗蜕遇祥云释仙灵催树，顾借树上云入虚空；女孩崩身灵光遁非彻底死。",
      "evidence": [
        "v04-c0131:p0038",
        "v04-c0131:p0062"
      ]
    },
    {
      "paragraph_start": 64,
      "paragraph_end": 83,
      "label": "神霄三式到霸王截断",
      "direction": "雷痕引雷海，远古雷神示五雷、至阳、阴雷三式，非现实雷神复活。霸王烙印刀光斩演示，宣布六斩，不是孟已修成六招或实体神战。",
      "evidence": [
        "v04-c0131:p0064",
        "v04-c0131:p0083"
      ]
    }
  ],
