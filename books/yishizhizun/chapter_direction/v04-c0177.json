  "title": "第一百七十七章 任务情况",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "efded97f10a708f50833a82753be774e9a35ee42c790976d07480403d3a65e30",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S19",
  "pov": "死亡任务准备开启，重估外物依赖与兑换优先级",
  "attribution_caution": "S19从177任务后一年备战开始；账目分现金实物，报价非全部现金；未来任务未开、借宝未行、齐兑与江酒未执行。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 15,
      "label": "借神兵执念被提醒",
      "direction": "孟估禁秘宝使自己战力折半以上，连续盘借神兵法均是心中设想，未借到阿难刀度人琴。齐仙授长生经为孟所知说法，阮一重，赵受监。江提醒自身武道，孟自省似心魔非真实入魔。",
      "evidence": [
        "v04-c0177:p0001",
        "v04-c0177:p0015"
      ]
    },
    {
      "paragraph_start": 16,
      "paragraph_end": 28,
      "label": "评价抽签与身份保密",
      "direction": "阮赵齐中等各400，江孟良好各600且抽一次，江得吐火纳玄丹留日常未服，孟得清净麻鞋价值1700穿上未卖。孟只暗传阮齐留后，赵未知其仙迹真身，用元始交流是以后计划。",
      "evidence": [
        "v04-c0177:p0016",
        "v04-c0177:p0028"
      ]
    },
    {
      "paragraph_start": 29,
      "paragraph_end": 44,
      "label": "实换战利品及公平感",
      "direction": "六道报价蟒2700小妖450戟1500牛耙1600血角牛黄丹5200皮2600胃藏10000，总24050。特处士牛身份此明确。阮齐各拿两件每1500共6000实物，含公300现金18350分孟江赵4870齐阮1870。孟账12470齐9270；孟惭但江点主材成本同伴认可，不重分备用金。",
      "evidence": [
        "v04-c0177:p0029",
        "v04-c0177:p0044"
      ]
    },
    {
      "paragraph_start": 45,
      "paragraph_end": 54,
      "label": "各付80得阵营死亡详情",
      "direction": "下次杜怀伤十八路共主助义军胜朝主力跨江临都，成功4500更多权限失败抹杀；阵营一流1000绝顶3000宗师6000全阵营收扣，胜另轮回符，末不足抹杀。敌是否同封物未知，疑血海罗刹老祖为担忧非确认法身参战。",
      "evidence": [
        "v04-c0177:p0045",
        "v04-c0177:p0054"
      ]
    },
    {
      "paragraph_start": 55,
      "paragraph_end": 64,
      "label": "决心与两笔实际采购",
      "direction": "阮说再难面对，孟倡筹东极丹材炼两炉尚未做，赵暂把钱用于真龙土等12150，目标近第一梯未成；阮换蜃楼天音石等四件，余390，目标一年外景二重未晋。防具丹兵升级放任务前是安排。",
      "evidence": [
        "v04-c0177:p0055",
        "v04-c0177:p0064"
      ]
    },
    {
      "paragraph_start": 65,
      "paragraph_end": 68,
      "label": "江温养方案与孟犹豫",
      "direction": "齐沉默思兑未下单，江想养剑酒以一年温养近极品白虹再助境，未购酒未立即极品；孟仍犹豫下一步未决。",
      "evidence": [
        "v04-c0177:p0065",
        "v04-c0177:p0068"
      ]
    }
  ],
