  "pov": "散播试探与何暮首日五胜",
  "attribution_caution": "不能把散播疑点说成身份揭穿成功。何目前五胜而次日尚未比，苏真实名榜身份未被何识破。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 16,
      "label": "同伴承担与散播计划",
      "direction": "孟告齐雷传及顾消息，自认连累因表亲可细查，齐认生死交互助允通过半年积累江湖网散单身份消息。孟目标仅引王家疑查逼离再夺石，实力推估非实测，仍不知顾目的。",
      "evidence": [
        "v03-c0074:p0001",
        "v03-c0074:p0016"
      ]
    },
    {
      "paragraph_start": 18,
      "paragraph_end": 35,
      "label": "大比紧张与同门差异",
      "direction": "新年赤阳馆五日赛，何首次紧张同门妒名额，五刺言曲甜荷鼓励，想梅下诗诵逐稳。对白亮结巴评师轻看，不能抹首次怯场。",
      "evidence": [
        "v03-c0074:p0018",
        "v03-c0074:p0035"
      ]
    },
    {
      "paragraph_start": 36,
      "paragraph_end": 55,
      "label": "由迟半拍到故事引敌",
      "direction": "白急求速胜何最初慢险败，连退仍讲故事，见应对落分支才兴奋冷静反转击落剑。评师误好运何此时才知苏真高手，首日另四场渐熟共五胜，次日曹承业初眼内定王氏何仍蓄气小成不自信越阶。",
      "evidence": [
        "v03-c0074:p0036",
        "v03-c0074:p0055"
      ]
    },
    {
      "paragraph_start": 56,
      "paragraph_end": 76,
      "label": "棋盘与跨场布局",
      "direction": "夜谢师孟围棋琢磨奕剑，闻王氏来兴趣，正常对战何无胜算但比武可利用今日谨慎诱敌形象反转为鲁莽迅速。新故事具体招待后文，未写胜果；何产生盲信与自己思考能力并存。",
      "evidence": [
        "v03-c0074:p0056",
        "v03-c0074:p0076"
      ]
    },
    {
      "paragraph_start": 77,
      "paragraph_end": 86,
      "label": "告别姿态及鉴别反讯",
      "direction": "孟让无论胜败勿再来称缘散启程，何怅然；齐问伤感孟坦承要高人风姿，幽默拆表层悲情非断他永无担忧。齐报王夫人暗查单武功无问题非素女，孟惊。",
      "evidence": [
        "v03-c0074:p0077",
        "v03-c0074:p0086"
      ]
    },
    {
      "paragraph_start": 88,
      "paragraph_end": 92,
      "label": "王策与单秀眉登楼",
      "direction": "次日王策歉母多疑讨好，单说铁手引怀疑但清者自清带倔强，策自信她请点评；这是人物陈述非旁白证清白，也不坐实玄女。",
      "evidence": [
        "v03-c0074:p0088",
        "v03-c0074:p0092"
      ]
    }
