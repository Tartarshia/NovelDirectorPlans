  "title": "第二百八十章 准备妥当",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "61c81e3898026248b594d00e6a5f0c1c92239b00e967a1d29acb96af0a24d388",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S34",
  "pov": "莲与鬼门/双针交易、主动直面挑战顾，场外金帐公开冥海目标与明日战",
  "attribution_caution": "莲实握2针交顾鬼门裂主材得，尸物雷毁不魂全灭。后手非无面天门顾供未名，韩47未识为公言非独验。顾准问没给秘、挑战未战；古49新目标供称冥海非天斧不同场孟不知，明日决战计划未开。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 8,
      "label": "莲子实握与自我痕迹沉思、顾识能力问未解",
      "direction": "莲外普通稀种有余温1孟怔花见5握7玩，279交付接持今明。不足信心留念为孟同感推，鱼未来失我非已死。顾静笑沉默7问特殊联系8还是说是吧，识机制未全答。",
      "evidence": [
        "v04-c0280:p0001",
        "v04-c0280:p0008"
      ]
    },
    {
      "paragraph_start": 9,
      "paragraph_end": 16,
      "label": "后手顾否灭门/无面、鬼门主材浮与雷毁尸物",
      "direction": "顾10肯定非无面非天门为角色供述，孟疑神话未定名。裂幽石鬼门顾12认哭神兵主材13末雷毁哭托尸及身兵物，主材勉强残存不新完整神兵或魂全解。孟没抢而感叹旧大敌死、险因果不外言不忽略帮手贡献。",
      "evidence": [
        "v04-c0280:p0009",
        "v04-c0280:p0016"
      ]
    },
    {
      "paragraph_start": 17,
      "paragraph_end": 24,
      "label": "鬼门与双针实际交换、目标回顾与追不及",
      "direction": "顾夸法身外纵横是赞语不任何同阶全胜保证，猜六欲赠针19明确推。孟20本想针射六欲的真实计划新明未用成功，21追首领与老者已不知踪来不及。顾22收针孟24交2收裂鬼门，莲已握、毒针全去孟不射女。",
      "evidence": [
        "v04-c0280:p0017",
        "v04-c0280:p0024"
      ]
    },
    {
      "paragraph_start": 25,
      "paragraph_end": 33,
      "label": "正面挑战顾而不偷袭、清心成长与时间差",
      "direction": "孟高气刀直视26出招、27欲首领秘和金帐暗投消息目的不忘28偷袭能制六七成是自估未行动，主动明战无愧圆满心是成长不已法身。顾调笑孟心波速平31称天母活/强者将至故不今日打32允随问，33孟原想时间差令她保守今怔。未真正顾被打败/已回答秘密。",
      "evidence": [
        "v04-c0280:p0025",
        "v04-c0280:p0033"
      ]
    },
    {
      "paragraph_start": 35,
      "paragraph_end": 45,
      "label": "金帐大满传神消息、战损报告与韩哭死言",
      "direction": "35–38大满带天母消息曝孟假身/托死前只顾、哭戒杀等。只是报告阶段/阵营统计，不真极恶囚魂已死或孟死亡。高层惊七约顶势/联军半成是量级、韩脸难堪似推算42口哭死孟手45惊比苏快均当局反应不是新正式榜单。",
      "evidence": [
        "v04-c0280:p0035",
        "v04-c0280:p0045"
      ]
    },
    {
      "paragraph_start": 46,
      "paragraph_end": 51,
      "label": "古从容任务真目标说法与次日出战计划",
      "direction": "古实际背欢喜菩萨拍手/开全黑眼，46小意思、48说仓促地仙隐患双修和任务闲令49称皓月与天诛无关冥海剑想贪。韩47公开承未识过50表松为言和表态，不独证当时真假全内心。51古明日此时会陆冲是宣计划未已对战，孟不在场不能预知。",
      "evidence": [
        "v04-c0280:p0046",
        "v04-c0280:p0051"
      ]
    }
  ],
