{
  "schema_version": 1,
  "chapter_id": "v04-c0307",
  "title": "第三百零七章 结善缘",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "97ed7ea6b5706d9c8b491ca573e9a9ce8d3ff5697c39dfbff8472d5a91abe6bf",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S39",
  "pov": "赠令结剑庄善缘与林海搜索、敌方棺援反扑",
  "attribution_caution": "令何休实接不仍孟库存；承诺未实援、厚报无金额，神兵即将未成。哈斯伤愈明确不补左臂再生。总叶+13含孟，≥5敌为部族线报。棺帝君未本章真名或抓宗师实祭，幕后孟未知。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 10,
      "label": "深秋林海雪原集结与气势变化",
      "direction": "北地部族与冰寒修士非无人，十来人微浮避泥雪，叶领明法何休。孟缓而不慢到来令较弱宗师眩，众初见评声名叶察自信。叶外另13宗师含孟、总14非13队员外又加孟；未宣孟大宗师突破。",
      "evidence": [
        "v04-c0307:p0001",
        "v04-c0307:p0010"
      ]
    },
    {
      "paragraph_start": 11,
      "paragraph_end": 23,
      "label": "献符令与高死确认、剑庄隐价值",
      "direction": "孟递令给何休，何惊14符藏支脉无名剑经、何七重整助后路，令历代培近神兵未蜕。孟报高死简述弱点何问沾，孟说何须冒同归风险，本章没另杀高/耗沾。剑庄价值不向全宗师同时自动公开。",
      "evidence": [
        "v04-c0307:p0011",
        "v04-c0307:p0023"
      ]
    },
    {
      "paragraph_start": 24,
      "paragraph_end": 35,
      "label": "战绩震动、实交令与善缘承诺",
      "direction": "宗师闻高死忆生擒极恶斩哭，29大宗师感不实际境。何31接令许厚报，孟32为日后人仙援且不强求何七冒险，何33代表宗门应事。援承诺未兑现、资源回报未给、神兵即将非到手，善功不愁概称不新增到账还债。",
      "evidence": [
        "v04-c0307:p0024",
        "v04-c0307:p0035"
      ]
    },
    {
      "paragraph_start": 36,
      "paragraph_end": 47,
      "label": "冰原线索、分组安全与独行获允",
      "direction": "叶报部族发现哈斯等≥5宗师密林不明逃向；崔宗师提两三人组查部族，叶备联络求援防反扑、42孟得其他宗师馈物未名数。孟要独行因秘传必须用又不害队友，八九避阱自信条件法身遮机非绝对保证。叶准、各奔森林，不已搜到敌。",
      "evidence": [
        "v04-c0307:p0036",
        "v04-c0307:p0047"
      ]
    },
    {
      "paragraph_start": 49,
      "paragraph_end": 54,
      "label": "敌方伤愈与血黄棺援手",
      "direction": "另场哈斯明确伤势痊愈、右拳在巨石上，49据说法身寻汗为其消息不新蒙南生还/已有下落，邀反击中原。众看血黄雾棺，哈谢帝君，棺暗哑声要求鲜活宗师肉身助本门绝顶越第二梯，是动机合作未已抓/祭/越阶。帝君真名本章未给、孟未听。",
      "evidence": [
        "v04-c0307:p0049",
        "v04-c0307:p0054"
      ]
    }
  ],
