{
  "schema_version": 1,
  "chapter_id": "v04-c0128",
  "title": "第一百二十八章 过险境如平地",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "9536c76e6c9b2c98ff805d5e474189b5c679dab8a3765db8d383476f3cf02e27",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S14",
  "pov": "孟本体与分身双线；婴宁内心独立揭露",
  "attribution_caution": "鸟、水、侍女均属分身线，本体郭喜仍随顾；分身实力限制下章才明确。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 8,
      "label": "仙界环境",
      "direction": "元气法理变化可感，一口延寿十年是夸赞传闻；修炼感舒畅不等真实升级。",
      "evidence": [
        "v04-c0128:p0001",
        "v04-c0128:p0008"
      ]
    },
    {
      "paragraph_start": 9,
      "paragraph_end": 22,
      "label": "落发与仙禽伪装",
      "direction": "本体随顾前行，分身化普通鸟改形势假仙禽跟怜欲婴宁。婴内心揭姹女欢喜禅控制炉鼎图谋、尚待踏外景，不把这些自动赋予孟知情。当前九变不含仙禽大种。",
      "evidence": [
        "v04-c0128:p0009",
        "v04-c0128:p0022"
      ]
    },
    {
      "paragraph_start": 23,
      "paragraph_end": 31,
      "label": "化水潜行险遭吞饮",
      "direction": "分身借河水与鱼形潜往镜言；本章蓝血五成像且缺精髓，不把此前不到八成硬并精确进步。宠兽饮水迫其改鱼，体现仍有风险。",
      "evidence": [
        "v04-c0128:p0023",
        "v04-c0128:p0031"
      ]
    },
    {
      "paragraph_start": 33,
      "paragraph_end": 48,
      "label": "本体殿候与暗问",
      "direction": "顾商水对男弟子承诺观刀可成核心是招徕说法，牵孟手为公开伪装。私传问分身是否到；孟回答未明传音暂留疑问。侍女引众依次去，孟尚候。",
      "evidence": [
        "v04-c0128:p0033",
        "v04-c0128:p0048"
      ]
    },
    {
      "paragraph_start": 50,
      "paragraph_end": 60,
      "label": "分身骗开禁法",
      "direction": "孟分身打晕侍女藏起、冒其声假宗主召镜言。镜言展开感知令禁法半开，分身掌刀紫电破法；不是本尊现身。关于镜言无真情是此段判断，不做恋情全知扩展。",
      "evidence": [
        "v04-c0128:p0050",
        "v04-c0128:p0060"
      ]
    }
  ],
