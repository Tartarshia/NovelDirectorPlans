{
  "schema_version": 1,
  "chapter_id": "v04-c0294",
  "title": "第二百九十四章 天榜和地榜更新",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "788e6e50528fc185682dbda68dcc32f0818e0c6a517f6d05c910689bc90e6b32",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S37",
  "pov": "新拟榜的社会位置与孟消息引段瑞",
  "attribution_caution": "新榜记录排定但本章无街头贴榜或孟获名次镜头；高兵地仙非本体正式地仙。密报安然与亲叙全复不同。大离源名异记不造新角色，崔清羽继剑非死崔清河。王借段开门/纸条发者与冯掠性质、遮者皆未证，引段舆情已发信息但人未出。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 10,
      "label": "崔死后晋皇监管放松、秦王与四半法候选",
      "direction": "匿名掌榜金章问政治，司马崔死皇族幸不幸，宗派无晋周分苏不易插手为分析。秦王赵警世旧败魔师皇陵30破心第三梯，得放监管炼民望十年法身有希望非已晋；四候选阮失锐司马因积薄司马石寒微换功隐患明确资料，非每世族巅峰都已半法。",
      "evidence": [
        "v04-c0294:p0001",
        "v04-c0294:p0010"
      ]
    },
    {
      "paragraph_start": 11,
      "paragraph_end": 21,
      "label": "陆一高二新天榜与孟特征密报、皇兵地仙非皇身",
      "direction": "司马重拟陆地仙传说特征一、金章初问；孟密探特提稳定天下目的司马识。高二疯皇、剑醒地仙斩大满八成功为司马判断，众生体更进地仙有望非高已地仙体。苏攻无地仙兵力、榜兼看战绩境距非纯胜数。",
      "evidence": [
        "v04-c0294:p0011",
        "v04-c0294:p0021"
      ]
    },
    {
      "paragraph_start": 22,
      "paragraph_end": 34,
      "label": "纳妖入榜太离三苏四韩五及六至十",
      "direction": "妖榜为安人心，23原文大离保存疑名对应太离不造新妖，枪地仙评三。古残灵斧失踪不上，苏传说无处4、可胜二三但无实对战暂排；韩神话天帝净土收获5孟要求加司马不懂寺密探没回。法王6何7白泽8云9罗10，排名语义不等所有人境阶新晋/所有消息已街头发布。",
      "evidence": [
        "v04-c0294:p0022",
        "v04-c0294:p0034"
      ]
    },
    {
      "paragraph_start": 35,
      "paragraph_end": 45,
      "label": "地榜守静一叶13崔23孟24、密报安然与半法后宗师跨度",
      "direction": "金章记变化叶第三梯、南宫峰、李掌剑孟顾宗师皆既往，重拟守1夏侯2活佛3幽冥4玄5、叶13王之下、崔清羽至戈23不亡崔清河同人，孟24奉典之前。42楼密探闯三准法兵高手宗队擒哈斯报告，有人北归哈斯伤而孟无恙为外观非新全治源，43极恶擒旧；金章震四年先开窍，孟未现场知新榜。",
      "evidence": [
        "v04-c0294:p0035",
        "v04-c0294:p0045"
      ]
    },
    {
      "paragraph_start": 47,
      "paragraph_end": 50,
      "label": "孟江东长川寻段失败、入广陵借净土舆情诱线索",
      "direction": "仙迹转江东长川得冯早被段掠几年未归，强制/私奔和幕后遮者身份未给，下落推被高人遮。广陵纸条旧言王去少林门、孟猜段发条且王用他开门未证。50实际给六门消息让净土人人知引段觉得可居而出，计划未段已响应找到/开封验证。",
      "evidence": [
        "v04-c0294:p0047",
        "v04-c0294:p0050"
      ]
    }
  ],
