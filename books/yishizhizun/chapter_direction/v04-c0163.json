{
  "schema_version": 1,
  "chapter_id": "v04-c0163",
  "title": "第一百六十三章 鉴定",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "926d27d0e64dc61fc87e1822a1c18c06df63832b17f50e89e0a1d0a2acb8319f",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S16",
  "pov": "回仙迹鉴树、共享协议与战利品分配",
  "attribution_caution": "已取丹与剑分开库存，树暂存不等永久转让；共享换招同意不等招式已练成；旧雷神因果不重启。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 22,
      "label": "安全复盘与树无咒疑问",
      "direction": "回碧游宫放松。江猜真武难施咒、冲和猜树吸咒均未证；孟补自己先重真假价值略查咒，知解法非全无警觉。江述祖师笔记多人入最低实力者出是家传记录。两地仙内讧与雷神传人仍三人讨论判断；决定留曹口信未获答。",
      "evidence": [
        "v04-c0163:p0001",
        "v04-c0163:p0022"
      ]
    },
    {
      "paragraph_start": 23,
      "paragraph_end": 35,
      "label": "六道有限鉴定",
      "direction": "孟认任务支线物六道可能已知、送鉴兼试底细，非相信六道无风险。六道只报大道之树、承第五道传寰宇，不报价不详用途。孟宇宙猜未出口，冲和也不知实质；真武生存与长存出岔仍推测。",
      "evidence": [
        "v04-c0163:p0023",
        "v04-c0163:p0035"
      ]
    },
    {
      "paragraph_start": 36,
      "paragraph_end": 41,
      "label": "共享换招与暂存",
      "direction": "孟以仙迹成员悟第五机会换万物返虚获同意，未展示领取或修成。树所有权归孟、暂留仙迹供悟，拟西游前取；注气无反应，不能视已可用神兵。冲和答封禁防贪，未地仙突破。",
      "evidence": [
        "v04-c0163:p0036",
        "v04-c0163:p0041"
      ]
    },
    {
      "paragraph_start": 42,
      "paragraph_end": 58,
      "label": "公平分配与江自主",
      "direction": "孟让出力大天尊先挑，冲和验玄冥造化丹一粒确认、取丹不再拿，未服。江取天河剑拟拆升白虹未执行，坚持不多拿免愧，孟尊重；不写江已生心魔。",
      "evidence": [
        "v04-c0163:p0042",
        "v04-c0163:p0058"
      ]
    },
    {
      "paragraph_start": 59,
      "paragraph_end": 61,
      "label": "孟留四物与炼神兵设想",
      "direction": "孟得玄龟剑破空符及两主材，大道树所有权仍己。其余物拟鉴未有新结果，定海珠配大日刀、黄泉骨配冰晶剑只是设想，任务未做骨仍牵生死无常宗，无已炼神兵。",
      "evidence": [
        "v04-c0163:p0059",
        "v04-c0163:p0061"
      ]
    }
  ],
