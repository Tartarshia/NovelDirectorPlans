{
  "schema_version": 1,
  "chapter_id": "v04-c0190",
  "title": "第一百九十章 心思难测",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "c34765b5bf784a3bf16e8e7a8a010b1954fb1b88fbe0d6abacd0eae45fb063d4",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S19",
  "pov": "雷路借痕通行、追敌法身与引开法王的坦言",
  "attribution_caution": "神兵雷池古史来自顾，霸王境界孟猜。法身第二追者孟陌生读者高览不可混。法王实际拦战未报胜负，主材未用，顾引开法王的目的不补为全盘动机已尽。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 14,
      "label": "规律避龙已通过剐龙",
      "direction": "孟内景压非变种可免，自衍需法身非已成。虚龙为无智残怨精气按规律，孟顾算隙躲不触，顾更从容缘由孟猜。实脱剐龙见雷火混洞三路及斩妖铡魔，猴史联想属孟前世。",
      "evidence": [
        "v04-c0190:p0001",
        "v04-c0190:p0014"
      ]
    },
    {
      "paragraph_start": 16,
      "paragraph_end": 25,
      "label": "羲宗师北斗绝顶但拒骚扰",
      "direction": "北斗担心两一步登天宝物，羲实际已二梯宗师、北斗绝顶杀生剑层明。北斗欲拖不杀，羲连骚扰也劝别等天帝实入门，未已攻击或遭反杀。",
      "evidence": [
        "v04-c0190:p0016",
        "v04-c0190:p0025"
      ]
    },
    {
      "paragraph_start": 27,
      "paragraph_end": 31,
      "label": "韩高读刻字入园",
      "direction": "韩帝面具高无五官面具实入，韩读羲字行，高见寿星头空。韩肯效忠能做允许手下秘密，羲秘密未揭。",
      "evidence": [
        "v04-c0190:p0027",
        "v04-c0190:p0031"
      ]
    },
    {
      "paragraph_start": 33,
      "paragraph_end": 57,
      "label": "分身试雷路、天诛斧与雷池说",
      "direction": "孟未见猴痕自嘲，树轻异未吞。顾指雷路孟激痕雷退、拔发分身实际试后入，顾解释刑罚源天诛斧飞去、古尔多仅微醒、雷池应旧纪元；均口述，孟霸王最多初传说推论非定案。疑顾不停讲秘闻另图，未取谪仙池水。",
      "evidence": [
        "v04-c0190:p0033",
        "v04-c0190:p0057"
      ]
    },
    {
      "paragraph_start": 58,
      "paragraph_end": 67,
      "label": "三法身拦截实战与加速",
      "direction": "两追法身孟认韩另一不认，读者高已知。顾背虚影渡世法王现后拦韩高喊先取宝，巨响实际战起孟顾加速离，主材不使用、若没场地需用是孟假设。",
      "evidence": [
        "v04-c0190:p0058",
        "v04-c0190:p0067"
      ]
    },
    {
      "paragraph_start": 68,
      "paragraph_end": 73,
      "label": "顾原预计太离且引开己方法王",
      "direction": "顾说预太离但来陌生法身无关紧要、刑场可暂挡，并称引开法王好双归。是本人布局陈述未最终成功保证，不记法王被杀、夫妻已婚或已取宝归家。",
      "evidence": [
        "v04-c0190:p0068",
        "v04-c0190:p0073"
      ]
    }
  ],
