{
  "schema_version": 1,
  "chapter_id": "v04-c0212",
  "title": "第二百一十二章 再返永生谷",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "7805391c860f46f954ed9cb4254f3b4dde7dd589e2148dc645ecaa71de1ffbeb",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S20",
  "pov": "转世自我耗损口述、瞒宋回谷开水面，宋吸血升势本源未明",
  "attribution_caution": "公开族史与私传秘密、孟推理分层；宋青烟难醒而后现吸血不能先命名血海罗刹或断其永无伤。万虫十棒只是命令，入口消失确证但空间性质还未知。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 24,
      "label": "脱围复盘与公开的转世限制",
      "direction": "半盏远长蛇孟反思若三联加人兽则危险，硬抗兽神不等可硬抗血婴枯骨。小如公开说永生并非真永生，每转削认同次数今四五旧十五六、境界上限降且无族法身为其族史口述；孟以过去殿残声联魂替换寿元蟠桃皆推。",
      "evidence": [
        "v04-c0212:p0001",
        "v04-c0212:p0024"
      ]
    },
    {
      "paragraph_start": 25,
      "paragraph_end": 43,
      "label": "私下真秘密与宋可疑，公开宣离南荒",
      "direction": "小如传音称公开不是最大秘密仅掩师父，真正有不受谷毁影响的神奇处、谷特性散气为她说法，要求瞒宋因其三重多年未伤且来谷过顺是她观察。孟猜宋问题，向宋说仇罗刹需离南荒未实际回晋。",
      "evidence": [
        "v04-c0212:p0025",
        "v04-c0212:p0043"
      ]
    },
    {
      "paragraph_start": 44,
      "paragraph_end": 49,
      "label": "夜洞青烟让宋难醒，二人决定回谷",
      "direction": "孟混天机远遁夜洞休养、拟次晨分道未实际走完。小如青烟鼻入宋仍入定难醒，她称族秘法多，孟起说现在回谷。无确毒死、搜魂或全知师父真身份。",
      "evidence": [
        "v04-c0212:p0044",
        "v04-c0212:p0049"
      ]
    },
    {
      "paragraph_start": 51,
      "paragraph_end": 54,
      "label": "万虫另线责退二魔，罚令未执行展示",
      "direction": "万虫看血婴枯骨，二者怕震怒却令下去领十抽魂棒，二人松气退出不解宽容；未当场棒刑、击杀、和解或孟知其私事。",
      "evidence": [
        "v04-c0212:p0051",
        "v04-c0212:p0054"
      ]
    },
    {
      "paragraph_start": 56,
      "paragraph_end": 61,
      "label": "实际重返谷，秘密地方口述与辅助法",
      "direction": "孟小如月夜已到旧埋地，小如说罗刹应不知可秘法瞒魂若无叛徒为判断，不确罗刹无所知。两人盘坐她实教辅法传音双法找水面，未再下葬真死。",
      "evidence": [
        "v04-c0212:p0056",
        "v04-c0212:p0061"
      ]
    },
    {
      "paragraph_start": 62,
      "paragraph_end": 68,
      "label": "孟换鱼视角往上找到水面，两人消失",
      "direction": "孟见地球旧景原找不到，念自己鱼向上差点触旧金片感静谧虚无水面，存想推手亮处扩大。血衣为何不禁谷为疑，二投身消失原地，内部地点本章未揭。",
      "evidence": [
        "v04-c0212:p0062",
        "v04-c0212:p0068"
      ]
    },
    {
      "paragraph_start": 69,
      "paragraph_end": 73,
      "label": "宋随后现身血色活入体，身份未揭",
      "direction": "表象宋人影普通、不再猥笑轻咳原来这样，谷血滴出涌入其身地恢复常色，气升瞳血。未定真实本源、确切境界、蛊神或罗刹身份，孟小如已消失未旁观。",
      "evidence": [
        "v04-c0212:p0069",
        "v04-c0212:p0073"
      ]
    }
  ],
