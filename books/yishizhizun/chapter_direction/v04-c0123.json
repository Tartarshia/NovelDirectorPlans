  "title": "第一百二十三章 离华初闻",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "d37ae1f9268406358b2e482aae39397aa4a696f7533ca06641a276809d046c60",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S14",
  "pov": "孟奇有限观察与内心；乐环、婴宁解释不自动成为全知事实",
  "attribution_caution": "叙述所见、乐环婴宁口述与孟推断分开；亲近场面只保留剥削结构和角色反应，未正式入门。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 14,
      "label": "接引与街市",
      "direction": "乐环自称普通弟子，婴宁主动攀谈；港口开放与孟预想相反。街上废弃炉鼎乞求亲近，乐环解释等级沦落，孟以成瘾理解，外态仍老魔沉稳。",
      "evidence": [
        "v04-c0123:p0001",
        "v04-c0123:p0014"
      ]
    },
    {
      "paragraph_start": 15,
      "paragraph_end": 38,
      "label": "慈悲说辞与采补现实",
      "direction": "乐环对伤者的怜悯导向亲近及采补，又替其正骨；以人物价值冲突和孟内心错愕呈现，不扩写性细节。婴宁声称只施不取会反噬是门内解释，不作医学事实；孟维持冷淡催行。",
      "evidence": [
        "v04-c0123:p0015",
        "v04-c0123:p0038"
      ]
    },
    {
      "paragraph_start": 39,
      "paragraph_end": 46,
      "label": "勘阵修正与潜入设想",
      "direction": "孟感知藏杀阵，推翻只防外敌说法；药渣离开懒阻为推测。计划让毒手合理消失、冒充有望观刀男弟子，须避采补及临行监视。两脉同驻使其猜入口，尚未证实。",
      "evidence": [
        "v04-c0123:p0039",
        "v04-c0123:p0046"
      ]
    },
    {
      "paragraph_start": 47,
      "paragraph_end": 58,
      "label": "李文定与旧识危机",
      "direction": "三眼箭神确认为失踪名手，旧三重现根基毁，从大补降零嘴的原因由乐环讲述。怜欲称毒手旧识，孟暗捏轮回符而非已逃；压在身份信息缺口收尾。",
      "evidence": [
        "v04-c0123:p0047",
        "v04-c0123:p0058"
      ]
    }
  ],
