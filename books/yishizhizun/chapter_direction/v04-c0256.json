  "title": "第二百五十六章 杀人重过取宝",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "9d5130c53e18c182394283d03b3cd6ee44ba2c3bd9179a71d20fbf35dff5dfa1",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S28",
  "pov": "宫内禁法解路、两宗师杀阵与借鞭重伤遁逃、墙诵成长知识及陆压线索",
  "attribution_caution": "开天破廊实，20杨顾双宗师、顾23首次口令。鞭金身真催扇39确认法宝神兵，伤杨未死、肩胸肉泥袍破；46耗地磁符非新破空。61各类药各一未具体名字，东极253备用1与50祈求同类续账待核。墙诵非神兽在场、未晋未学全36；黑袍65说陆压元始镇压属其话未合身份。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 15,
      "label": "无水平湖回廊陷原地、冷静识元始禁法",
      "direction": "宫入口柱灯大殿后无水深湖回廊，不能擅证真九幽；不离廊飞，重复无参照令猜路，心映多法仍原地。深吸压焦躁转思元始无前后上下，推禁法应如此而非空间早知解。",
      "evidence": [
        "v04-c0256:p0001",
        "v04-c0256:p0015"
      ]
    },
    {
      "paragraph_start": 16,
      "paragraph_end": 21,
      "label": "实际开天裂虚、顾杨两宗师堵殿门",
      "direction": "长刀开天分阴阳实裂湖廊见玄黄殿、纵裂尚未投入，殿门双宗师20明确境。顾玉白手肤灰黑杨寒剑绛袍，等堵杀而非取宝孟惊后面可能法身来是推。",
      "evidence": [
        "v04-c0256:p0016",
        "v04-c0256:p0021"
      ]
    },
    {
      "paragraph_start": 22,
      "paragraph_end": 34,
      "label": "顾宣师令真正翻天、杨神兵扇夹杀",
      "direction": "顾首次木讷实说师令杀更过取宝，真领域翻天引缩束孟不可躲。孟法天实破部分枷锁尚重、挥刀剑开天返虚欲硬碰；杨羽扇神兵见危五火七禽先疑后36/39名确认。杀阵一压一锁是M识，不已经叫齐帮回场。",
      "evidence": [
        "v04-c0256:p0022",
        "v04-c0256:p0034"
      ]
    },
    {
      "paragraph_start": 35,
      "paragraph_end": 45,
      "label": "实催打神鞭伤杨、顾掌肉泥代价与借力冲门",
      "direction": "背出两臂未写第二头，真元催借鞭定灭扇焰杨飞血未死；神宝无榜对他族普通神兵、法宝扇非近战为叙说明。顾掌来刀剑小牵玄磁最后真催偏面，左肩脖胸肉泥袍部分碎，非八九免伤。孟不死借些力量越杨冲殿近虚脱。",
      "evidence": [
        "v04-c0256:p0035",
        "v04-c0256:p0045"
      ]
    },
    {
      "paragraph_start": 46,
      "paragraph_end": 48,
      "label": "地磁遁符实烧逃感、杨服丹收残肉追杀",
      "direction": "用最后力实烧地磁元光遁篆加速贴地消顾感，不7300破空/轮回符。顾停看师妹杨服一粒未知药、收败精血肉仍谋追，未明确咒术已成/恢复满/死人复活。",
      "evidence": [
        "v04-c0256:p0046",
        "v04-c0256:p0048"
      ]
    },
    {
      "paragraph_start": 50,
      "paragraph_end": 61,
      "label": "遁落静室墙诵、变化知识惊喜与各类药服",
      "direction": "孟抽空祈别禁最好丹房为希望非已找到，画眉赤药需一两时辰自估；遁力消实落。墙多音念相柳烛阴毕方知识非妖现场，无头主体身份。18种属36起个别兽神，知道特征助以后不是现在突破或全36学成。静室是否八九修地是疑，拿丹各种各吞一未具体药名，未立即全愈。",
      "evidence": [
        "v04-c0256:p0050",
        "v04-c0256:p0061"
      ]
    },
    {
      "paragraph_start": 63,
      "paragraph_end": 65,
      "label": "双宗师追去、黑袍实低语陆压与镇压说法",
      "direction": "双宗师追离殿，黑袍出晦影看方向沧桑淡漠首次有话，指陆压坏其事、元始镇压心难平为其说法。陆压仅被提未亲临；师令和话可关联待核，师父不已正式确名；黑袍不自动并赤尸影或熟神。",
      "evidence": [
        "v04-c0256:p0063",
        "v04-c0256:p0065"
      ]
    }
  ],
