{
  "schema_version": 1,
  "chapter_id": "v04-c0271",
  "title": "第二百七十一章 “调查团”成员",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "88f57658470664fd4b0f30e4714f1487297cbdc1571293f78a941423ec6428ee",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S33",
  "pov": "杀狼调查团与资源情报详化、顾心魔正视及风险阈值撤离决定",
  "attribution_caution": "调查团资料韩供未全部现场集结，斧皓月联系仅可能，叶秘半步非法身；小幡极品定名环已查未新售，令牌不赐39内未露轮回；顾无生疑似、活死人宗师效非半法真人，任务口接风险撤决未实际出。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 19,
      "label": "皓月戒杀旧缘、草原战力与天诛来历可能",
      "direction": "萨仁高娃即戒杀养狼救孟又杀孟祭狼旧恩仇，未现身。韩3解释古气牵孟首次听；金帐18/长生22宗师不同地榜半法18，乌力罕寿尽半法旧最高3、叶秘半法新明非法身。韩10–19古忌长生和萨满阻、斧出现于覆皓月后只可能不可定夺斧秘法真实。",
      "evidence": [
        "v04-c0271:p0001",
        "v04-c0271:p0019"
      ]
    },
    {
      "paragraph_start": 20,
      "paragraph_end": 26,
      "label": "秘目标重排、顾心魔直面与实际口答任务",
      "direction": "孟看影响斧或可挫古优先于内应为策略推，顾可能抓问未执行。21–25反思旧弱势成长成心灵漏洞、需常拂想面对胜她非已胜/突破法身。26实际答竭力询成员，角色接任务不等真正同意杀所有正邪同行必执行。",
      "evidence": [
        "v04-c0271:p0020",
        "v04-c0271:p0026"
      ]
    },
    {
      "paragraph_start": 27,
      "paragraph_end": 37,
      "label": "调查团韩点评与萨满体系、派别和榜名",
      "direction": "顾和八重陶格斯领，邪欲七重弱、托娅借天母约七八、六欲巅黑13地58最难、王万未知夜离。欢喜庙欢喜真佛不素女欢喜菩萨，源35邪异/29邪欲异字同角色保源。长生天法身神三次香火再生非三个人仙参战。神灵与祭司概述非本章全部到场。",
      "evidence": [
        "v04-c0271:p0027",
        "v04-c0271:p0037"
      ]
    },
    {
      "paragraph_start": 38,
      "paragraph_end": 48,
      "label": "令牌未赐、环物已查小幡定名与活死人、无生疑",
      "direction": "韩说令牌给无面无新赐，39孟想不能拿会暴轮回整段未口泄。40检查极恶环现物、幡极品韩炼另袍手上品，无新售/销毁邪宝；生死余宗主半法两宗师及阵韩口、宗师级活死人半法躯制非活半法。幽冥地5黑1历史资料，无生疑似韩判断，幡嘱护未实际催。",
      "evidence": [
        "v04-c0271:p0038",
        "v04-c0271:p0048"
      ]
    },
    {
      "paragraph_start": 49,
      "paragraph_end": 52,
      "label": "韩离、两次面法身风险累积触撤离底线",
      "direction": "孟虽看未被发现不证韩真没疑，第二次无备面审叠加风险超过必须撤边界；52此次离开不能回来是决策尚未撤、未断潜伏身份已被揭。",
      "evidence": [
        "v04-c0271:p0049",
        "v04-c0271:p0052"
      ]
    }
  ],
