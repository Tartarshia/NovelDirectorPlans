{
  "schema_version": 1,
  "chapter_id": "v04-c0273",
  "title": "第二百七十三章 内讧团",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "fab3223342d7cf1d8b97477f666a866f13eb8d1d4ebb23d19db2dddf32a49b53",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S33",
  "pov": "陶为主夹邪欲临死焦点，实际自爆陨落、读心指控与两路内斗开场",
  "attribution_caution": "邪欲死亡已明，飞廉半法躯自爆不半法活人；黑幡现实际防爆，不护元神早催回填。唤尸责任互指、顾仅认推波；六欲读心公开供述非孟本人内证，顾不可读不证有罪，托如意咒陶辨但否认、意图生擒未成。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 8,
      "label": "邪欲自救被卡与半法尸躯实际自爆",
      "direction": "陶判断轻易失控不合理，转邪欲感应无人援手及愤怒后冷静遁逃；七品莲台与遁术已用却卡原地。飞廉解脱目膨胀半法躯自爆声轰隆为非言语。别预先认控制者。",
      "evidence": [
        "v04-c0273:p0001",
        "v04-c0273:p0008"
      ]
    },
    {
      "paragraph_start": 9,
      "paragraph_end": 14,
      "label": "陶瞬移避锋、众防限爆与邪欲死亡",
      "direction": "先白光火浪后声、陶挪帐外。六欲等各抵、假极恶实持黑幡浊浪，顾莲及托竖眼神影；爆被限制仅狂风飞帐，非整部灭绝。邪欲碎尸残怨明确陨落，两裂宝兵短剑/莲残无拾取，首领结局没交代。",
      "evidence": [
        "v04-c0273:p0009",
        "v04-c0273:p0014"
      ]
    },
    {
      "paragraph_start": 15,
      "paragraph_end": 24,
      "label": "顾先指极恶与反指、遮危迹象和唤尸互责",
      "direction": "顾公开疑极恶相隔近，孟假身口反指顾离开。六欲危感蒙蔽推、陶回忆诀认顾，顾认见机会推波助澜却指六欲佛门唤尸，六欲以真空家乡反指顾；遮危险与唤飞廉别合成顾已承全部控制。",
      "evidence": [
        "v04-c0273:p0015",
        "v04-c0273:p0024"
      ]
    },
    {
      "paragraph_start": 25,
      "paragraph_end": 34,
      "label": "六欲转述极恶心理、顾凝心不可读与杀意",
      "direction": "六欲口述极恶十有八九顾/不论真假先拿顾为其说法，陶见假身脸变；不内心另给真孟直接旁白认证读心绝对准确。顾笑含森杀与他反驳。六欲自述听不到顾一念不起，却以心怀鬼胎解释只是指控；托口提拳脚。",
      "evidence": [
        "v04-c0273:p0025",
        "v04-c0273:p0034"
      ]
    },
    {
      "paragraph_start": 35,
      "paragraph_end": 44,
      "label": "六欲转指托、如意神咒辨认与生擒强迫意图",
      "direction": "六欲看托惹羞恨非实际触摸。称托庆嘲、秘法不能隔与邪欲遁失败五六成估，陶喊如意神咒并认其功理；托反指六欲觊觎可撒谎。六欲说读心只是辅助又求生擒托把玩，不已捕或已性侵。",
      "evidence": [
        "v04-c0273:p0035",
        "v04-c0273:p0044"
      ]
    },
    {
      "paragraph_start": 45,
      "paragraph_end": 48,
      "label": "陶突攻托与六欲假极恶同时攻顾",
      "direction": "陶瞬移托背刀闪无额外异象，意在重伤、旧萨满怨加怒先动。另一边六欲/假极恶同时攻顾为真实出手，未已重伤/捕托/擒顾或交代胜负。调查首领供词/皓月秘密仍未得披露。",
      "evidence": [
        "v04-c0273:p0045",
        "v04-c0273:p0048"
      ]
    }
  ],
