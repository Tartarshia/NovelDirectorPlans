  "chapter_id": "v04-c0276",
  "title": "第二百七十六章 六欲之死",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "e55c5301dd6c59446ab8b0c0ddef5bf17512730981b9e79ab54f2f199b28d9cf",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S33",
  "pov": "孟真身逃试与顾反水识己，戒杀怪物剑屠场哭老人合围、六欲怨灵结局",
  "attribution_caution": "元心挑内讧今实明不此前每次心软因果全证；戒杀百里屠灭真实非域幻、内怪物借力身份不明。六欲实死魂化怨灵，顾传心心魔解释有源；发分身断非本尊死，顾识孟明但腹血骨设局说法别怀孕认证，旧语回忆非新声。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 10,
      "label": "戒杀等候危险真感、孟本尊换发分身欲逃与内应推",
      "direction": "1承接275末同一句别连续重说两次。2孟假极恶竭力用元心挑内讧今明，八九危险真实涌。宗师散沙3–5类比内评，6头发分身替位本尊实际遁试未成功，7顾自保宽慰8–10推为何敢无惧法身需内应，尚未独证谁。",
      "evidence": [
        "v04-c0276:p0001",
        "v04-c0276:p0010"
      ]
    },
    {
      "paragraph_start": 11,
      "paragraph_end": 20,
      "label": "半空咒与怪物借力怪剑、百多里屠灭",
      "direction": "12–14戒杀起术半空呢喃未明嘴诵声态；窍幽光聚三尺三寸三分怪剑无额外法相，借怪物力量非本体身份全揭。草湖鱼死裂至葛根高勒海拉苏牧民武者牛马倒百多里死寂真实灾害，不幻象。19剑呜非人语、孟本尊亦晕观佛才缓。",
      "evidence": [
        "v04-c0276:p0011",
        "v04-c0276:p0020"
      ]
    },
    {
      "paragraph_start": 21,
      "paragraph_end": 28,
      "label": "沙化怨风、哭老人实拦孟与仇家联手疑",
      "direction": "孟评戒杀可能地榜前40非正式榜，源文字所风而散保疑。沙化湖降死人阴魂归风，哭老人黑7地33实在背后，外貌重瞳白袍黑巾。孟本尊未逃被截改两侧，针对己与预演仅猜。",
      "evidence": [
        "v04-c0276:p0021",
        "v04-c0276:p0028"
      ]
    },
    {
      "paragraph_start": 29,
      "paragraph_end": 38,
      "label": "六欲欲领域神足图逃、顾诱欲暂迷与哭掌杀机",
      "direction": "六欲最先恢复、熟哭相同巅峰战力可逃/联四胜为其推。粉莲双修影为法相历采补具象不现场性交。哭掌黑气被挡，顾似助却魅笑令六欲压欲爆、35未真正走火但短迷，36我要她为内念，哭趁迷掌破光。",
      "evidence": [
        "v04-c0276:p0029",
        "v04-c0276:p0038"
      ]
    },
    {
      "paragraph_start": 39,
      "paragraph_end": 51,
      "label": "发分身被斩、顾凝空挡真身与刀剑抵袭",
      "direction": "39发分身断真身临出又困40/41虚空印顾问为孟推；天之伤挡掌右麻壁塌跌、流火被幽指吸摄、入微变加八九减力50没有事情非重伤。51顾冷杀身影未让孟死/已出谷；两针仍未射幡资源无新售耗。",
      "evidence": [
        "v04-c0276:p0039",
        "v04-c0276:p0051"
      ]
    },
    {
      "paragraph_start": 52,
      "paragraph_end": 56,
      "label": "六欲实死亡元神怨灵与顾传心解释心魔",
      "direction": "哭掌击额肉枯沙元神吸，顾声入其神55称相公勾陶残执刀伤令心失守种心魔如今利用，是顾解释/同274实际刀伤相承，不把所有操控特例早偷成已明。56六欲疑相公心魔后元神变哭最强怨灵，不完全魂湮灭或自由存活。",
      "evidence": [
        "v04-c0276:p0052",
        "v04-c0276:p0056"
      ]
    },
    {
      "paragraph_start": 57,
      "paragraph_end": 66,
      "label": "孟确认顾识己、旧威胁回忆与怀孕暗示未信",
      "direction": "57确认真顾58回忆上次告别警告声音不是本章新口，60/61顾口说特殊/因果/血骨摸平腹62孟差点信，不确胎儿已成或真实婚姻。63顾称针对孟原拟散秘引战争无法身时侠义来，64求让杀65/66孟推金帐早认可直接抓却绕的矛盾，韩是否识/斧秘真假/心魔完整法术仍未解。",
      "evidence": [
        "v04-c0276:p0057",
        "v04-c0276:p0066"
      ]
    }
  ],
