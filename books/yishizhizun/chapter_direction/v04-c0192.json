{
  "schema_version": 1,
  "chapter_id": "v04-c0192",
  "title": "第一百九十二章 杀开道路",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "cfa63147403acfd93ba87f02836fb192b6923cd4290169886aacf7c5031d5173",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S19",
  "pov": "破压后羲脱笼、法天受材逼池与飘带血桃救险开路",
  "attribution_caution": "冰眼重新孟持有本章明述，转交经过没写不补。自己主材未用、敌羽已催、道袍烧毁背疼未疗。池尸未名未死，桃救动作不等驯服善恶定案，猜高身份仍未完全确认。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 9,
      "label": "韩也惊人皇而禁飞保留",
      "direction": "韩惊高有剑此前暗猜不知，剑皇象清愁龙怨雷火混洞刑压，横天禁飞依旧不是全解除。",
      "evidence": [
        "v04-c0192:p0001",
        "v04-c0192:p0009"
      ]
    },
    {
      "paragraph_start": 11,
      "paragraph_end": 32,
      "label": "孟疑高身份促逃顾已复神",
      "direction": "血桃压崩跌出孟没看，顾再说人皇剑孟忆龙台铁棍高览，猜是大哥却留他世界奇遇可能未定案。觉法王难撑短，实窍开勾天准备唤顾但她已复从容，心理阴影减仍谋逊。",
      "evidence": [
        "v04-c0192:p0011",
        "v04-c0192:p0032"
      ]
    },
    {
      "paragraph_start": 33,
      "paragraph_end": 52,
      "label": "羲实破笼与无言分工",
      "direction": "全勾天羲拳摧飘带笼重获自由，孟顾不语意同先冲唯一宗师点，孟以法天两头四臂实际持四兵雷言攻，不愿先主材可避为其考量。顾掌凝神像入眉气质变虚空神鸣非老母肉身亲临。",
      "evidence": [
        "v04-c0192:p0033",
        "v04-c0192:p0052"
      ]
    },
    {
      "paragraph_start": 53,
      "paragraph_end": 63,
      "label": "羽毛实催烧伤逼池滑翔",
      "direction": "羲黑赤金羽如大日材实催火，孟扑避道袍烧背伤落池上空，火主要顾而孟被逼投入是孟悟。变鸟翼滑非自由御空，凭虚为备非此刻已用。",
      "evidence": [
        "v04-c0192:p0053",
        "v04-c0192:p0063"
      ]
    },
    {
      "paragraph_start": 64,
      "paragraph_end": 78,
      "label": "怨尸吸坠白带血桃解救羲退",
      "direction": "池未名白尸全白眼起替死吸，孟鸟坠变人凭空转仍差岸，白带牢止腰顾下风；血桃实砸尸回水。孟借带上岸冰眼在手未催，羲福紫双翼主动滑入虚云失踪，道路开非尸杀羲死或主线完成。",
      "evidence": [
        "v04-c0192:p0064",
        "v04-c0192:p0078"
      ]
    }
  ],
