{
  "schema_version": 1,
  "chapter_id": "v04-c0298",
  "title": "第二百九十八章 武道之心",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "5d57b5c5cd6d471c95709c2c847b3849bb93709a4f8e47018ffb0d31349742d2",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S38",
  "pov": "冰雪十招中止与武道热忱追问",
  "attribution_caution": "右手齐腕自断未再生、天伤冻柄未失毁确，左斩玉持有217兑换可证。吴冰躯碎雾再现未真死，点未实际命中孟伤魂。阴阳实用范围攻只想，十招中止无胜败完成。武道之心吴定义、感不同势孟推，不当作者定论；获岛等门径未素女协议/绝刀。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 10,
      "label": "冰迟退避与窥虚锁拔刀、弃藏展混沌域",
      "direction": "吴首拳追近孟大日化寒才欲拔又枢机夺势、坚冰隔天地连变预压。孟原十招非生死想不暴元始域刀剑应，9内惊弃侥幸展混沌元始，不新第一次有域/永久废武。",
      "evidence": [
        "v04-c0298:p0001",
        "v04-c0298:p0010"
      ]
    },
    {
      "paragraph_start": 11,
      "paragraph_end": 17,
      "label": "混沌破窥得拔刀、手刀无撞至双手冰雪世界",
      "direction": "拳微游孟敏挑半太极侧卸吴变爪捉刀背，多招变化无实撞、几十里冰海雷月非全东海。吴左手出万象消仅冰世界感，一拳爪处处实，无实宇宙毁海云。",
      "evidence": [
        "v04-c0298:p0011",
        "v04-c0298:p0017"
      ]
    },
    {
      "paragraph_start": 18,
      "paragraph_end": 29,
      "label": "法天雷刀转虚、寒梅击背与自断右手左斩玉",
      "direction": "18明确天之伤法天尖旋，雷海遮刀穿拳爪、冰肘延再寒梅生死拂。25刀网未挡26首次实当刀背27手冻柄28主动齐腕断右掌左握斩玉四刀各性，不自断整右臂/左手或刀名混一。29四刀被冰魄吞未吴伤亡。",
      "evidence": [
        "v04-c0298:p0018",
        "v04-c0298:p0029"
      ]
    },
    {
      "paragraph_start": 30,
      "paragraph_end": 40,
      "label": "回刀斩冰躯、背后销魂点与自情漏洞",
      "direction": "反常回抽借枢机斩躯32冰雕破33背雾再现未真吴死复活机制实名。点触痛执孟忆六道命亲顾警告，35内不好唯我佛醒但36目热忱探索38仍挡不了，39/40孟猜吴所见生机死意等不同势非客观全机制。",
      "evidence": [
        "v04-c0298:p0030",
        "v04-c0298:p0040"
      ]
    },
    {
      "paragraph_start": 41,
      "paragraph_end": 46,
      "label": "阴阳干扰退距未成范围攻、吴收手未结十招",
      "direction": "孟实际阴阳印生死干扰退想范围隔，仅打算不已葬星河。吴叹收手43有可能挡十但缺武道心索然，未硬判十招完成孟胜败或兑现原资格。孟愕问内不服。",
      "evidence": [
        "v04-c0298:p0041",
        "v04-c0298:p0046"
      ]
    },
    {
      "paragraph_start": 47,
      "paragraph_end": 52,
      "label": "武道工具与热忱之辩、给岛上等素女路径",
      "direction": "吴承孟求强动力危险压抑驱但不热忱追道、工具判断为吴定义不作者认孟从不勤修。喃问大道生命生死刹那招功阐追、孟内理性疑，52吴讲世事感情夏虫然后让到三仙岛等素女有事来，是等待门径未精确玄女现址/来人实名到达。",
      "evidence": [
        "v04-c0298:p0047",
        "v04-c0298:p0052"
      ]
    }
  ],
