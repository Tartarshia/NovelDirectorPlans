{
  "schema_version": 1,
  "chapter_id": "v04-c0231",
  "title": "第二百三十一章 磨刀不误砍柴工",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "379ae76c2dbd901f63807aef592463ddda31f95950177a86d3d5a6fa57638c64",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S23",
  "pov": "承天破禁、齐借势与孟伏琴斩徐前后冲台",
  "attribution_caution": "首次杜催承天破禁不毁核心，血雾反补台。孟攻台前为分身到66才揭本尊伏琴，徐前影子刺客死不徐巍死；余东极试封未交。敌扣3000非己账。闻遭雷刀末未结，神降未成亦未阻终。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 12,
      "label": "抵祭台、半盏茶与杀敌助献祭限制",
      "direction": "义军精英分主攻护船，九层祭台入目沈持帝刀核心血教仍布，齐判最多半盏茶少杀人因血肉补祭，杜下令鼓攻左右按前分工。只见在建将成，不写神已降。",
      "evidence": [
        "v04-c0231:p0001",
        "v04-c0231:p0012"
      ]
    },
    {
      "paragraph_start": 13,
      "paragraph_end": 33,
      "label": "枪阵阻敌、杜立即催承天破禁与丹封补正",
      "direction": "独孤金枪无须法天借阵流星罩，顽石江齐挡；杜开局真实催承天沈措手不及，神圣虚空声非杜口令确指。剑退武皇破禁掀船，枢机兵将血雾入台。杜服自有未名灵丹只恢复自保；孟实际尝试余东极丹被封给不了杜，没孟丹消耗。",
      "evidence": [
        "v04-c0231:p0013",
        "v04-c0231:p0033"
      ]
    },
    {
      "paragraph_start": 34,
      "paragraph_end": 43,
      "label": "齐九剑冻引流星与顽石联拖独孤",
      "direction": "独孤觉齐最危先攻、吹飞浮木，齐血肤幽眸空踏气爆转身九冰剑侧引枪势落江；顽石封续枪，齐靛沧海借九浪原威反击，两人拖住一品非已斩武皇或齐晋一品。",
      "evidence": [
        "v04-c0231:p0034",
        "v04-c0231:p0043"
      ]
    },
    {
      "paragraph_start": 44,
      "paragraph_end": 60,
      "label": "江攻祭台无损、闻绿刀魂芒与琴助",
      "direction": "杜被两绝顶拦，江与孟表象冲台全力剑台无损沈说核心不损不毁且惜帝刀；江攀九层被闻刀迫退，孟遇风绳未知道术助者疑。阮远琴如钟凝绳迟闻，江惊鸿照影来刺眉闻魂凝刀挡，再罩二人觉孟实力不对。",
      "evidence": [
        "v04-c0231:p0044",
        "v04-c0231:p0060"
      ]
    },
    {
      "paragraph_start": 61,
      "paragraph_end": 75,
      "label": "护琴暗伏本尊与斩徐前、敌侧扣善",
      "direction": "阮船抚琴赵侯护，透明剑刺丹田未中，孟斩玉挡削尖逼出续开天斩。揭此前随江攻台为分身，本尊小虫衣褶伏敌；四刀后本尊赴台，尸裂肢落血喷，真刺客徐巍影子徐前死，敌六道每人扣3000非己方明确到账。",
      "evidence": [
        "v04-c0231:p0061",
        "v04-c0231:p0075"
      ]
    },
    {
      "paragraph_start": 76,
      "paragraph_end": 81,
      "label": "本尊雷刀过江冲闻、交锋未结",
      "direction": "闻感始实力不对听敌扣，孟本人刀紫电青雷冲江暴喝刀声震浪雷神巨形天降妖魂击散。未写闻死或败、未台核心毁、未神降取消；招名法天/天打五雷未直接点故不新增次数账。",
      "evidence": [
        "v04-c0231:p0076",
        "v04-c0231:p0081"
      ]
    }
  ],
