{
  "schema_version": 1,
  "chapter_id": "v04-c0297",
  "title": "第二百九十七章 狂客与狂刀",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "06de254cb34b9c718423605529186ba881a2f1e92c862c02440ffa1e956d0910",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S38",
  "pov": "东海狂客情执与狂刀十招问线",
  "attribution_caution": "吴夫妻情应身记忆说法为本人立场未客观全机制，老仆邪魔评立场。直钩偈孟借禅非自己经历，清净不新法身。吴点评不是新榜完整序列或客观战果；第一拳未命中十招未完，未得玄女踪/绝刀。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 15,
      "label": "夜海无饵钓心、老仆劝情与狂客自辩",
      "direction": "楼船青袍八字胡内敛无真元鱼饵，老仆忧养育情非亲父。吴解释待玄女法体记忆融合可争娶、夫妻几十年非假不悔是本人说，未玄女已法身旧妻复活。老仆诋应身邪魔是立场，吴主动纠缠珍爱不怪妻。",
      "evidence": [
        "v04-c0297:p0001",
        "v04-c0297:p0015"
      ]
    },
    {
      "paragraph_start": 16,
      "paragraph_end": 28,
      "label": "孟直钩愿者、狂笑棒喝与情困法身",
      "direction": "小舟青衫孟直钩无真元，吴问愿上钩、狂笑自照孽缘后叹骄茫悲。不把老仆吓误疯确诊/彻底解情/晋法身，月暗阴影声态降温。",
      "evidence": [
        "v04-c0297:p0016",
        "v04-c0297:p0028"
      ]
    },
    {
      "paragraph_start": 29,
      "paragraph_end": 38,
      "label": "吟偈净心、认狂刀与摸性直求",
      "direction": "孟拍船吟桃花偈引用禅僧不捏己原创，吴重复渐清净情在我非玄女。心灵清净未正式新境圆满法身。吴脾性狂怪喜非迂腐，孟报苏孟、吴提阿难逐少林为吴认识说法非重写逐寺全史；元心印掌握更深摸性直求线。",
      "evidence": [
        "v04-c0297:p0029",
        "v04-c0297:p0038"
      ]
    },
    {
      "paragraph_start": 39,
      "paragraph_end": 45,
      "label": "情敌戒备、坦荡释疑与十招换踪",
      "direction": "吴以应身缘猜孟情敌，孟内污泥避与吴珍宝不同相看，未真污秽身攻击玄女。孟只求消息吴信无情思，承踪难找不轻给，提出十招不败资格未实际交线。",
      "evidence": [
        "v04-c0297:p0039",
        "v04-c0297:p0045"
      ]
    },
    {
      "paragraph_start": 46,
      "paragraph_end": 52,
      "label": "狂傲评榜与十招赌约",
      "direction": "吴惟服苏无名其余榜人挨评为私人旧印象/夸口，不所有武评作者事实亦非新版完整名次名单。孟撇嘴狂客贴，吴破过去无交手兴今愿战孟，十招对刚宗师先后同条件非已赢。",
      "evidence": [
        "v04-c0297:p0046",
        "v04-c0297:p0052"
      ]
    },
    {
      "paragraph_start": 53,
      "paragraph_end": 60,
      "label": "月华透彻感与无兵第一拳冰迟",
      "direction": "月亮吴似神域笼视海非全球冰海，孟自体无秘密感与55天人合一/外景机制对照。56–58惊地9大宗师，59拳遥击未兵，60寒霜行动思维迟使拳似闪电，未拳命中/孟出招败胜或十招结。",
      "evidence": [
        "v04-c0297:p0053",
        "v04-c0297:p0060"
      ]
    }
  ],
