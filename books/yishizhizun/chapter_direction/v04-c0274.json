{
  "schema_version": 1,
  "chapter_id": "v04-c0274",
  "title": "第二百七十四章 死不瞑目",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "c3dfbe7a001f79cf7bcc606a0f5748b2b7e6450ad169b06457910cec6117c867",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S33",
  "pov": "陶托真战与顾六欲假孟表战转四方围陶，六欲心欲再生悬点",
  "attribution_caution": "托愿力替死实一次再两次陶估；顾宗师战判断六欲源，赞词法音未明。四人配合六欲口揭、陶实死魂灯一天托称不灭非生存；六欲耳断未死，孟幡刺摇实用，末尾读孟心理仍六欲感应不全知独证。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 12,
      "label": "虚空神刀与托天母神相、如意改刀路",
      "direction": "陶闪移马刀斩开金光、透明八臂六腿虚空法相/几十里领域。地榜前六十为本人不忿自估不正式榜。托神相如意挡后刀移面门、吐气尖叫使刀偏；花海神咒不拦挪移但改命中，不真人天母到场。",
      "evidence": [
        "v04-c0274:p0001",
        "v04-c0274:p0012"
      ]
    },
    {
      "paragraph_start": 13,
      "paragraph_end": 21,
      "label": "蓄力近颈断首与愿力代刀实替死",
      "direction": "陶怒一刀手腕消虚空从半寸近颈破防，托头化愿力花再生实际替死一次、仍活。陶刀需蓄暂不能二发、估托顶多再两次为战斗经验非库存定数；想她不能逃为主观自信。",
      "evidence": [
        "v04-c0274:p0013",
        "v04-c0274:p0021"
      ]
    },
    {
      "paragraph_start": 22,
      "paragraph_end": 30,
      "label": "顾真空无生指与六欲神足避、领域反击",
      "direction": "白莲多顾指与赞词归属法音待录审；六欲似听顾意神足通避、料先有发在意先例外不绝对无敌。六欲战判断顾已宗师精确层未给；粉光邪欲领域为术相非真实人群性交，金掌破影逼顾退另一界不命中伤。",
      "evidence": [
        "v04-c0274:p0022",
        "v04-c0274:p0030"
      ]
    },
    {
      "paragraph_start": 31,
      "paragraph_end": 37,
      "label": "假极恶脱束吸丝剑倒飞、托掷如意陶援",
      "direction": "六欲破指让假孟脱真空束，顾袖飘带被吸后合剑震飞孟入陶托区、伤势未定。托神相愿力如意攻孟，陶莫名软心或保力量仅叙可能原因，实闪前挡，未证明孟此刻用了元心控陶。",
      "evidence": [
        "v04-c0274:p0031",
        "v04-c0274:p0037"
      ]
    },
    {
      "paragraph_start": 38,
      "paragraph_end": 50,
      "label": "黑幡背刺与四方实围杀、六欲口揭配合",
      "direction": "假孟黑幡插陶背污身神非单伤即致命。顾法印凝虚空堵逃、六欲掌攻、托不如意使陶保命物失效、幡摇魂滞后金掌击额元神散。六欲公开说心通勾连使孟唤尸顾遮危托阻遁、主要目标陶，为参与者说法配合实行动，不回填272全知。",
      "evidence": [
        "v04-c0274:p0038",
        "v04-c0274:p0050"
      ]
    },
    {
      "paragraph_start": 51,
      "paragraph_end": 56,
      "label": "残执念反击断六欲耳、陶肉泥死与魂灯遮术",
      "direction": "陶残念刀反击切六欲一耳未杀，六欲惊恐挥袖把陶尸肉泥无声息。托暗施秘术称魂灯一日不灭未远端验灯。孟提剩四不再互杀否则捉萨仁变送死，是暂劝未实际追到。",
      "evidence": [
        "v04-c0274:p0051",
        "v04-c0274:p0056"
      ]
    },
    {
      "paragraph_start": 57,
      "paragraph_end": 61,
      "label": "六欲邪欲盖过恐惧、违师叔谋强迫与误读风险",
      "direction": "六欲秘密认为庙无半法不能钳古、想强取顾托采补求半法，违师叔命但未真实施/晋阶。读假极恶只想他三残杀便宜是六欲感应所得非孟独立内证；望孟病笑像计划成功保焦点误判可能、不假孟已被认。",
      "evidence": [
        "v04-c0274:p0057",
        "v04-c0274:p0061"
      ]
    }
  ],
