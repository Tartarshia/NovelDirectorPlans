{
  "schema_version": 1,
  "chapter_id": "v04-c0249",
  "title": "第二百四十九章 君子报仇，就在今时",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "9306eeb30e63104147cb2e4eb7b8ac4a577aa4225b3ccbcff6784c306c058cd2",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S27",
  "pov": "矩子责任、承谤的非篡位政变方案与朝会翻天印杀王丹的实际起手",
  "attribution_caution": "朝会已真实行动王丹死确，但连拔两家、公羊高/于子恒死和陈政变完成均未发生。33王勾玉虚公告为假叙未来不是历史真实弑公羊。孟陌面未明确被取代者具体名无新境晋。田报赤霞亲传据说，幼陈王不亡旧王复活。陈王复仇磨与聚真墨责任并行非只是任务道具。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 15,
      "label": "田拒私夺、兼利能承谤与矩子责任",
      "direction": "田拒取陈为己诚墨志孟内赞纯、提若利可受谤6反问名声田礼承教，9田掌非篡当前贵族可投楚唐无陈存亡责，10拟除王公羊11孟不义当诛自觉言行需合道12起任务但聚真信者有责任13非物品14照心圆满修，未把人只当练级材料。",
      "evidence": [
        "v04-c0249:p0001",
        "v04-c0249:p0015"
      ]
    },
    {
      "paragraph_start": 16,
      "paragraph_end": 26,
      "label": "田家也有错、温和不扬墨与流血后治民方案",
      "direction": "田承己家类似孟可改弥补只做不扬避金光利益，田记20不义斗非歌舞必血软害墨21两三年认识数十殉。22田内讧名遮23世外金光不涉利不管为战术判断，24–26成功后连拔王公羊属族腾资官公学培武宣不侵贿唐暂安、待好机卖价保王田食邑全条件未来尚未做。",
      "evidence": [
        "v04-c0249:p0016",
        "v04-c0249:p0026"
      ]
    },
    {
      "paragraph_start": 27,
      "paragraph_end": 40,
      "label": "陈无逆才难追、齐墨超家国与玉虚诱敌",
      "direction": "田惊最后卖国孟天下势错机会弱需十年法身逆才，田报吴一年平叛休息完侵南道佛扶为消息。孟若齐墨崛可保陈号田墨超家国振，32问具体33拟国事时全打、王勾玉虚先杀公羊再内讧田剿忠陈依楚金光求驻是伪造公告计划非历史真过程。34田报金光一绝顶护公羊督捕据说赤霞亲传35孟喜36玉虚何来38苏自己并给逃线诱金光39陈王恩仇40磨砺内决未敌已追。",
      "evidence": [
        "v04-c0249:p0027",
        "v04-c0249:p0040"
      ]
    },
    {
      "paragraph_start": 42,
      "paragraph_end": 53,
      "label": "朝会控罪、幼陈王无措和两家阻",
      "direction": "幼继陈王居高昏睡非死王复活，王丹大司徒田横大司寇公羊高大司空于子恒金光绝顶护殿。田横卷国罪43王丹盗难禁45父令儿具体田括小司寇述王鞭奴欺商掠歌女，王丹奴生死非外事刑不上大夫、田举诸家罪请求小王除51惊醒茫然52王公羊共喝尔敢53王丹强截出门未全政变成功。",
      "evidence": [
        "v04-c0249:p0042",
        "v04-c0249:p0053"
      ]
    },
    {
      "paragraph_start": 54,
      "paragraph_end": 62,
      "label": "孟现陌面、翻天印实杀王丹与于子恒识玉虚",
      "direction": "门孟古服黑冠面陌55王问56除害人57五指玉荧盖，幽暗虚收重吸使王倒不成秘宝技都迟58/59额掌60罩裂61额脑迸骨无全瘫死是确击杀未幻，62于跃仓惶喊翻天印玉虚余孽，未与孟开打结果没公羊死或两家全灭。",
      "evidence": [
        "v04-c0249:p0054",
        "v04-c0249:p0062"
      ]
    }
  ],
