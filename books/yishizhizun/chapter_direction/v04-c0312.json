{
  "schema_version": 1,
  "chapter_id": "v04-c0312",
  "title": "第三百一十二章 太上天魔的遗言",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "8048b2acf5f6d33a82352621bffcaf408d2968e9c36ce0d632fac734662a9cc1",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S39",
  "pov": "历代爪主末语、鱼的推理与各组峰顶古棺",
  "attribution_caution": "吴道明第五、杨通天第六残景不实复活。鱼和霸王内幕为孟推，杨旧死经过为王氏传讯。棺主/叹声仍未认魔君。陈刘走完鉴心但未来洗练，原同路非敌彼此见不等全队会合，孟实登顶未脱困开棺获爪。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 16,
      "label": "拒贪邪兵、第五代吴道明旧史与霸王疑案",
      "direction": "孟不贪魔皇爪冥海剑，警惕心灵扭曲；辨吴道明残影，旧史学儒佛道后得爪统一魔门，一甲子传说有望非已证传说。霸王东海灭天魔是记载，孟疑霸王旧陨案黑幕，境界与围杀不可能含推断；不展示已核幕后真相。",
      "evidence": [
        "v04-c0312:p0001",
        "v04-c0312:p0016"
      ]
    },
    {
      "paragraph_start": 17,
      "paragraph_end": 28,
      "label": "天魔遗言与同病相怜、鱼的假说",
      "direction": "吴道明残景突说彻底毁灭纪元才能清净，不甘叹不同前代恨；孟停步疑对霸王，想到顾小桑同样的人，先疑爪主皆鱼再自排前三强者、只吴也许。均孟未证推理，顾不在场不重演为新台词，未实终纪元或确认吴鱼。",
      "evidence": [
        "v04-c0312:p0017",
        "v04-c0312:p0028"
      ]
    },
    {
      "paragraph_start": 29,
      "paragraph_end": 34,
      "label": "第六杨通天残景、王氏传出旧死讯",
      "direction": "孟近顶见六最后无量邪主冷酷帝冠右爪，无新发言；魔佛乱世后万年时代与遗迹宝物求破王阵的旧事，32同归说法33来自王氏、左道间接确认陨落，内幕不能全证。34疑爪曾回此地非已经到手或尸体身份证。",
      "evidence": [
        "v04-c0312:p0029",
        "v04-c0312:p0034"
      ]
    },
    {
      "paragraph_start": 35,
      "paragraph_end": 38,
      "label": "古棺七步外与未名坐化声",
      "direction": "距顶七步停黑松青铜古棺、回荡旧叹；孟按三至六与第一魔坟齐传承推第二魔君，仍疑未棺内验尸认人。声源只回荡未知，不能演员直接认证魔君本人。",
      "evidence": [
        "v04-c0312:p0035",
        "v04-c0312:p0038"
      ]
    },
    {
      "paragraph_start": 39,
      "paragraph_end": 47,
      "label": "分组到峰口、仙宫棺相似而不相见",
      "direction": "叶路上除婆再无人、峰口四周无人；幽冥大躯占入口几百步处低语疑魔君遗蜕，非新晋法身。陈刘实走完鉴心各有得阴霾皆见洗练未来、陈见类似古棺想仙宫核心传见难近疑天仙主人。哈等仍小径，同路原在一起非敌可彼此见，不等所有失散者已会合。",
      "evidence": [
        "v04-c0312:p0039",
        "v04-c0312:p0047"
      ]
    },
    {
      "paragraph_start": 48,
      "paragraph_end": 50,
      "label": "查无发现陷阱、实际登顶仍寻同伴",
      "direction": "孟检未发现禁法陷阱沉稳实登顶，棺铜绿鲜明；首问叶等哪里，忧同伴胜于贪兵。不是陷阱已证明不存在、脱困开棺获爪或新战果；留几组峰口互看不见的悬念。",
      "evidence": [
        "v04-c0312:p0048",
        "v04-c0312:p0050"
      ]
    }
  ],
