{
  "schema_version": 1,
  "chapter_id": "v04-c0228",
  "title": "第二百二十八章 世间安得双全法",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "84bf9593e232ffe1f840a22b9041dc1bb2e90021536ace8a19c5bee124fb3f6a",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S22",
  "pov": "三友隐刺协防、战利品收取与齐道路分歧本命符",
  "attribution_caution": "闻确认非死亡任务退援；三友甲琴剑实际应刺逃但未名。孟伤真无再催甲力、棍环瓶实收无丹服结现款。公平方案与利益判断来源各人，齐本命血符亮未催、正式离队未定。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 6,
      "label": "闻景退援返阵与非死亡任务认识",
      "direction": "闻对苗能力知自不敢直面却被快杀惊，明确本人本次非死亡任务、不解诡功不能无限。放弃西丘协援重归阵进攻，非已与孟相见。",
      "evidence": [
        "v04-c0228:p0001",
        "v04-c0228:p0006"
      ]
    },
    {
      "paragraph_start": 8,
      "paragraph_end": 32,
      "label": "三友协防虚空刺、帝袍实催与朝廷收兵",
      "direction": "江反鞘先觉后真白虹出挡第二击仍感无敌；赵见异实催玄黄帝袍挡背透明剑，阮实琴百鸟虚振定位江刺敌提前退遁。江护阮赵侧琴续。战伤军多人船沉两外景不返似怪杀，朝廷破枢难收军。刺宗师或短爆、似罗教/类血/兑换轮回是三友猜，未实名。",
      "evidence": [
        "v04-c0228:p0008",
        "v04-c0228:p0032"
      ]
    },
    {
      "paragraph_start": 34,
      "paragraph_end": 49,
      "label": "孟恢复、收苗棍环延寿瓶与带尸返",
      "direction": "孟天地吞元疗本次末击已无力再催昆仑硬抗真伤，齐快几息杀刘识其连续错另谋隔岸观非没机会救。孟阵开无法入故没回、43真取铜棍环元始灭自毁印，环无功法几小瓶不同延寿各1兼恢复效果；苗已常丹吃遍孟推、齐断法身无望六道难补属其解释。未服药未换善，带尸返途中寿尽模糊凶不刺激苗为策略。",
      "evidence": [
        "v04-c0228:p0034",
        "v04-c0228:p0049"
      ]
    },
    {
      "paragraph_start": 50,
      "paragraph_end": 62,
      "label": "留韵陶战利品建议与公平传功根本冲突",
      "direction": "孟让齐留刘环兵为可能离队消耗齐点头，非正式离队完成。孟提偏远试武学择性不家世、努力机会改良门派降冲突推广强控为方案未执行。齐认方法但根本利益必扭曲毁坏总体不化解是其政治判断，孟认自己避残忍沉默非双方和解。",
      "evidence": [
        "v04-c0228:p0050",
        "v04-c0228:p0062"
      ]
    },
    {
      "paragraph_start": 63,
      "paragraph_end": 70,
      "label": "近营本命符真现、讨血控制试探与邪魔警告",
      "direction": "孟问如何蒙苗齐亮苗气血符称本命一催生不如死、原追血另有法讨血为控制试子险知情。未实际催折磨苗、未已入营告死亡，符能力效果由齐说未验证。邪魔警告是齐自揭道路非把所有伙伴已知。",
      "evidence": [
        "v04-c0228:p0063",
        "v04-c0228:p0070"
      ]
    }
  ],
