{
  "schema_version": 1,
  "chapter_id": "v04-c0122",
  "title": "第一百二十二章 素女道",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "56896cf015daae806cff18d74fc877fcaaece3b073b615705fe9eeb18910e523",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S14",
  "pov": "以孟奇观察和内心为主；百花招揽话术与婴宁介绍为人物口述",
  "attribution_caution": "欢喜支身份此章正式确认，不倒灌早期猜测；入门仍未完成，孟不会真去见欢喜宗主当客卿。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 13,
      "label": "正式认素女与装不满",
      "direction": "百花谢脱围，孟知危局自己制造；百花正式承素女，孟改老夫冷态表达邪道强者正常戒备而非真实欲投。其被当宗师的价值促招纳。",
      "evidence": [
        "v04-c0122:p0001",
        "v04-c0122:p0013"
      ]
    },
    {
      "paragraph_start": 14,
      "paragraph_end": 26,
      "label": "两脉及据点方案",
      "direction": "百花自认欢喜非玄女，叙传承采补反哺规条是其招揽说辞，孟不信遥远回报。核心应身内篇与普通外篇为孟已知。先去两脉共驻点等宗主誓约为方案，未契约未客卿。",
      "evidence": [
        "v04-c0122:p0014",
        "v04-c0122:p0026"
      ]
    },
    {
      "paragraph_start": 27,
      "paragraph_end": 36,
      "label": "离华路线与潜离纠正",
      "direction": "百花留管郢临海，婴宁引路万手带，孟携婴飞十数日至潜离。离华潜离一隐一显同地，怜欲八菩萨之一及玄女商水寡居均强绝顶非宗师，尚未见面。潜离明确合作势力不是直接素女分舵。",
      "evidence": [
        "v04-c0122:p0027",
        "v04-c0122:p0036"
      ]
    },
    {
      "paragraph_start": 38,
      "paragraph_end": 53,
      "label": "船行诱惑与拒绝",
      "direction": "独特航线绕潜离，婴宁以临海约已完成前来亲近，孟借待突破拒绝无性行为，内防她秘术。用谈话了解岛况；她称阵对外不内、五等炉鼎且不愿离为其说法未独验。不扩写情色。",
      "evidence": [
        "v04-c0122:p0038",
        "v04-c0122:p0053"
      ]
    },
    {
      "paragraph_start": 54,
      "paragraph_end": 59,
      "label": "风暴后到岛",
      "direction": "船遭风暴按婴提示等，天明迷雾中离华现，已抵达尚未登岛访两脉高手、入仙界或解因果。",
      "evidence": [
        "v04-c0122:p0054",
        "v04-c0122:p0059"
      ]
    }
  ],
