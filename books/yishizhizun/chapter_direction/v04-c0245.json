{
  "schema_version": 1,
  "chapter_id": "v04-c0245",
  "title": "第二百四十五章 人生自是有为难",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "60a016372a83dace902be8e747f931e372be3edb3a24c9906017996793595042",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S26",
  "pov": "画眉留查与情义理念取舍；陆剑微凝爆、罗知磨砺、六扇门拟榜",
  "attribution_caution": "陆凝爆是剑光细束源非天帝时光，尚未供楼秘；孟烙印复活最终血肉灵是假设非陆现能力实演。高览神话牵案猜告陆后明确不能武断；暂当两人不真人格分裂。六扇纸陨落消息与司马误感不刺真死，重拟地榜仅命令无正式榜名次。48分隔不正文场面，脑掌伤恢复仍无明述，善15欠500未变。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 19,
      "label": "残神自爆凝固、剑光入微解释与谨慎探秘",
      "direction": "孟知陆地仙消息少人知为推，见刺神膨模狂暴被剑丝细束直到感不出。陆说初制莫名自爆靠新剑光入微逐源束爆，非时光能力。解释开窍外景入微再深无尽，孟想烙印复活为发展推不是陆现已做到。陆说孟变化掌微超自知将来法身不比今差预测；肉影先毁才无隔能凝爆，探楼秘密须慢试未供。",
      "evidence": [
        "v04-c0245:p0001",
        "v04-c0245:p0019"
      ]
    },
    {
      "paragraph_start": 20,
      "paragraph_end": 31,
      "label": "罗震实力、孟请教效果与由天赋到磨砺认可",
      "direction": "罗初闻孟毁肉影惊，内比自己三十年才宗师未地榜、孟三年半。孟讲三交战不讲招只讲效果请教，陆切要点令孟精髓更活无量光隐联入微不是当场地仙微新境。罗易位前两重伤可退第三恐死为假想，知孟苦磨而共鸣自身入门晚实力前二，惺惺相惜不当场约战。",
      "evidence": [
        "v04-c0245:p0020",
        "v04-c0245:p0031"
      ]
    },
    {
      "paragraph_start": 32,
      "paragraph_end": 47,
      "label": "孟情义理念两难后披露、陆不武断限定两家查",
      "direction": "周死似神话欲言止，孟想韩广高览勾连怕兄险又忧草南民友惨，理解齐退队的理念矛盾；暂分冷高与逗兄作为决定框架非两实体，实说神话可能搭桥涉高未认定真罪。罗若高可广网猜陆不能武断，命纯阳画眉两家查广网、长乐青红找妻儿，暂排其他协查非嫌疑全洗。罗应离安排孟同意留到清后患，欲日后讨楼秘好处未已取，出庐身松。",
      "evidence": [
        "v04-c0245:p0032",
        "v04-c0245:p0047"
      ]
    },
    {
      "paragraph_start": 49,
      "paragraph_end": 61,
      "label": "六扇门书面情报与陨落传闻、司马令重拟榜",
      "direction": "神都朱衣楼司马静茶金章捕头递纸北大事，54纸叙三分不是本人活口，司马先喜知特点捕头欲言。57纸三败肉影破神逃生死不明有消息死是报告与传闻不真死；司马想又一没了比狼王，三年半即上榜与自身七年复七年法身遥内叹，实际命重拟地榜传事但本章没榜名次发布结果。",
      "evidence": [
        "v04-c0245:p0049",
        "v04-c0245:p0061"
      ]
    }
  ],
