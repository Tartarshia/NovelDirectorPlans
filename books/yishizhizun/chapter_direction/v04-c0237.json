{
  "schema_version": 1,
  "chapter_id": "v04-c0237",
  "title": "第二百三十七章 极于情者极于剑",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "6107683226ed2df02cc25a838d413452aac3e3e42942fa7d285e77da63991a60",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S24",
  "pov": "谢陆与法身后道路认知、情剑独一探索",
  "attribution_caution": "237陆刚入地仙略传特征权威自述，不传说同杨戬；神魔世能改本世界九重不能地域根法差有证，未无限神通。树只呈前未交永久属。诸界传说系统陆述，罗刹他我图谋孟推陆评若成功仍条件；陆独一分他我非众归前路未知，43评语孟脑海非陆口声。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 11,
      "label": "春画眉拜谢、墓园除草专注与树剑呈前",
      "direction": "叶出未归弟子引孟真至墓庐，陆青锄亲花除草不剑代操作，孟静待如茂陵观雕心静慧见我。陆坐邀，孟谢呈道传树未明确永久移主，陆赞因果缘年前避今正下一铺垫未已悟剑。",
      "evidence": [
        "v04-c0237:p0001",
        "v04-c0237:p0011"
      ]
    },
    {
      "paragraph_start": 12,
      "paragraph_end": 21,
      "label": "借杨戬问剑威、陆刚地仙特征与世界根法界限",
      "direction": "孟不直问铺垫改述杨碑类特征疑同境，陆明与玉虚杨差远在神魔世可隔本天地九重办不到，孟问特殊根本法理陆然。自述刚地仙另所得略传特征，非已经仙尊、古尔多必可秒灭。",
      "evidence": [
        "v04-c0237:p0012",
        "v04-c0237:p0021"
      ]
    },
    {
      "paragraph_start": 22,
      "paragraph_end": 34,
      "label": "传说正常诸界归一、播密取巧错与罗刹镜图谋",
      "direction": "陆系统讲天仙圆满/佛近佛可感点他我归自传说仙尊/佛陀或愿未了大，苦海杀不死除遍宇宙否则复、寿元理由他未知。播密用他人我代他我错。孟悟镜感他我罗刹转世掩护推讲陆赞揭计划未来若成难杀，不已罗刹传说或镜复实物。",
      "evidence": [
        "v04-c0237:p0022",
        "v04-c0237:p0034"
      ]
    },
    {
      "paragraph_start": 35,
      "paragraph_end": 43,
      "label": "妻花往忆与相反道路、独一感剑非众我归身",
      "direction": "陆确机缘但路非沟他我，柔指妻花忆笑爱死后重游怕忘，感情及执剑独一，梦他我越感独特越分各他我非我自己我。反众归不知绝路慢探索是未最终成功证。孟深感脑海想江湖一心评，不妻真人当场或陆宣全路已证。",
      "evidence": [
        "v04-c0237:p0035",
        "v04-c0237:p0043"
      ]
    }
  ],
