{
  "schema_version": 1,
  "chapter_id": "v04-c0306",
  "title": "第三百零六章 磨刀石",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "7050b5092f987d74dea7823468ab6857cddaab85f8e278e8f04db44795319597",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S39",
  "pov": "战养心刀与蓝血击杀、冰原纸讯",
  "attribution_caution": "高死亡元神绞碎确认；符近神兵不是已蜕神兵、储袋无内容价值。三攻之后另刀劈蓝光剑碎神，勿用三刀删收尾。道一皮毛本章具名不改早未名；左剑未名。哈斯纸讯未知发送者未已追杀。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 17,
      "label": "出口显形与三项诛心、符令辩论",
      "direction": "高隐遁过雾缝中断非孟诈，握似剑令近神兵；受大自在谈判影响已消大意仍信保命。孟慢握柄指出依外物、隐患不久战、心退；高13证实隐患并疑古心知谋，辩善假物重振气势，不是未战已经死。",
      "evidence": [
        "v04-c0306:p0001",
        "v04-c0306:p0017"
      ]
    },
    {
      "paragraph_start": 18,
      "paragraph_end": 29,
      "label": "驾驭外物与首刀坍缩、无敌信念计划",
      "direction": "孟区分击败符难杀用者易，19–20内拟隐找摆脱并战养心刀，从高开始不是已天下无敌。拔刀天之伤快转慢、域合刀使元气坍缩锁蛊；高分蛊准备遁后元神危催令。无新指全术名或让慢刀显成迟钝。",
      "evidence": [
        "v04-c0306:p0018",
        "v04-c0306:p0029"
      ]
    },
    {
      "paragraph_start": 30,
      "paragraph_end": 39,
      "label": "剑蛊反冲空击与土遁道一避险",
      "direction": "符借收缩反攻近神兵全击，31–35形如自杀/若核心有人为险判断非孟真的绞死。33锁联系中断孟消失34裂地白光实空击。37土拉高38地喷刀39明确戊己遁地、道一皮毛、土克水藏金，前面踩地为预谋非突然全境穿时空。",
      "evidence": [
        "v04-c0306:p0030",
        "v04-c0306:p0039"
      ]
    },
    {
      "paragraph_start": 40,
      "paragraph_end": 48,
      "label": "第二刀斩蛊、重伤遁与刀剑合击",
      "direction": "高散蛊以多数消亡护元神，刀微气席几十里碎蛊；少量残凝高符护拟逃，44明确重伤且信心失。45孟左手新增未具名长剑斩碰刀，利用前刀余波合击光先至，威不太大却时间短来不及逃，不第二把兵必玄龟或全功法具名。",
      "evidence": [
        "v04-c0306:p0040",
        "v04-c0306:p0048"
      ]
    },
    {
      "paragraph_start": 49,
      "paragraph_end": 58,
      "label": "第三击与后续落神绞杀、实际获物",
      "direction": "白光吞高毁地帐火海，蓝光护淡元神欲逃52刀劈落53剑直接碎元神怕触某些存在不拷问。55孟评价不配宗师、56高临终三刀与催符匆忙后悔，评价不取消真实宗师阶。57收符令储袋、58心中第一个属磨刀计划不平生首次杀人。",
      "evidence": [
        "v04-c0306:p0049",
        "v04-c0306:p0058"
      ]
    },
    {
      "paragraph_start": 59,
      "paragraph_end": 61,
      "label": "肩上飞鸟纸讯接续哈斯线",
      "direction": "鸟落左肩纸条，孟未拆精神感字冰原边哈斯等金帐踪迹，是不具名发信者报告未孟实见或哈斯新败/新死。只消息传递不鸟开口、不新线索发送者强填赵皇。",
      "evidence": [
        "v04-c0306:p0059",
        "v04-c0306:p0061"
      ]
    }
  ],
