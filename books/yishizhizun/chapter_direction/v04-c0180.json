{
  "schema_version": 1,
  "chapter_id": "v04-c0180",
  "title": "第一百八十章 只叹江湖几人回",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "c10b8d56f514d4a204414259c7c6730eb87fe2d52d56125fc5dab8064b59b621",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S19",
  "pov": "友情余波中的自省，变貌神都与仙迹招揽现实限制",
  "attribution_caution": "孟理念同情不等承诺革命或全拒齐；传闻、自称与怀疑严格分，九重天图尚未看、赵未获招未弃位。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 18,
      "label": "认同有界与江湖离散感",
      "direction": "齐话回荡，孟低骂称墨家矩子，联改良墨家与普及功法办法，机会平等可接受、绝对公平和偏激仅忧虑非齐已偏。自承小资产软弱性为自嘲，当前愿调停不愿巨大代价，未来有强力才推仍设想。拟下次谈可行性未谈，吟诗忧同伴年月非实际百年过去。",
      "evidence": [
        "v04-c0180:p0001",
        "v04-c0180:p0018"
      ]
    },
    {
      "paragraph_start": 20,
      "paragraph_end": 25,
      "label": "变貌入神都避家",
      "direction": "孟青衫普通面入京，避苏府因仇敌可能守不是已见埋伏。列戒杀非戒赌，反杀设局需能撑几息仅筹算未执行。离苏府两年多为自算。",
      "evidence": [
        "v04-c0180:p0020",
        "v04-c0180:p0025"
      ]
    },
    {
      "paragraph_start": 27,
      "paragraph_end": 39,
      "label": "潜入袁宅和入口传闻",
      "direction": "袁血牙神捕、广成天尊，宗师难无痕入为其判断却孟已潜入，元始之眼信物识身份后封禁谈。孟原求赵监控情报，袁误以九重天而揭消息：神都入口九龙地势为上层传闻未验证。孟猜小桑操盘非她出场。",
      "evidence": [
        "v04-c0180:p0027",
        "v04-c0180:p0039"
      ]
    },
    {
      "paragraph_start": 40,
      "paragraph_end": 46,
      "label": "白宁半图与六重瓶颈",
      "direction": "袁查白宁南荒绝顶自称天帝后裔持半图，住安泰楼似兜售争富贵，均情报与自称非现场证实。袁六重多年自估能撑两任务欲机缘，孟劝静观、若插手再找助，未承诺已参与。",
      "evidence": [
        "v04-c0180:p0040",
        "v04-c0180:p0046"
      ]
    },
    {
      "paragraph_start": 47,
      "paragraph_end": 55,
      "label": "监控值守及以退为进建议",
      "direction": "孟问招赵。袁后日值守可放入是安排尚未进去，提醒赵难离京进碧游天、代联易暴露，建议弃皇太弟位以后法身再取帝位是意见非赵决定。孟答将交流未赵已同意。",
      "evidence": [
        "v04-c0180:p0047",
        "v04-c0180:p0055"
      ]
    },
    {
      "paragraph_start": 56,
      "paragraph_end": 56,
      "label": "街头观感变化",
      "direction": "孟离袁宅再看人群似藏高手，是新警觉感非逐个识破刺客、神都已开战。",
      "evidence": [
        "v04-c0180:p0056",
        "v04-c0180:p0056"
      ]
    }
  ],
