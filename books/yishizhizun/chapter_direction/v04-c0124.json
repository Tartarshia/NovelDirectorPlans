{
  "schema_version": 1,
  "chapter_id": "v04-c0124",
  "title": "第一百二十四章 怜欲之试",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "6bea21f40fd67dc67e85a6c80abfee4c5a4e97468595424abf159b5e3ea7f276",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S14",
  "pov": "孟奇内心与怜欲动机交替；心中佛音不在大殿外放",
  "attribution_caution": "孟内显法相与怜欲未见法相不矛盾；轮回符仅捏未用，魔血用途已发生而感悟绝刀仍未达成。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 11,
      "label": "含糊接旧识",
      "direction": "孟不接具体往事，用自负话两可应对；怜欲称来去匆匆，孟推非旧情人后放松。万手书信近宗师评价是误判。",
      "evidence": [
        "v04-c0124:p0001",
        "v04-c0124:p0011"
      ]
    },
    {
      "paragraph_start": 12,
      "paragraph_end": 28,
      "label": "苦乐辩论与动摇目的",
      "direction": "怜欲以幸存艰难和极乐为采补辩护，孟用慈悲口气说毁灭是邪修表演，内心仍视为歪理。十不存一特指好好活着非死亡率。",
      "evidence": [
        "v04-c0124:p0012",
        "v04-c0124:p0028"
      ]
    },
    {
      "paragraph_start": 29,
      "paragraph_end": 45,
      "label": "强行展示法相与内心抵御",
      "direction": "怜欲欲采补近宗师以突破，假展示试激孟外显法相。孟先失控征兆，再阿难心法与内显元始相争得机会，观唯我真意平复。不省略抵抗过程或误写完全免疫；两女亦被影响。",
      "evidence": [
        "v04-c0124:p0029",
        "v04-c0124:p0045"
      ]
    },
    {
      "paragraph_start": 46,
      "paragraph_end": 55,
      "label": "魔血借势反震慑",
      "direction": "孟已平复才借魔血邪气结合八九模拟佛息，造佛魔威势。怜欲以为未逼出其法相、真有黑榜实力而收手，是误判非孟晋阶。只记血已调用，不擅定剩余或永久融合。",
      "evidence": [
        "v04-c0124:p0046",
        "v04-c0124:p0055"
      ]
    },
    {
      "paragraph_start": 56,
      "paragraph_end": 61,
      "label": "明日立约的时间压力",
      "direction": "宗主明日可能会面立约令孟急需今夜退掉毒手身份。沿路灵兽令鼠变不稳，虫豸需地煞数当前不能；尚未选新身份或实施消失。",
      "evidence": [
        "v04-c0124:p0056",
        "v04-c0124:p0061"
      ]
    }
  ],
