{
  "schema_version": 1,
  "chapter_id": "v04-c0259",
  "title": "第二百五十九章 一掌换一刀",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "9a7cf876448a2eebb8b7ea01189cd2065922670239b7e32124e06e6e9facd34f",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S29",
  "pov": "道一实夺的自主因果意志、掌刀换命与八九破功后的印光未知去向",
  "attribution_caution": "外高人真到未名未指秦穆唐/韩高。分身18碎本尊无伤；印顾左持到69真孟得，非已悟/已斩六道。杨扇46不实发70只欲扇，47两次估不离火药剩2混账。胸掌60背掌71重伤八九破功，金丹36储备未服，鞭催笑74准备破空75印光带走未符耗。66顾仿听孟内喊不是孟口词，消失去向未知。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 4,
      "label": "宫外四门三十六井、未名高人实际到门",
      "direction": "四面各九井对应四门，此刻皇者/随意中年/尚黑老者等几影分侧到门，互视不见专望内，身份境阶没逐名；是实际抵达非仍仅觉异，未入深宫。",
      "evidence": [
        "v04-c0259:p0001",
        "v04-c0259:p0004"
      ]
    },
    {
      "paragraph_start": 6,
      "paragraph_end": 18,
      "label": "折返元心右地遁、道一尚在但诱身被顾毁",
      "direction": "目标道一重返元心选右戊己外景贴地，殿混沌白虹黑芒万彩。拔一发分身开无禁门见漂小印，真意确还在，探陷急遁顾伏掌碎发身，本尊藏外无伤。",
      "evidence": [
        "v04-c0259:p0006",
        "v04-c0259:p0018"
      ]
    },
    {
      "paragraph_start": 19,
      "paragraph_end": 36,
      "label": "顾以印饵、孟因果脱影之志决拼",
      "direction": "孟惊预等疑师长进宫为何不取其他印，这为猜不真实揭。顾左托印诱首三之一与无极缺难舍，是顾心理算；孟因自创因果刀剑斩牵摆脱大能而决不是盲贪，勇退辩论为内心决断。余金丹可保命是储备计划未服。",
      "evidence": [
        "v04-c0259:p0019",
        "v04-c0259:p0036"
      ]
    },
    {
      "paragraph_start": 37,
      "paragraph_end": 51,
      "label": "杨封退顾仙相钟破隐、葬星河盲感令扇暂不发",
      "direction": "杨实堵退顾右印左钟仙相指击虚钟声，金莲也晕露身，刀剑相撞葬星河强光除敌感。杨担空击不扇当前加摧残至多两次为能力估非新实发，剑火相护；顾掌真拍解风暴缓于爆声。",
      "evidence": [
        "v04-c0259:p0037",
        "v04-c0259:p0051"
      ]
    },
    {
      "paragraph_start": 52,
      "paragraph_end": 61,
      "label": "亲扛葬星河法天贴近、问心斩玉与胸掌换开天刀",
      "direction": "孟十丈法天自身火伤换暂单敌，领域仍束。新两臂斩玉心印唯独使顾念暴呆但掌仍出，天伤开天斩胸掌实际粉骨肉陷血虚玄磁稍偏，自己不躲掌换刀，不新正式宗师。",
      "evidence": [
        "v04-c0259:p0052",
        "v04-c0259:p0061"
      ]
    },
    {
      "paragraph_start": 62,
      "paragraph_end": 69,
      "label": "顾袍破心醒恐惧、左肘断本尊实际夺道一",
      "direction": "刀破顾土黄袍恢复，孟血肉夹右掌迟，65顾秘遁来不及只是想未用，66仿听孟内喊非口。左掌挡断肘真，本尊另一手抓道一借右撤力侧冲，不顾死/双臂全失，印已实拿未悟。",
      "evidence": [
        "v04-c0259:p0062",
        "v04-c0259:p0069"
      ]
    },
    {
      "paragraph_start": 70,
      "paragraph_end": 79,
      "label": "后掌令八九破功、鞭吓退与印因果光带消失",
      "direction": "顾追后掌杨扇将发未火实出，孟再硬受背全身近残八九破功，流火手换借鞭抽敌两闪、笑真出声并催鞭准备破空未实激。印黑白因果笼后孟消，去向未揭非符已耗；杨说血肉够望残血是其说法未咒杀成。",
      "evidence": [
        "v04-c0259:p0070",
        "v04-c0259:p0079"
      ]
    }
  ],
