{
  "schema_version": 1,
  "chapter_id": "v04-c0139",
  "title": "第一百三十九章 一剑破阵",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "afed87f474f17952d7af24512d62ce822f1e6239105492c5a42e630c5db07ab4",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S15",
  "pov": "东海何七疑问与三家联攻转琅琊孟奇及不明老者",
  "attribution_caution": "何七非何九，王家主非王思远；神音招名作叙述，32段传音、33齐声回应；海沟揭局不倒灌孟知情。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 8,
      "label": "探无所得仍信卜算",
      "direction": "何七感应未见海沟却不反复质疑洛书；疑阮家倾力动机，非已经知道。阮四宗师来二加老大宗师，神都一位，祖宅仅一宗师，不能把全部算在祖宅。王仅家主携书，剑庄何七黄太冲。",
      "evidence": [
        "v04-c0139:p0001",
        "v04-c0139:p0008"
      ]
    },
    {
      "paragraph_start": 9,
      "paragraph_end": 27,
      "label": "迫显阵与抓转换",
      "direction": "何七剑分海逼阵显，王家主抢阮前三爷到阵边，在半隐蔽转全防御瞬间用洛书窥机会，一剑引海眼力量过载破阵。非无条件一剑破所有大阵，组合预定计划。",
      "evidence": [
        "v04-c0139:p0009",
        "v04-c0139:p0027"
      ]
    },
    {
      "paragraph_start": 28,
      "paragraph_end": 39,
      "label": "巨塔求神与凤鸣杀伤",
      "direction": "翼饰幽蓝塔底浅碟、神像踏龙串蛇只形貌不擅命名。大祭司传音求祖神力量，诸强齐声答，其中白发人类。阮三爷以凤鸣九天神音摄元神煮血，蓝血众惨死；不因无普通人族便淡化杀伤。",
      "evidence": [
        "v04-c0139:p0028",
        "v04-c0139:p0039"
      ]
    },
    {
      "paragraph_start": 40,
      "paragraph_end": 47,
      "label": "钟震辅助与宗师死",
      "direction": "蓝血宗师见后裔死怒袭，被阮老琴发钟音迟滞，黄太冲剑气泯灭。钟由琴发非新钟法宝；黄单独原本吃力，合作增益不能记为单人轻胜。",
      "evidence": [
        "v04-c0139:p0040",
        "v04-c0139:p0047"
      ]
    },
    {
      "paragraph_start": 48,
      "paragraph_end": 60,
      "label": "何七与高叔旧怨赌约",
      "direction": "何七保留实力为白发者剑蛊符令，双方对旧争执各执一词。何指控用岛民作材，高反指何家夺庄；均保说话来源。提压半步公平比试，高允输告符令所在并全身化剑蛊，章末未胜负未得符令。",
      "evidence": [
        "v04-c0139:p0048",
        "v04-c0139:p0060"
      ]
    },
    {
      "paragraph_start": 61,
      "paragraph_end": 66,
      "label": "琅琊巩固与九指感应",
      "direction": "孟两日巩固已稳四重，拟阮事清楚后考虑真武疑冢，未赴。起身往阮府仍不明全局。另一院九指老者感祖神一缕气息身旁五同伴，身份未明、尚未袭阮，不与海沟高叔合人。",
      "evidence": [
        "v04-c0139:p0061",
        "v04-c0139:p0066"
      ]
    }
  ],
