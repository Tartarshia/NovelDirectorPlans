{
  "schema_version": 1,
  "chapter_id": "v04-c0168",
  "title": "第一百六十八章 宗师之威",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "f09bb015cc1d356ff6735f8481e9b54302c51ac7d1dbf661657d33f45ff8623d",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S18",
  "pov": "五人战宗师天兵，主材载返虚杀敌后强妖赶到",
  "attribution_caution": "先受伤与敌甲裂非敌伤分开；万物返虚本次确施，道传只融理念；伪镜对非妖不用，天心丹符未动。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 14,
      "label": "宗师压场",
      "direction": "天兵血动醒无迷茫怒斥邪魔，坠星相束缚孟且天地勾连断续发挥不足七成；这是敌法相压法理非禁飞直接封功。宗师由战斗叙述确认但具体重天未知。",
      "evidence": [
        "v04-c0168:p0001",
        "v04-c0168:p0014"
      ]
    },
    {
      "paragraph_start": 15,
      "paragraph_end": 32,
      "label": "首击与伙伴控制",
      "direction": "孟借束缚凝力、返虚技巧改进，法天象地开天仅勉挡被震险坠未落河。江抢隙刺盔裂未伤眉，阮钟震、齐混沌封、赵奉天改场仅迟缓弹指，三人防鞭难再控。",
      "evidence": [
        "v04-c0168:p0015",
        "v04-c0168:p0032"
      ]
    },
    {
      "paragraph_start": 33,
      "paragraph_end": 52,
      "label": "双刀双剑改日陨仍逊",
      "direction": "孟巨身增两臂，两对刀剑以返虚和道传理念改日陨前半；非已完整施第五。爆余焦阮一撮发，孟受皮肤割伤出血，敌盔碎甲裂本体未伤。江进步剑出无我仍被挡失衡，非平手胜。",
      "evidence": [
        "v04-c0168:p0033",
        "v04-c0168:p0052"
      ]
    },
    {
      "paragraph_start": 53,
      "paragraph_end": 61,
      "label": "江法相断未来与四人牵制",
      "direction": "太上剑君相无别有情非无情人格，观百家剑成一体。断未来挡腰斩，阮再钟、齐赵再出招短控，江未被斩断。",
      "evidence": [
        "v04-c0168:p0053",
        "v04-c0168:p0061"
      ]
    },
    {
      "paragraph_start": 62,
      "paragraph_end": 73,
      "label": "主材载万物返虚实用",
      "direction": "孟法天难久，大日焰心主要借重量而非完全催耗，配四人牵制实出万物返虚，戟弹半毁、天兵尸骨无存。敌真君猴子叫声不确证孟就是二者或已知来历。主材收回未毁，孟脱力恢复常身。",
      "evidence": [
        "v04-c0168:p0062",
        "v04-c0168:p0073"
      ]
    },
    {
      "paragraph_start": 74,
      "paragraph_end": 78,
      "label": "恢复未成与妖王赶至",
      "direction": "孟疑天兵长存机制未解，吞元气恢复中未满，黑袍金毛翼王被动静引来几如飞并非已破禁飞；疑阵延时效果被大战打断，未开下一战。",
      "evidence": [
        "v04-c0168:p0074",
        "v04-c0168:p0078"
      ]
    }
  ],
