{
  "schema_version": 1,
  "chapter_id": "v04-c0160",
  "title": "第一百六十章 地仙遗蜕",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "1fc230fe1b69fdbb43c711daf36c6df1dfa07e5987650e1c0d35867b58749655",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S16",
  "pov": "冰门诈开成功，分身与本尊揭示，潜入宝库外界",
  "attribution_caution": "紫电与紫雷称同一留源异称；操纵冰晶与自行睁眼紫电分开。高览韩广对话读者知情，不传递给潜入孟。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 19,
      "label": "飞月因假死与草原危机决援",
      "direction": "弟子六七窍只能报讯无资格叫门，飞月本已感曹泰登岛但守职。她知道萨满灭口，猜冲和陆大查曹，借阵眼确认陪京攻击后决定驰援；疑覆族不想到寻宝。",
      "evidence": [
        "v04-c0160:p0001",
        "v04-c0160:p0019"
      ]
    },
    {
      "paragraph_start": 20,
      "paragraph_end": 39,
      "label": "两遗蜕同池与开门交战",
      "direction": "冰眼两尸中古装，紫雷与冰晶皆无生机靠泉保力。曹娥观紫雷修自身，飞月操冰晶遗蜕，交阵曹娥开门。冲和分身袭，弹碎假曹泰血肉，发丝入门；曹娥非宗师未察。敌被退门关，飞月携遗蜕往陪京，不等杀掉分身。",
      "evidence": [
        "v04-c0160:p0020",
        "v04-c0160:p0039"
      ]
    },
    {
      "paragraph_start": 40,
      "paragraph_end": 44,
      "label": "旗效落实潜入",
      "direction": "毛发为孟本尊，微尘旗及天尊少许指导让分身化血肉、本尊化自己发丝，非孟真肉身被毁或全学三清。一次限旗本次已用；另获障目符实激活，本章补叙天尊回仙迹重兑，无余额数不虚记孟支出。",
      "evidence": [
        "v04-c0160:p0040",
        "v04-c0160:p0044"
      ]
    },
    {
      "paragraph_start": 46,
      "paragraph_end": 54,
      "label": "高览自述灭口与克制",
      "direction": "韩广劝不动免暴露，高览亲称杀金帐萨满，仍是其自述、未直接展示杀法。曹主紫电玉尺援阵。韩广称联手有希望杀灵宝且可能冲和，为评估非保证；高览因准备未妥克制，未亲出手。",
      "evidence": [
        "v04-c0160:p0046",
        "v04-c0160:p0054"
      ]
    },
    {
      "paragraph_start": 56,
      "paragraph_end": 71,
      "label": "变承轩与进入异界",
      "direction": "符只到冰眼附近，内禁不能过，孟变几日观察的曹承轩同冰玄劲应答骗过绝顶。循气机到冰魄寒乳池依真武法印进入水域殿阁，断壁与中央殿完好，引有人先来未破封的猜测，未取第五剑。",
      "evidence": [
        "v04-c0160:p0056",
        "v04-c0160:p0071"
      ]
    },
    {
      "paragraph_start": 73,
      "paragraph_end": 76,
      "label": "紫电遗蜕自行睁眼",
      "direction": "曹娥继续参照紫电肉身，忽见其自行睁眼射电惊惧。只能记异常，不确证复活、夺舍或幕后身份，冰晶遗蜕仍随飞月在外。",
      "evidence": [
        "v04-c0160:p0073",
        "v04-c0160:p0076"
      ]
    }
  ],
