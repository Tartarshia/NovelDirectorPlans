  "title": "第三百七十四章 救世",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "10e602e3563c0dae070196dea52a195b0aa7afe3274be33069badca04963cc9e",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S53",
  "pov": "反思所得风险并以留款准备开启救世任务",
  "attribution_caution": "赵六满为一年兑换结果非新法身；孟44020明未售20000不加入。传说队名与宇名不是成员境阶，六道35是另一队残响任务不面具领袖说。警30守者/37城警身份联系未明，41教主梦说不能认证救世降化身已成。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 5,
      "label": "广场回归与仙迹收入、树悟资源差异",
      "direction": "回聚年会孟叶实力面子散冲和低气；寄售38000已收约20000未售，言再悟获6000总44020当前明。未售不现金，言试第三梯未成，早80善差不凭新余额清零。",
      "evidence": [
        "v04-c0374:p0001",
        "v04-c0374:p0005"
      ]
    },
    {
      "paragraph_start": 6,
      "paragraph_end": 10,
      "label": "队友境阶与帝位收益的风险对照",
      "direction": "江剑身元神法相初连孟观刚八，阮五初赵五满。赵皇座进益北吞晋失位倒退是孟未来假设，映自己大能反噬命运风险，不未来已经发生。阮清冷气增、祖栽琴亲近待将来掌兵非琴已认主。",
      "evidence": [
        "v04-c0374:p0006",
        "v04-c0374:p0010"
      ]
    },
    {
      "paragraph_start": 11,
      "paragraph_end": 17,
      "label": "兑换一年与琴塔升级、主角选择留款",
      "direction": "四人熟练变物讨论克邪，赵2500兑一年后六重满余100，阮琴极品/上品塔，江12000购9900极品塔算余2100非本文明余额。孟九印六虚空刀剑神技入门、黑帝丹持无数，什么未兑留钱冰剑和中止备，非冰剑炼成。",
      "evidence": [
        "v04-c0374:p0011",
        "v04-c0374:p0017"
      ]
    },
    {
      "paragraph_start": 18,
      "paragraph_end": 23,
      "label": "救世主任务与队名扩宇名望规则",
      "direction": "六道告九幽潮封全部裂奖6000符败扣，第二死亡已过队名传说或梦话本致注意，未成员已传说。四人对望疑似早传奇是心理，影迁离场未着陆具体地。",
      "evidence": [
        "v04-c0374:p0018",
        "v04-c0374:p0023"
      ]
    },
    {
      "paragraph_start": 24,
      "paragraph_end": 32,
      "label": "洞穴告警与食粮生存体系",
      "direction": "未名外景守穴见雾苦怒叹麻木警魔潮入城，没人命名为旧敌。无小城镇田边聚点抢粮因饥也死，农男女老小抢未熟粱稻，警句32重引叙述不新全部农喊。",
      "evidence": [
        "v04-c0374:p0024",
        "v04-c0374:p0032"
      ]
    },
    {
      "paragraph_start": 33,
      "paragraph_end": 36,
      "label": "面具四人异任务切入",
      "direction": "紫薇星主、羲、北斗、西王母四面具废屋出现，耳似留六道破坏魔主传人计划，另队任务与传说队区别；面具不古神实体或个人新实名、不魔主传人已指谁。",
      "evidence": [
        "v04-c0374:p0033",
        "v04-c0374:p0036"
      ]
    },
    {
      "paragraph_start": 37,
      "paragraph_end": 42,
      "label": "城内有序应急与书生创教梦说",
      "direction": "城警是否同守者传来留未知，经验城众有序买粮，灾使信徒寄托。教主普通中年书生梦强四男女创救世四帝骗众聚财，41称昨梦预警与降化身彻灭为口而非已兑现神谕；四帝与主角关联待证。",
      "evidence": [
        "v04-c0374:p0037",
        "v04-c0374:p0042"
      ]
    }
  ],
