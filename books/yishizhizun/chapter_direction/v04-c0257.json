{
  "schema_version": 1,
  "chapter_id": "v04-c0257",
  "title": "第二百五十七章 不死药",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "933c12fca57130f3a97761ef23a6a2cbe4ad245d8608b656fb132239fe515082",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S28",
  "pov": "药稍缓与知识强记、金丹实复巅峰、妖桃吞药及分身诱敌元心殿",
  "attribution_caution": "8部分恢复27服金丹全愈无晋境。玉虚金丹两枚服一封剩一、太乙分神未明取服、蟠桃仅剩盒实收未交齐，妖桃吞人参和盒空不死药数不明。鼎未收，铃未得；53-57为分身后揭，58真人59鞭出未中，杨扇仅将发。东极续账本章未解，影者无新现身。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 3,
      "label": "双宗师找不到改必经路守伏",
      "direction": "杨说建筑往其他殿必经在那里等，顾虽师兄少言听妹实改路，非逃宫或失感完全放弃。",
      "evidence": [
        "v04-c0257:p0001",
        "v04-c0257:p0003"
      ]
    },
    {
      "paragraph_start": 5,
      "paragraph_end": 11,
      "label": "静室强记十来种、药稍缓长肩臂离开",
      "direction": "时间急追敌/未来法身与宝被夺是孟忧非已取。强记墙诵十来妖灵，药稍缓虚弱伤后肩臂再长实站离，非此时全愈/已练36。离室无声，习惯选左不飞高防扇。",
      "evidence": [
        "v04-c0257:p0005",
        "v04-c0257:p0011"
      ]
    },
    {
      "paragraph_start": 12,
      "paragraph_end": 21,
      "label": "香助伤循丹房、分身探大多腐败与自带禁物",
      "direction": "丹房字义心映实检推入，运气或禁法影响主场是孟疑。药鼎固定联禁，格物多效流失腐泥；两瓶几盒自禁存留，分身探陷不本尊都触雷。",
      "evidence": [
        "v04-c0257:p0012",
        "v04-c0257:p0021"
      ]
    },
    {
      "paragraph_start": 22,
      "paragraph_end": 28,
      "label": "玉虚金丹二枚实服一封一、明确巅峰复归",
      "direction": "玉虚金丹古寿近几万/两不死炼是传闻，不实增长寿数。分身解禁闻香加愈，瓶两朱丹开泄效摄一吞并重封；27实尽伤峰值回，不突破新境或生死人已发生。太乙分神未闻效依名判断非疗未服。",
      "evidence": [
        "v04-c0257:p0022",
        "v04-c0257:p0028"
      ]
    },
    {
      "paragraph_start": 29,
      "paragraph_end": 45,
      "label": "妖桃出雷痕吸不死药、抢剩蟠桃给师叔树威胁",
      "direction": "怪桃吸人参果成干，几盒空由味判蟠桃昆仑不死非逐样数明；猫/仿说拟人不是人语。孟收唯一剩盒两个拳头蟠桃给齐未交，玉虚金丹剩一留消耗；用树晃威不真的吞桃，咿呀委屈桃再附圆雷痕。",
      "evidence": [
        "v04-c0257:p0029",
        "v04-c0257:p0045"
      ]
    },
    {
      "paragraph_start": 46,
      "paragraph_end": 52,
      "label": "药鼎收不易弃赶路、元心殿与九印消息",
      "direction": "实试收鼎非短功后离未得，丹房弟子非元始推。元心殿名猜传承，齐得姜消息一殿一印九印异悟与总纲关系，孟道一因果匹配猜不全九印已经会。",
      "evidence": [
        "v04-c0257:p0046",
        "v04-c0257:p0052"
      ]
    },
    {
      "paragraph_start": 53,
      "paragraph_end": 60,
      "label": "元心铃将到双宗师伏、真正孟另现抽鞭未中",
      "direction": "53-57前孟后60明是诱敌分身，未本尊又被掌命。殿开铃同齐说元心真意物但未得，顾梁掌领域吸分身、杨门扇将发；58本尊青衫另来59抽借鞭向杨仅出招未结果，60揭分身探陷诱敌，第二次火扇尚未实发。",
      "evidence": [
        "v04-c0257:p0053",
        "v04-c0257:p0060"
      ]
    }
  ],
