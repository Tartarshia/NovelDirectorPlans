{
  "schema_version": 1,
  "chapter_id": "v04-c0309",
  "title": "第三百零九章 极北之人",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "898441eb10f1a596d3f3c2c5a5b0a2f399c427a1c8a0c806bfcbd17dc093f97f",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S39",
  "pov": "北地陈刘与同境切磋、求援中断飞遁",
  "attribution_caution": "陈未30晋宗已5年不当前仍<30，刘27/28外景未婚妻。陈虎口伤击退未死，切磋不高杀同一。核炉比喻未新招全名。求援远流星未发者身份，孟未得陈踪迹，陈跟过去未实追至。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 14,
      "label": "冰谷师兄妹与北地封闭、伤复游历",
      "direction": "冰峡左壁两人陈阳吐火皮帽银袍似鳞、红裙刘关切。7陈说小伤日出复9刘认识<30成宗已5年、10她稳外景被拉南下遭逃宗险围敌不纠缠走。13–14北地游历污名形成背景不南方实际全恶。",
      "evidence": [
        "v04-c0309:p0001",
        "v04-c0309:p0014"
      ]
    },
    {
      "paragraph_start": 15,
      "paragraph_end": 30,
      "label": "武道多样向往与同境自信",
      "direction": "陈批冰元磁单调，16–17梦呓语向往天地多样。18刘师妹未婚妻27/28岁外景忧南高手，22陈说法身传承完整同境差可控23胜除老怪诸宗自信，25过去败因未见他功为陈推，26刘鼓励非客观同代排名。30待陈峰再回入冰雪仙宫是未来计划未已入。",
      "evidence": [
        "v04-c0309:p0015",
        "v04-c0309:p0030"
      ]
    },
    {
      "paragraph_start": 31,
      "paragraph_end": 41,
      "label": "孟显身询画像、以切磋换踪迹",
      "direction": "陈感同气势欣好对手，孟先隐后辨非金帐/萨满公开问，34霜图现哈等，35陈称交过手不久要先切磋，未给踪迹。孟愿战右握刀难测、陈火球窍日力量，孟核炉比喻非真正科技炉。",
      "evidence": [
        "v04-c0309:p0031",
        "v04-c0309:p0041"
      ]
    },
    {
      "paragraph_start": 42,
      "paragraph_end": 54,
      "label": "刀棍硬碰压制与陈内心震动",
      "direction": "孟天之伤近身陈长棍正劈，寒冰崖塌蘑云冲孟无异陈屡伤被逼退，51双手抖52刀招玄妙53怕快输54骂牲口内咬底牌。陈尚未死/兵碎；第一次这种敌感不解所有天下排名。",
      "evidence": [
        "v04-c0309:p0042",
        "v04-c0309:p0054"
      ]
    },
    {
      "paragraph_start": 55,
      "paragraph_end": 59,
      "label": "熔炉域失效、火球合体与击退",
      "direction": "陈高温域孟淡金不吃、火球入体合窍力全铜棍喊开，孟膨躯返虚刀劈，59陈倒飞虎口血，是切磋失利可见未残臂死亡或具名新境招。",
      "evidence": [
        "v04-c0309:p0055",
        "v04-c0309:p0059"
      ]
    },
    {
      "paragraph_start": 60,
      "paragraph_end": 65,
      "label": "求援打断问话、孟东北飞遁与陈追意",
      "direction": "孟待问远流星求援，陈满挫报尊名我极北未完孟飞东北。64陈喃完整名痛与狂热65跟过去是意愿/内决不已追到。求援人原因未给，孟未得踪迹也未已救援战果。",
      "evidence": [
        "v04-c0309:p0060",
        "v04-c0309:p0065"
      ]
    }
  ],
