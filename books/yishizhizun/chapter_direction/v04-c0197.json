{
  "schema_version": 1,
  "chapter_id": "v04-c0197",
  "title": "第一百九十七章 走到哪里都不平静的男人",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "971abce81786b221762c522cd90085b90a8dc15765d1fbc17c9348fc788f108c",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S19",
  "pov": "未来推测促探索、顾下跃法身探门与大道树实吸震界",
  "attribution_caution": "未来诸景与霸王刀妖圣枪均孟推形似，不按既定结局。古符余1没再用，正在恢复消耗不是背伤已治。根实际接触吸取引震，三法身认知不知道孟原因，门杨戬文字不证明人到场。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 25,
      "label": "多未来解释与避羲探索",
      "direction": "孟恢复古符消耗，推来世镜残气照不定未来，悲僧矛死等不可取，刀似霸王绝刀但非终局；想辨幕后从棋子到棋手，近行仍不清。见玄袍大概识羲躲，羲熟悉布局为孟推，转向今生树根求吸尚未实行。",
      "evidence": [
        "v04-c0197:p0001",
        "v04-c0197:p0025"
      ]
    },
    {
      "paragraph_start": 27,
      "paragraph_end": 29,
      "label": "顾跃来世残处与暗眼疑果",
      "direction": "顾停来世处思后实跃，飘带兜气而非恢复飞行；虚空眼形似法王内语疑果古怪，观察来源暂按法王关联留身份疑问。未描顾到孟或分果。",
      "evidence": [
        "v04-c0197:p0027",
        "v04-c0197:p0029"
      ]
    },
    {
      "paragraph_start": 31,
      "paragraph_end": 52,
      "label": "高斩树未得，三法身入灰殿试门",
      "direction": "高拳脚剑只留树浅伤，韩看作主材未收；三人经甬道实入时空异常灰石殿。韩猜搬天层及最上两层通路不确，碑不入传说不进此门是文字。高实挥人皇剑斩门，结果后段未破。",
      "evidence": [
        "v04-c0197:p0031",
        "v04-c0197:p0052"
      ]
    },
    {
      "paragraph_start": 54,
      "paragraph_end": 63,
      "label": "孟取出大道树接根实际吸取",
      "direction": "孟猜今生根基搜树及镜碎，实见丑根取树贴吸混沌。洞大树先抽广布枝叶非立刻全枯；桃园树枯刑台腐塌天地摇云裂，没有新枝成果或碎镜得手描述。",
      "evidence": [
        "v04-c0197:p0054",
        "v04-c0197:p0063"
      ]
    },
    {
      "paragraph_start": 64,
      "paragraph_end": 69,
      "label": "崔未进漩涡，高失败误猜及碑署",
      "direction": "崔队正要入漩涡见加速异常未描进入；高收剑门无伤，三法身不知震因，高疑自己剑而非客观原因。碑角玉虚杨戬字是署名线索，未见杨本人或证明整个移层者。",
      "evidence": [
        "v04-c0197:p0064",
        "v04-c0197:p0069"
      ]
    },
    {
      "paragraph_start": 71,
      "paragraph_end": 73,
      "label": "吸树失控感与再惹变动",
      "direction": "孟目瞪口呆树疯吃，忧又引不妙变；未完成吸取、逃脱、树升级或九天全毁。",
      "evidence": [
        "v04-c0197:p0071",
        "v04-c0197:p0073"
      ]
    }
  ],
