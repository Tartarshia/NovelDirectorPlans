  "chapter_id": "v04-c0129",
  "title": "第一百二十九章 内部有应好成事",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "e558dda685fac488d60e98029d87724a574f5fca548efcbf215754d943a95a91",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S14",
  "pov": "镜言战场转孟本体，再柳漱玉内心及玄女行动",
  "attribution_caution": "癸水阴雷已消耗，发丝分身碎；山河图藏身未明触发杀伐末次，不扣次数。真商水129实见存活；流罗称呼与柳身份不扩写后期真相。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 23,
      "label": "阴雷袭击与分身销毁",
      "direction": "镜言外景，分身低本体一个大境，需五重秘宝癸水阴雷造真实威胁。镜言抓两炉鼎挡雷，二人被雷吞杀，不能省代价。欢喜宗主来非玄女，压灭雷威；本体操控分身主动投残雷化发碎灭，未被擒。",
      "evidence": [
        "v04-c0129:p0001",
        "v04-c0129:p0023"
      ]
    },
    {
      "paragraph_start": 25,
      "paragraph_end": 35,
      "label": "封界而非调离",
      "direction": "玄女留守，认为欢喜可负责，先启阵封界防声东击西。孟按备选计划佯惊带乱男弟子，非真崩溃。",
      "evidence": [
        "v04-c0129:p0025",
        "v04-c0129:p0035"
      ]
    },
    {
      "paragraph_start": 36,
      "paragraph_end": 59,
      "label": "柳漱玉内应与真身替换",
      "direction": "孟认柳漱玉，推应身；顾称流罗，柳查众留孟。传音令动，放真郭喜商水，孟入图顾入袋，柳收两物再秘法遮精神受控。内应由叙述明确，柳闪狠意被既有契约压住，不等自愿忠诚。",
      "evidence": [
        "v04-c0129:p0036",
        "v04-c0129:p0059"
      ]
    },
    {
      "paragraph_start": 60,
      "paragraph_end": 69,
      "label": "封锁完成与过检",
      "direction": "玄女扫魂兼查物，柳持图袋不在受查男弟子身上是关键；精神控制遮掩奏效，玄女赞柳转搜他处。不因过检写玄女愚笨或不查储物。",
      "evidence": [
        "v04-c0129:p0060",
        "v04-c0129:p0069"
      ]
    },
    {
      "paragraph_start": 70,
      "paragraph_end": 75,
      "label": "归还秘宝与饰石前往",
      "direction": "柳放孟顾、收真商水留真郭喜，还图袋。孟石变化为柳饰物，柳借混乱有理由往素女殿；平时不可入。止于殿前推进，不写观刀完成或解因果。",
      "evidence": [
        "v04-c0129:p0070",
        "v04-c0129:p0075"
      ]
    }
  ],
