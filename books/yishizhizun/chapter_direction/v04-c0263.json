  "chapter_id": "v04-c0263",
  "title": "第二百六十三章 突如其来的恶意",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "6a925d7c66f6ba24ba71b0341ed361c34e4192b2fdadec9ba7d4ebbcc971898d",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S31",
  "pov": "供词审慎核验、跨界问讯与神兵任务恶意规则下的自主决心",
  "attribution_caution": "陆压只是可能元心皮毛读恐惧不测真，道果根据说/理解；借款实际六万付出、问300余15；神兵任务已接受未完成，一年相持、放弃惩罚未执行、用主材降品阶。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 13,
      "label": "九娘不熟陆压、根论道果皆带转述理解",
      "direction": "九娘故事式旧闻非知陆压能力境阶，根4离火精昊天子等自供、或近道果为猜。8自己不清偶尔听据说9按己理解，不能把夸无所不能当当前全宇宙精确规则。孟出租车比喻心内不实际有司机。",
      "evidence": [
        "v04-c0263:p0001",
        "v04-c0263:p0013"
      ]
    },
    {
      "paragraph_start": 14,
      "paragraph_end": 21,
      "label": "追问矛盾、妖桃威慑与元心读情未证真",
      "direction": "孟反问护门怎怕六道根语塞，雷痕桃探半身根蜷惊。18元心实观察19恐惧无狡念感，却承认仅皮毛可能瞒，20姑且信非完全认证。妖桃无词不新拟人声说药价值。",
      "evidence": [
        "v04-c0263:p0014",
        "v04-c0263:p0021"
      ]
    },
    {
      "paragraph_start": 22,
      "paragraph_end": 33,
      "label": "陆压仅可能、跨界规则询九娘而非已问灵宝",
      "direction": "孟23有一定可能、七箭标志为其知识；九娘24抹杀靠七箭是假设。25找隐道门仅未来、白芒似斩仙刀是回忆推非新交战。九娘27封神西游屏障与宠契或轮回身份办法属说法，楚挪别宇宙可否外界不知，32建议问六道。",
      "evidence": [
        "v04-c0263:p0022",
        "v04-c0263:p0033"
      ]
    },
    {
      "paragraph_start": 34,
      "paragraph_end": 38,
      "label": "六万借款落实、原315与问讯扣300、封神异宇宙解释",
      "direction": "实抵押借55000加信誉5000=60000，原315现明。问消息30036六道说封神特殊需符或时光长河离开，38孟归因先前挪仍封神异宇宙，暂不能邀齐、去森罗看云鹤突破仅计划。消息后自款15，借款尚未花到39。",
      "evidence": [
        "v04-c0263:p0034",
        "v04-c0263:p0038"
      ]
    },
    {
      "paragraph_start": 39,
      "paragraph_end": 43,
      "label": "实付六万领取神兵任务、正道一年相持成为先决",
      "direction": "39真正付60000，40任务古尔多突破斧醒为六道公布背景，要求帮助正道至少一年相持不溃败，成功才神兵自定形名；失败扣两成善功但未实际失败基数未详不强填12000。孟41感恶意42保障和任务倒置死循环，未炼成。",
      "evidence": [
        "v04-c0263:p0039",
        "v04-c0263:p0043"
      ]
    },
    {
      "paragraph_start": 44,
      "paragraph_end": 53,
      "label": "放弃新惩罚只咨询、可继续用主材但品阶降、实接受任务",
      "direction": "六道45称刚兑换放弃扣所有善功并禁本人及他人代兑一年，九娘46过去没见47称新规48同感恶意。49孟联玉虚回归与新规为疑并冷静问主材50可用但最终品阶降，51接受任务没放弃故惩罚未执行。52争执无用53尽早脱轮回是孟内决心，不已脱离。",
      "evidence": [
        "v04-c0263:p0044",
        "v04-c0263:p0053"
      ]
    }
  ],
