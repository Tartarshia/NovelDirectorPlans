  "title": "第二百二十七章 无耻小孟",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "b39ba9914bac21a41fd899346938a9bfd9adebeb194ef2c19206f93156a6d764",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S22",
  "pov": "苗临半步寿衰死、孟落红尘幻与真实伤、闻敌扣功",
  "attribution_caution": "刘死苗死六道和执念散明确，临八息半步非日常境。孟血泥是幻、真实喷血伤重体魄好转丹未服，玄龟防实催法天消元神遁是术不是永久脱体死。六道敌扣1000/3000非己方到账；江偷袭线未后续。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 6,
      "label": "敌阵刘死扣功、闻景准备援西丘",
      "direction": "江船闻等听六道刘被义军轮回击殺每敌扣1000，明确刘死、闻同敌轮回。闻自猜苗失援或受陷希望狂攒善功，虚招牵冯维阵抽离准备队友援，未已抵西丘。",
      "evidence": [
        "v04-c0227:p0001",
        "v04-c0227:p0006"
      ]
    },
    {
      "paragraph_start": 8,
      "paragraph_end": 33,
      "label": "招境解释、苗临近半步力裂虚与孟开天",
      "direction": "孟精准抢机打断苗，纯阳请教冲和功法境/招境/心境区别是回述不道人当场来。孟招初宗师功六，苗临巅欠招心；五息苗接近半步全力碎虚薄弱也难及，孟附臂斩玉开天虚天地挡六息，失动苗锁。苗笃最后半步可杀有延寿时间为其想非已服丹。",
      "evidence": [
        "v04-c0227:p0008",
        "v04-c0227:p0033"
      ]
    },
    {
      "paragraph_start": 34,
      "paragraph_end": 49,
      "label": "金莲接地、玄龟护身与唯我落红尘",
      "direction": "孟天伤戊土流火己土刀剑金莲摊力七息口血，续玄龟催甲挡身开始收法天失效。元神迎风遁虚佛声唯我扰苗，第八息苗实半步镇念孟乘隙元神掌刀落红尘，非孟晋半步或新肉身死。",
      "evidence": [
        "v04-c0227:p0034",
        "v04-c0227:p0049"
      ]
    },
    {
      "paragraph_start": 50,
      "paragraph_end": 59,
      "label": "血泥是假、真伤九息与苗寿骤尽残念",
      "direction": "苗疯扫幻见孟血泥西丘毁；九息恢复真孟被扫喷血不轻伤未死，幻时疯狂阻偷袭。苗信余一息更强忽惊孟说无该息寿尽，58元神散气消残执念说疑，不敌巅峰十息自然胜。",
      "evidence": [
        "v04-c0227:p0050",
        "v04-c0227:p0059"
      ]
    },
    {
      "paragraph_start": 60,
      "paragraph_end": 71,
      "label": "孟两臂揭寿衰策略、残执念消散死成",
      "direction": "孟解释本可早逃接齐而选择僵持逼寿按息，蟠园崩天地寿持续衰减长寿少显短寿一次跳尽。苗问如何知孟说我做、体魄实伤好转仍无东极。苗骂无耻误以硬汉孟行礼、苗倒执念灭死亡确，不普通降境还能活。",
      "evidence": [
        "v04-c0227:p0060",
        "v04-c0227:p0071"
      ]
    },
    {
      "paragraph_start": 72,
      "paragraph_end": 75,
      "label": "闻景一木渡江途中六道苗死扣功",
      "direction": "闻一木渡试绕帮苗不让走脱，六道苗死每敌扣3000，本人震差点落水未真落/死、未已到西丘。己加分未报告，不能据敌扣直接改己余额。",
      "evidence": [
        "v04-c0227:p0072",
        "v04-c0227:p0075"
      ]
    }
  ],
