{
  "schema_version": 1,
  "chapter_id": "v04-c0305",
  "title": "第三百零五章 透露的消息",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "7a3a4eb04f742cc8308682273c8039cdc37aa20956ec30aa6cba4aca346a7053",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S39",
  "pov": "古史消息与反绝望、幕后齐线及出口截蓝血",
  "attribution_caution": "305身份间接承认与幕后齐线新证据仅今起生效不倒灌303。古史/全知是大自在口供，封印黑日实可见，受镇因/寿限是孟猜。高送盒内容未明、兰57确认死；孟不知齐水祖幕，末未杀高。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 12,
      "label": "止步问秘闻与隐秘面孔",
      "direction": "脚步将出门被问目的，4旁白说明间接承认大自在身份。孟停步再转身，口称好奇、内为摆脱古人因果求隐秘。邪转无五官黑脸，自报四面孔，说泄秘可能招过去未来诛仙剑抹杀；孟理解随口举例，不认证通天幕后或三清已对他出手。",
      "evidence": [
        "v04-c0305:p0001",
        "v04-c0305:p0012"
      ]
    },
    {
      "paragraph_start": 13,
      "paragraph_end": 19,
      "label": "魔主生死与彼岸消息、突然止谈",
      "direction": "孟问彻底陨落复生，邪回答除非天帝另有打算、烙印非复生，并说真武失踪后得机缘登彼岸，在机缘停顿不明说。孟联系真武恶念旧判断。邪闻危险拒再说，元心印也不换；仅消息交易没交资源。",
      "evidence": [
        "v04-c0305:p0013",
        "v04-c0305:p0019"
      ]
    },
    {
      "paragraph_start": 20,
      "paragraph_end": 33,
      "label": "离魔土、识破绝望诱惑与自争机会",
      "direction": "孟实际踏出魔土未救兰。邪用因果知谋/彼岸遍时空说辞挫信心，孟认天魔种阴影，对方承认伎俩；孟已调适，真心把握当下、努力不牵亲友。投影弱可能未醒/寿限/受镇是孟推测，29邪想嘲未说出口。孟不提甚至不想灰石殿玉虚宫，非真的无作用。",
      "evidence": [
        "v04-c0305:p0020",
        "v04-c0305:p0033"
      ]
    },
    {
      "paragraph_start": 34,
      "paragraph_end": 39,
      "label": "甬道从容外表与警戒、提炼信息",
      "direction": "已离域寒较弱，孟表面从容内戒，疑邪留此另有目的而先走。分析因果联系可知图谋/彼岸遍时空需慎，39是否暗掺棋为孟疑问，未读者全幕后知识送进其脑中。",
      "evidence": [
        "v04-c0305:p0034",
        "v04-c0305:p0039"
      ]
    },
    {
      "paragraph_start": 41,
      "paragraph_end": 45,
      "label": "高醒交水祖木盒、投影入裂缝",
      "direction": "邪转心魔相，高眼迷消失恭送黑木盒称水祖命送。邪摄过抚尘托问好，阴风裂魔气缝身影投入消失，魔土失极寒、兰仍呆。木盒内容用途、水祖身份未给；高旧失常是否全装也无独证。",
      "evidence": [
        "v04-c0305:p0041",
        "v04-c0305:p0045"
      ]
    },
    {
      "paragraph_start": 46,
      "paragraph_end": 55,
      "label": "封印黑日归银河与齐正言幕后",
      "direction": "魔界身影化黑焰封印大日，表层蒸发山凸，升入银河归魔龙不独眼。邪把已告苏孟消息报给星球最高峰炼污齐正言；齐问话，邪转述复生为夺舍表述，齐沉后许随实力解封，尚未解封完成/已传说。此幕读者见、孟未听。",
      "evidence": [
        "v04-c0305:p0046",
        "v04-c0305:p0055"
      ]
    },
    {
      "paragraph_start": 57,
      "paragraph_end": 60,
      "label": "高杀兰返回、孟守出口待战",
      "direction": "57直接明述高趁机杀兰遁回金帐，不能仍记兰存活或补杀法。高出甬道见孟坐帐顶巨刀泥插，孟右手伸刀柄沉凝，阮家关系除蓝血动机明确；只截堵尚未实际出刀、高死或新战利品。",
      "evidence": [
        "v04-c0305:p0057",
        "v04-c0305:p0060"
      ]
    }
  ],
