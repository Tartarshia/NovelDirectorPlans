  "chapter_id": "v04-c0287",
  "title": "第二百八十七章 双星",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "d956763b386f76ac2470cd099c7b46641517b17bad1de03ef2c2ebaa182c9003",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S36",
  "pov": "高王道介入与少林内患、孟放哈斯、苏出关双星变局",
  "attribution_caution": "高臣民广播脑声与何惊内声分开；大满死长生神未来可重诞非立即复活。玄心妖化无实名妖王，灰丑宗师和后手关系只外貌线未正式同名。孟接斩没果、苏出关没给晋阶。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 9,
      "label": "人皇剑玺王道串民心，北周同声脑响",
      "direction": "宫幻影不是诸真人新臣跪，剑历史旁白。高6/8同广播脑内无远近别、民感动念串真妙用，不全世界任意人心控制。高大周主为本人宣，当前效已实显。",
      "evidence": [
        "v04-c0287:p0001",
        "v04-c0287:p0009"
      ]
    },
    {
      "paragraph_start": 10,
      "paragraph_end": 36,
      "label": "斩六灭像合何杀大满、臣民处皆高再赴宿敌",
      "direction": "六灭先破郡城阵，高数十万里实像救城斩像化骨，不杀灭門全宗。再临大满领域以神相克斩天界、何逼替后真身高杀，藤杖制住非另卖。大满死长生神不死香火重诞未来。何内惊崔陨、34高宣八方王道民处可至35确妙用，36过北周晋边以身剑往宿敌未已相击太离。",
      "evidence": [
        "v04-c0287:p0010",
        "v04-c0287:p0036"
      ]
    },
    {
      "paragraph_start": 38,
      "paragraph_end": 47,
      "label": "少林防守分工与玄心妖身白光彩幡撼塔",
      "direction": "空慧暗伤控阵无思无妄帮、空见十年面壁暂放巡防、无净仍关、玄悲涅槃空相枯禅未叫。玄心胖身变化九尺白毛双翅葫芦白光五彩幡发动群妖，白泽存是空慧惊问未名化本体等玄心。达摩舍利阿难刀实控塔镇妖未全逃/少林破。",
      "evidence": [
        "v04-c0287:p0038",
        "v04-c0287:p0047"
      ]
    },
    {
      "paragraph_start": 48,
      "paragraph_end": 62,
      "label": "韩带丑灰发潜门杀守僧，义子承诺与提升自身内意",
      "direction": "韩真来少林非玄天，握迟时缝二人入阵恢、秘道红枯外景僧被拍粉死未实名。情义善仁门前令魔功开事后还义子灰者叫宗主，只令未开/还。外貌似旧后手可能勿无直接指同就实名或否顾排除当绝事实。62内心微哂引用是韩内意非公开自白。",
      "evidence": [
        "v04-c0287:p0048",
        "v04-c0287:p0062"
      ]
    },
    {
      "paragraph_start": 64,
      "paragraph_end": 65,
      "label": "孟荒山放出哈斯长刀接袭",
      "direction": "孟不知破空位置具体荒岭无强气、袖快爆实甩出哈斯刀斩，未命中/杀或伤已恢复。旧破空0不又耗、哈斯脱袖改相战未新擒结果。",
      "evidence": [
        "v04-c0287:p0064",
        "v04-c0287:p0065"
      ]
    },
    {
      "paragraph_start": 67,
      "paragraph_end": 75,
      "label": "江守秩序见流星，苏出关授理放昊镜片",
      "direction": "江门内防乱、苏69耳熟声说崔死70江真见苏出关青无物、71感慨不求全72镜片实出73映幻宇宙。江75口认昊天镜片是依据孟旧闻，不苏本章已正式法身晋境宣/获完整昊天镜。",
      "evidence": [
        "v04-c0287:p0067",
        "v04-c0287:p0075"
      ]
    }
  ],
