  "chapter_id": "v04-c0293",
  "title": "第二百九十三章 打开封印的办法",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "91ba84b694265315f4895ad53937e9ce67ef1c60e37515212fe950edf48003e9",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S37",
  "pov": "战果获知、他我两路与阿难真封印推理",
  "attribution_caution": "叶暂掌需成员确认未全仪式，复活搁置任务未做。苏陆传说特征各一隅不真传说；曹献心理两猜无法证、高金书分享有来源层次。孟开的是衍体门真封另限，逆易筋魔开猜未实测、找段命未到；天榜重排未公布。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 4,
      "label": "叶暂掌须成员确认、返庄查战局与复活任务搁置",
      "direction": "孟看叶实力境兵位与松散互助风格相信无人反，但要召正式成员确认未投票。暂掌实生效、两人匿返回庄，复活天尊特定任务无人实力只能搁，孟疑复活是否本人/受控/次数未证；专兵一年六道不会提前结为孟估，未已结算。",
      "evidence": [
        "v04-c0293:p0001",
        "v04-c0293:p0004"
      ]
    },
    {
      "paragraph_start": 6,
      "paragraph_end": 16,
      "label": "陆出关解苏正统沟通他我与自身相反道路",
      "direction": "陆伤不重已出，孟7听得完整苏斩蒙夔退三法战果。陆10/11沟他我证自我本质高如九天宇宙覆盖，非传说阵/高层秘境难隔、所沟他我存本我难真正死，是陆讲机制不无限所有宇宙全境无条件。13不圆满状态短要恢复许久，15陆唯我微结构不无处不在/不死、真正传说各得一隅，16孟口悟不自行新晋。",
      "evidence": [
        "v04-c0293:p0006",
        "v04-c0293:p0016"
      ]
    },
    {
      "paragraph_start": 17,
      "paragraph_end": 35,
      "label": "曹近半草宗摧毁、献头怨的两猜、存根基金书报与天坛",
      "direction": "陆转报曹爆近半草宗战力并肯曹忠高，孟猜公子献头后曹怨也许六道背正任务主动牺又猜危急迫，25心理无法证。叶问两宗加蜕代价陆27家还有一蜕兵存折宗不足半根基在，高应该得金书分享为陆推配何出手信息相当确定非授书现场。32七页直指半道果宝典作者说明，31旧两功源/融合孟估。34家天坛祈警高可感周地剑玺瞬移是陆从何信息报，曹仍无法身。",
      "evidence": [
        "v04-c0293:p0017",
        "v04-c0293:p0035"
      ]
    },
    {
      "paragraph_start": 36,
      "paragraph_end": 52,
      "label": "孟此时知空死师涅槃、封印区别与逆易筋推理找段瑞",
      "direction": "陆报少林变孟悲喜，37守僧韩杀净土进过为空慧等怀疑，韩读者线已有筹谋成功但不倒给少林全知。40–43真达摩封印和衍体法身痕折映不同，衍近无只有门特性，孟以前刀法开的是衍门，真手持阿难兵非全醒不能破。孟46–50忆段义父老和尚易筋外泄逆魔邪达摩，猜魔可开封51告陆52尽快找段瑞为行动命，未已找到/测试/韩灰实名或段义父证。",
      "evidence": [
        "v04-c0293:p0036",
        "v04-c0293:p0052"
      ]
    },
    {
      "paragraph_start": 54,
      "paragraph_end": 56,
      "label": "神都司马石轻快命天榜重排",
      "direction": "神都六门朱衣金章匿名见司马轻愉56吩咐多法身陨天榜重排，未新完整名单精确名次或轻快全部政治动机明说。",
      "evidence": [
        "v04-c0293:p0054",
        "v04-c0293:p0056"
      ]
    }
  ],
