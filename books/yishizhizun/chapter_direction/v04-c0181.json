{
  "schema_version": 1,
  "chapter_id": "v04-c0181",
  "title": "第一百八十一章 隔岸观火",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "cfececa60ee658477dd2e0fbb9323fde3b757c245c6aca98175aeb084b548985",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S19",
  "pov": "旁观客院暗流、护家警戒与赵外围合作",
  "attribution_caution": "赵未认孟、元始为表层身份；监视约四非四个势力确名。正式邀改外围同意，孙名自报来源明确，师弟状态只引用当下转述。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 14,
      "label": "旁观心态与同院隐强",
      "direction": "孟不去安泰楼不探人潮，借契约才可能入局。客院木簪道士、红裙女表开窍被孟认为藏强，具体名境未知；孟读高庄道德经因不信六道未送鉴。",
      "evidence": [
        "v04-c0181:p0001",
        "v04-c0181:p0014"
      ]
    },
    {
      "paragraph_start": 16,
      "paragraph_end": 38,
      "label": "苏妹受监与保护安排",
      "direction": "翌日孟拟暗见妹顾，邻客分路向安泰后回看他似释疑。妹外貌成长、孟近五步感约四监互不属，势力名猜未查；避见不动手，拟2-3年实力够再除患。送信告家、约束妹并拜托王伯父等措施做完回客，不等监视撤除。师未涅槃弟仍眠、空闻说似大梦总纲可能，不是都已好。",
      "evidence": [
        "v04-c0181:p0016",
        "v04-c0181:p0038"
      ]
    },
    {
      "paragraph_start": 39,
      "paragraph_end": 43,
      "label": "女子避道人而孟暗观",
      "direction": "更夫报夜，女轻功只开窍因大阵监动作；见道人饮酒改回房，误以孟睡，实际孟黑暗窗边观看，彼此真目的未解。",
      "evidence": [
        "v04-c0181:p0039",
        "v04-c0181:p0043"
      ]
    },
    {
      "paragraph_start": 45,
      "paragraph_end": 59,
      "label": "值守日化元始招赵",
      "direction": "又一日袁值守，赵房禁开才有隐私，孟黑袍元始面具眼信物潜入。赵认仙迹不认孟真实身，以为来者实力可越监；孟介绍正式条件并请放位换自由，尚未赵接受。",
      "evidence": [
        "v04-c0181:p0045",
        "v04-c0181:p0059"
      ]
    },
    {
      "paragraph_start": 60,
      "paragraph_end": 67,
      "label": "赵不弃位而外围达成",
      "direction": "赵解释人道新惊世书随位快修，登帝破桎梏还须真皇玺等辅助，这是计划未登帝。拒弃皇太弟，主动提无称号只兑换的外围，以朝内帮忙替任务，孟同意；非正式称号成员已授法。",
      "evidence": [
        "v04-c0181:p0060",
        "v04-c0181:p0067"
      ]
    },
    {
      "paragraph_start": 69,
      "paragraph_end": 71,
      "label": "孙越秀受伤撞入求助",
      "direction": "孟回院思同伴隐面，女跌入房脸白自报碧月孙越秀，求疗伤及清外血迹并允明日厚报。未见敌追、孟未答未清，不能记已救或已收报酬。",
      "evidence": [
        "v04-c0181:p0069",
        "v04-c0181:p0071"
      ]
    }
  ],
