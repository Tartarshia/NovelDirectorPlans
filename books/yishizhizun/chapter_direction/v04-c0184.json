{
  "schema_version": 1,
  "chapter_id": "v04-c0184",
  "title": "第一百八十四章 如是我见",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "38858a15224e91e1574a074052c28d7df43b4d8b9a3b976c6e613d0e181a6a4e",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S19",
  "pov": "孟决定护棋引韩、孙越秀观战重估公子",
  "attribution_caution": "对白内心及孙的惊叹分清，神都限制使交手如开窍不等修为倒退。法身以下无敌有条件和例外；逼退不是杀死，白冲被抓不是得图，紫薇表面称号不揭真实姓名。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 10,
      "label": "限制条件下作出决定",
      "direction": "孟自评禁天地力可抗多数宗师半步，曹献之类例外，法身质变仍不能敌。顾说韩露面即弃白冲退，孟拟激阵亮身份借正道保护；崔暗藏为其计较未现场见。袁准备多半赶不及亦猜。孟实决定调息顾持箫。",
      "evidence": [
        "v04-c0184:p0001",
        "v04-c0184:p0010"
      ]
    },
    {
      "paragraph_start": 11,
      "paragraph_end": 29,
      "label": "白冲出现与舟上公子出手",
      "direction": "孙任扮闺秀候人，孙认白冲乔装骑马。任传音静观，四无名剑客先攻白冲；顾箫声引孙注目，孙认此前公子，孟肉身跃河上岸，任低语好强。孙惊为观战焦点非识出狂刀。",
      "evidence": [
        "v04-c0184:p0011",
        "v04-c0184:p0029"
      ]
    },
    {
      "paragraph_start": 30,
      "paragraph_end": 45,
      "label": "硬破三人再逼自在天魔",
      "direction": "银饰婆、书生、糖杆老头同伙两绝顶一宗师，孟拳击笔令书生虎口血，饰反弹撞飞宗师，三人未报死。任点阴影能力孙悟自在天魔，孟实拔龟纹剑逼退，未消耗法宝或斩杀。",
      "evidence": [
        "v04-c0184:p0030",
        "v04-c0184:p0045"
      ]
    },
    {
      "paragraph_start": 46,
      "paragraph_end": 60,
      "label": "分水刺被挡杀神剑被退白冲被抓",
      "direction": "孙认分水刺暗光敌为此前袭她者但真名未得。孟背剑挡后借力退刺，迎蓝阶杀神剑以极速多残影压退非万剑归宗命名。禅意左掌穿防抓白冲脑门，未杀白冲或得地图。",
      "evidence": [
        "v04-c0184:p0046",
        "v04-c0184:p0060"
      ]
    },
    {
      "paragraph_start": 61,
      "paragraph_end": 69,
      "label": "紫薇交锋与半阙观战收尾",
      "direction": "孙识紫薇面具星光为元神幻觉，孟一手抓白冲沉剑接拳，劲风波及外景、断树河奔马瘫喷血。孟仍提白冲剑横胸对峙，紫薇未败亡，韩广未出现。箫不到半阙，孙回顾多境围攻震撼不写孟正式升阶。",
      "evidence": [
        "v04-c0184:p0061",
        "v04-c0184:p0069"
      ]
    }
  ],
