{
  "schema_version": 1,
  "chapter_id": "v04-c0258",
  "title": "第二百五十八章 老母",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "f9e5e71132bfd7e4fedc1526003ca43a2b0fafb0351c810076c0326e454617da",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S29",
  "pov": "元心铃实得、敌草人真名追踪与虚空无极空殿中的无生老母声音线索",
  "attribution_caution": "11被碎诱身非真人，24本尊实摄铃未全悟元心。杨重伤未死，神兵扇仍在未毁；33/34离火药用剩2，草人吸血追踪实杨死出宫为将来威胁。孟轻伤六七成未晋，大日蓝血残火消、金丹本章无需未服。虚空无极传承缺、先人路径/取双印斩过为孟推，自称老母声音非确定当下到场；无极探后本尊/分身切换未细明。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 11,
      "label": "鞭锁杨离火白芒回防、抽扇重伤与诱身碎",
      "direction": "本尊鞭金身84印定杨，她离火焚印眼白芒使孟神僵鞭慢回扇实发，鞭再灭焰抽扇身杨重伤骨碎殿完好。分身触铃无陷后被顾掌碎，不本尊死/伤、扇本体未明碎。",
      "evidence": [
        "v04-c0258:p0001",
        "v04-c0258:p0011"
      ]
    },
    {
      "paragraph_start": 12,
      "paragraph_end": 23,
      "label": "顾救师妹重域、孟法天返虚互撞双方伤",
      "direction": "顾顾不上铃，怒死声加域慢刀杨闪，孟随变大破束。顾双掌绕暗涡吸坍孟，孟天伤万物返虚内景凝针碰涡，双方撕裂血泥反震，杨余风抛再骨损，殿仍无损。",
      "evidence": [
        "v04-c0258:p0012",
        "v04-c0258:p0023"
      ]
    },
    {
      "paragraph_start": 24,
      "paragraph_end": 31,
      "label": "本尊实收元心铃、杨追背刺借力再逃",
      "direction": "孟借余刀半弧越顾实际摄铃侧门走，杨离火长虹剑火追；孟前遁糅阴阳不死，玄磁被穿背刺火血却速增甩杨，顾域来迟。无需本章再破空/地磁符，不鞭在此再打顾。",
      "evidence": [
        "v04-c0258:p0024",
        "v04-c0258:p0031"
      ]
    },
    {
      "paragraph_start": 32,
      "paragraph_end": 40,
      "label": "离火药剩两、草人苏子远血吸追踪抄道一",
      "direction": "顾闷声跑杨师药服调稳定伤，离火奇珍引余2明确非初始总量。剑血残肉草人头足灯苏子远实名非公开别名，涂吸血光顾借推行踪追杨休；咒将不能活出是杨威胁未已死效果。抄道一改线实，未到伏地。",
      "evidence": [
        "v04-c0258:p0032",
        "v04-c0258:p0040"
      ]
    },
    {
      "paragraph_start": 42,
      "paragraph_end": 52,
      "label": "伤不重五剑残火、大日蓝血消、虚空传承空",
      "direction": "伤总体轻补益选其他伤药无需剩金丹，背五紫青火真元精神燃残，连大日蓝血真消。实六七成拔发分身探本尊隐，虚空殿台空令牌缺不取，先人路线年份推，收慢分身再左行。",
      "evidence": [
        "v04-c0258:p0042",
        "v04-c0258:p0052"
      ]
    },
    {
      "paragraph_start": 53,
      "paragraph_end": 61,
      "label": "借双功过禁、无极再空与旁路先人推",
      "direction": "元始八九过几禁至混沌殿，仅門匾清无极。分身推门查伏，不贪乱入；台空真见，无极传承未得。经侧门虚空无极而未元心路线为孟想象推，沮丧继续求其余印。",
      "evidence": [
        "v04-c0258:p0053",
        "v04-c0258:p0061"
      ]
    },
    {
      "paragraph_start": 62,
      "paragraph_end": 68,
      "label": "沧桑微弱声自称老母、因双印推斩过去赴道一",
      "direction": "上方混沌声音穿万古自称今为无生老母，声音实听但源主体未名不老母此刻亲临。孟忆无生无/真空终/罗教虚空而猜大能得双印顿悟斩过去，非已完全揭真实出身。记事出侧门换道一、诸果因内望，未道一到手。",
      "evidence": [
        "v04-c0258:p0062",
        "v04-c0258:p0068"
      ]
    }
  ],
