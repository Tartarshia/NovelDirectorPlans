{
  "schema_version": 1,
  "chapter_id": "v04-c0193",
  "title": "第一百九十三章 三生殿",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "8ef92f224d0722945f724b537b74e5f7042ad77ecf0a861b67f837e156d12f77",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S19",
  "pov": "三生追及、晏然应身口供与高览挡韩认兄弟",
  "attribution_caution": "应身晏然来自顾对玄女传人问讯并非现场历史，文字催镜操作者未直接明。高实际挡韩与兄弟称呼已实，不代表疯态永久、韩同意结拜或宝契完。孟背伤未疗材料未用。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 25,
      "label": "快逃与池水限制、疯王情伤情报",
      "direction": "桃探回未收，孟顾不停赶。顾说收池水须仙灵玉净瓶六道缺且要手舀危险，未取。孟向顾说疑高和其他法身可能及滑翔备选，顾讲晏然晏庶女水月首徒真实出色但玄女应身己问受控传人得知。孟心怜厌情为磨砺，两人左岔去三生。",
      "evidence": [
        "v04-c0193:p0001",
        "v04-c0193:p0025"
      ]
    },
    {
      "paragraph_start": 27,
      "paragraph_end": 33,
      "label": "法王实退与韩高同左",
      "direction": "三剑两刀法王不支融空逃追孟顾拟随卷宝未得，未死。韩高过路到池数息至岔，韩天帝功莫名预感选左高随，追法实际前行。",
      "evidence": [
        "v04-c0193:p0027",
        "v04-c0193:p0033"
      ]
    },
    {
      "paragraph_start": 34,
      "paragraph_end": 52,
      "label": "紫雷文字触情与韩防中计",
      "direction": "二段雷字因缘自我她真情内容，作者没现场署名不可指定哪人写。高为她找理受动，韩不明原话亦识心漏提醒，高冷表有分寸之后不看余字追，未文字阶段已人格全部转。",
      "evidence": [
        "v04-c0193:p0034",
        "v04-c0193:p0052"
      ]
    },
    {
      "paragraph_start": 53,
      "paragraph_end": 66,
      "label": "三生殿破禁护镜、照旧事高挡韩",
      "direction": "两追到半毁殿，高剑剖中殿去禁绕镜护宝，紫电入镜照往事未名谁催。韩坚定控时止孟顾扑虚云，欲阎魔手高挡破时停。高悲鼻喊三弟韩二哥，三人呆，孟当场被认三弟不是三人新签结盟。",
      "evidence": [
        "v04-c0193:p0053",
        "v04-c0193:p0066"
      ]
    },
    {
      "paragraph_start": 68,
      "paragraph_end": 69,
      "label": "未名阵破尾切",
      "direction": "只明轰隆阵破紫霞起，未列破阵人、位置或新队到三生殿；不把尾声新证扩大已经援到主角。",
      "evidence": [
        "v04-c0193:p0068",
        "v04-c0193:p0069"
      ]
    }
  ],
