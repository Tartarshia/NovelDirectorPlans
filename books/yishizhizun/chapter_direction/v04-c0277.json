{
  "schema_version": 1,
  "chapter_id": "v04-c0277",
  "title": "第二百七十七章 不走寻常路",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "fa941e1a2c0eebe7a24e0ace5799aa91a0459f7f213097559b7b97e3ce575b93",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S33",
  "pov": "托临死与孟反常心理应对破三围、顾移旁韩后手现、一刀斩哭",
  "attribution_caution": "托实死天母神相崩非神本人已死；顾病标签属孟言不诊、我的女人不婚姻证，实际移旁稍距非永久结盟。韩后手63叙确认身份未名、哭气息崩残执死亡非孟宣仅未成；招未名/魂群后果未给，尚未逃成功。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 15,
      "label": "托神术斩破浅伤致命、信息隔阂与神相崩",
      "direction": "戒杀黑剑斩玉如意破巫光，托遁壁浅肩伤却生机血神溃15死。11–14临死忆金帐损宗师/派系不通消息为她认识；愿力替死本章没成功再用，神相叫崩似远天母重伤未神本体死。",
      "evidence": [
        "v04-c0277:p0001",
        "v04-c0277:p0015"
      ]
    },
    {
      "paragraph_start": 16,
      "paragraph_end": 24,
      "label": "孟识破与绕路疑、实际元心试感顾",
      "direction": "八九准备怕法身没料同阶顾识，因果/暗记及为何不金帐抓仍孟推。24运元心感情心念是实际尝试，未完整读顾心或能力无条件升级；人格分裂吐槽属孟内非医学结论。",
      "evidence": [
        "v04-c0277:p0016",
        "v04-c0277:p0024"
      ]
    },
    {
      "paragraph_start": 25,
      "paragraph_end": 36,
      "label": "哭魂群封路威胁与戒杀宿命论合围",
      "direction": "哭六欲佛陀怨相添宗师、黑7地33原理无克可类数宗师强。口称本前奏今撞、怕孟成长和哈勒报仇、欲杀孟再半法及师父是威胁非师父已死。戒杀救与铁升命定口自述、35淡悯绝望，三人合围大能转世叙称顾未确定无生具体。",
      "evidence": [
        "v04-c0277:p0025",
        "v04-c0277:p0036"
      ]
    },
    {
      "paragraph_start": 37,
      "paragraph_end": 50,
      "label": "孟恢复真容霸气调向、顾实际站旁改阵",
      "direction": "孟大笑恢复原貌、说布局失望/杀顾最后/我的女人为言语战不婚姻所有权事实。顾表情僵再双态变最终慧黠低头飞旁仍稍距，哭猜虚张挑拨又真的被改，不她永远不杀/完整动机已揭。",
      "evidence": [
        "v04-c0277:p0037",
        "v04-c0277:p0050"
      ]
    },
    {
      "paragraph_start": 51,
      "paragraph_end": 65,
      "label": "敌错愕与孟赌反应、挑哭和叫实际黄雀",
      "direction": "两敌错愕、52孟设想敌若懂流行语骂未真听敌口粗话；孟以行为矛盾推心矛盾赌猜错不更坏。对哭宣一刀杀激怒并口唤黄雀；62破衣花发人实际从戒杀背现、毒沼掌来，63直叙韩后手/孟等待明确，真名未明别指无面或幻灭。",
      "evidence": [
        "v04-c0277:p0051",
        "v04-c0277:p0065"
      ]
    },
    {
      "paragraph_start": 66,
      "paragraph_end": 74,
      "label": "后手袭戒杀、鬼门魂群与一刀斩哭",
      "direction": "戒杀挡身后掌、哭鬼门群魂至少两宗师气象/风沙冲围欲退，孟星线眼长刀一斩哭沙收气息崩仅残执你你，73说一刀足。招名未明不直接扣沾因果三刀余额、附魂结局未给，戒杀后手战未终、孟仍现场顾旁未出谷。",
      "evidence": [
        "v04-c0277:p0066",
        "v04-c0277:p0074"
      ]
    }
  ],
