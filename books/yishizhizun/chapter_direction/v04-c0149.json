{
  "schema_version": 1,
  "chapter_id": "v04-c0149",
  "title": "第一百四十九章 恶念现身",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "cdfcbe77d6109fcde3150c604869e93eed3ac85b28487d0f382b753fed66a4d8",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S16",
  "pov": "墓外洗月崩溃转孟陵内救皇甫涛与恶念对谈",
  "attribution_caution": "皇甫生机残且灵智恢复是救脱附控，非已亡者复活；旗气护身导引未写全力催发，两次全力余额不机械扣。恶念天庭时间为其口述，不全知确证。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 15,
      "label": "残旗护身与洗月失控",
      "direction": "旗略发气息护孟红雾湿数百里，旁观难窥墓内；不是六重晋境。洗月恐惧幻觉引阴阳冲突下沉，摘星托救未死，不是孟刻意攻击月之乡。",
      "evidence": [
        "v04-c0149:p0001",
        "v04-c0149:p0015"
      ]
    },
    {
      "paragraph_start": 16,
      "paragraph_end": 29,
      "label": "入墓见皇甫涛而留救意",
      "direction": "布局变残破仅镇龙台高悬、镇压令难飞落地。皇甫壮年活死人肉未腐生机残近首梯，孟感教益玄武佩因果欲救，不如门外全灭。肩胸硬迎雷矛无伤不泛化所有武器免疫。",
      "evidence": [
        "v04-c0149:p0016",
        "v04-c0149:p0029"
      ]
    },
    {
      "paragraph_start": 30,
      "paragraph_end": 43,
      "label": "三德净化金莲与旗气协作",
      "direction": "又生两臂，拳转爪三德入泥丸，变天击地借元始金莲唤记忆。恶念形威压金莲只能短挡、随时倾覆，旗气导入冲破，皇甫42恢复灵智，43抛出墓外。非完整复活或伤势治尽，未全力挥旗。",
      "evidence": [
        "v04-c0149:p0030",
        "v04-c0149:p0043"
      ]
    },
    {
      "paragraph_start": 44,
      "paragraph_end": 47,
      "label": "师徒重逢仍有戒备",
      "direction": "何看不见内部，见师出先戒备又喜，皇甫清明点头感孟成长；不能写何已知每个救法或当场全好回庄。",
      "evidence": [
        "v04-c0149:p0044",
        "v04-c0149:p0047"
      ]
    },
    {
      "paragraph_start": 48,
      "paragraph_end": 59,
      "label": "恶念现身以古秘争机",
      "direction": "真武恶念身现残力难判，孟仍极慎；恶念望旗说他不放过指真武。识门外刀源神霄孟答上一雷传人；56雷神天庭坠后到访为恶念所说，孟先前时间推论修正待证。明知动摇心志仍听，不代表已被控或灭念任务完成。",
      "evidence": [
        "v04-c0149:p0048",
        "v04-c0149:p0059"
      ]
    }
  ],
