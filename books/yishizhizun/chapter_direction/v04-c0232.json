{
  "schema_version": 1,
  "chapter_id": "v04-c0232",
  "title": "第二百三十二章 闯祭台",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "8baddc832e85a03cff2b526d35d24cf53db0a296d6c22ab0d2ebea77121cd889",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S23",
  "pov": "江独立剑道留闻、孟法天闯核心与祭台完工",
  "attribution_caution": "孟法天本章明确四臂未新二头，连续返虚反射吐血不真死；分身52灭。江有无情统一是其道非单恋附庸或明确新境突破。伤敌不全死。台73完工74献祭非神已真降，最后沾因果计划未施；枪截未中结果，闻必死宣判只是威吓。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 17,
      "label": "雷刀压闻、万物返虚与天妖屠神反射",
      "direction": "孟雷刀快于声实际压闻退毁魂，法天与天伤本章明确；重刀凝黑点被十丈天妖相闻吸劲反射弹飞右麻，孟识天妖屠神法。未闻败死。",
      "evidence": [
        "v04-c0232:p0001",
        "v04-c0232:p0017"
      ]
    },
    {
      "paragraph_start": 18,
      "paragraph_end": 38,
      "label": "连续反震刀剑抢突破、吐血换江阻闻",
      "direction": "台近成江被多绝顶围琴抵暗道术；孟防拖主动流火万物返虚再反震左麻生两臂连续攻终于逼退，吐血趁江杀尽围敌刺来向上。闻扰江避剑气旋困孟，孟迎风变化脱缠；非捆仙绳实物使用。",
      "evidence": [
        "v04-c0232:p0018",
        "v04-c0232:p0038"
      ]
    },
    {
      "paragraph_start": 39,
      "paragraph_end": 61,
      "label": "江自身道路、有情无情短压与孟闯关留活口",
      "direction": "江剑相全施情与无情统一自身独立道路，斩境法压制闻被短压愤六道普通如死亡任务。闻秘法江洗剑拼命与九转玄功实用暂上风。孟分身被两外景杀非本尊死；琴抵束地，孟撞晕、断臂、拦腰断者仍活，横闯伤敌不每伤都死。",
      "evidence": [
        "v04-c0232:p0039",
        "v04-c0232:p0061"
      ]
    },
    {
      "paragraph_start": 63,
      "paragraph_end": 67,
      "label": "阮隔一层曲谱琴心抵道术、赵护船与杜沟剑",
      "direction": "阮汗千里杀人音多曲抵暗处道术境差一层并未点实名，凤凰百鸟仙钟为琴象非神全实体降。敌残船攻，赵剑化飓风翻船胡侯义船参战保护，杜自保退安全浮木专沟承天未再实际催。",
      "evidence": [
        "v04-c0232:p0063",
        "v04-c0232:p0067"
      ]
    },
    {
      "paragraph_start": 69,
      "paragraph_end": 88,
      "label": "斩玉闯高层法天将尽、台完工献祭与武皇枪截",
      "direction": "孟感激江提斩玉配开天闯，法天临尾之字避神兵；亲察台完工沈献宝与先死者，孟想完全催前破，最后沾因果保留沈尚未施。独孤换斩马刀压齐顽石投金枪尾截孟，孟刀剑应未结果，闻渐扳回四声讥判不是作者断义军必死。",
      "evidence": [
        "v04-c0232:p0069",
        "v04-c0232:p0088"
      ]
    }
  ],
