  "title": "第二百三十五章 别离",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "56ff98eabc51e362cf47d5d6466cabf43112ed24ae4d191b4d9fc2154acb9081",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S24",
  "pov": "第二死亡回归结算、齐正式生离与传说线索",
  "attribution_caution": "S24回归理念别离与修行筹备；公共始召神断路≠本人神位，武皇后战同归来源续叙。齐正式离但未死未来道争没当场战；传说鱼来自魔主记未地球本源全定。账孟39915源明、江16625源明与217推起点差1000未列不擅填治疗。森罗与江影王归属推矛盾保源，昆仑未实修。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 5,
      "label": "怒江后世公名、武皇同归与苍龙洞府传闻",
      "direction": "民间记始一品召神断路与杜天命，吴寇等倒戈武皇独战九上三同归毙二重三，義军渡江传檄京城。百晓传南北、御天苍龙坐化洞现似近居未搜皆信息层，不始真实新晋神或匿名老人已确定该苍龙。",
      "evidence": [
        "v04-c0235:p0001",
        "v04-c0235:p0005"
      ]
    },
    {
      "paragraph_start": 7,
      "paragraph_end": 17,
      "label": "回归治疗、11500各奖新符与权限、别离已成",
      "direction": "孟弱消天心法相损治疗复原但忧隐患非证明害；4500主线7000三敌阵奖每人符1无评价第二死亡权限增完整法身神兵专属任务、队名驻地三出口连一同步未建。齐别离契约实际成自由轮回者。",
      "evidence": [
        "v04-c0235:p0007",
        "v04-c0235:p0017"
      ]
    },
    {
      "paragraph_start": 18,
      "paragraph_end": 46,
      "label": "生离留言友情评与理念鸿沟、魔主鱼传说资料",
      "direction": "孟预知悲江阮震憾赵历死较淡，江听经齐录留言真情评五友张师，到魔坟灵山接受经碑墨家理念不可回转非传统邪；孟应问复述三人闻理念不接受不痛恨，六道暂停留言后继续将来不留手仅条件，魔主记投影演化诸界归一是留言资料不当本章已宇宙真相全独证。",
      "evidence": [
        "v04-c0235:p0018",
        "v04-c0235:p0046"
      ]
    },
    {
      "paragraph_start": 47,
      "paragraph_end": 54,
      "label": "地球鱼推未完环、请师谢陆计划与泄密疑",
      "direction": "孟推自身地球鱼永生本体尚缺环，三友万界同迷江拟请师，赵叹陆大像能江疑隐情M拟画眉谢未实际去；轮回透露算否疑未抹只似不算。",
      "evidence": [
        "v04-c0235:p0047",
        "v04-c0235:p0054"
      ]
    },
    {
      "paragraph_start": 55,
      "paragraph_end": 68,
      "label": "四人战利品售债清余额明确、赵时间拟与M经卷差85",
      "direction": "江先售换并了解下任务还未告，赵早摄独孤斩马今取孟森罗苗物，江推前者杀影王有来源歧不篡。森罗7800个人苗15500+独刀5000四平5125，阮还3100赵还6000孟39915；江16625阮13525赵10925。赵拟时间+符越第一梯未兑换，M不立即封神玉虚计划宗师后拉灵宝，不已兑易筋二40000。",
      "evidence": [
        "v04-c0235:p0055",
        "v04-c0235:p0068"
      ]
    }
  ],
