{
  "schema_version": 1,
  "chapter_id": "v04-c0199",
  "title": "第一百九十九章 刀剑讲述的“故事”",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "0cdd358fe710ead2ac96eaf90c15afa65a74731d3a6199acd326a746ae1e92ae",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S19",
  "pov": "五德防御下真实受伤、表面求和铺矛盾与神掌入刀破心防",
  "attribution_caution": "受伤与消耗神通是实代价，求和是后段明揭策略而非真实降服。古符最后一次未用，粘因果考虑未实出；五德塔是法相不是175被毁实体秘宝。冰眼拿出未催，神躯关系与具体身份未揭，唯我心问留声音疑问，羲未死。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 12,
      "label": "羲优势与孟五德分析",
      "direction": "羲五德五太压天地杀意不听。孟八九元始适应领域不等无敌，评宗师羲防如自己未来宗师八九为估，无当前孟已宗师；暂评古符末次或因果，不能计为已用。",
      "evidence": [
        "v04-c0199:p0001",
        "v04-c0199:p0012"
      ]
    },
    {
      "paragraph_start": 13,
      "paragraph_end": 25,
      "label": "躲首拳法天四臂，刀破塔仍浅伤与首传音求和",
      "direction": "孟避首拳实际两头四臂法天，阴阳刀裂宝塔黑白霞却圣德偏只臂浅伤，羲再拳玄龟龟甲勉抵借闪。元神传音无意神躯传承求罢战是策略，不能确认他已取得传承。",
      "evidence": [
        "v04-c0199:p0013",
        "v04-c0199:p0025"
      ]
    },
    {
      "paragraph_start": 26,
      "paragraph_end": 37,
      "label": "羲不回应，刀剑积击与孟肩血肉毁",
      "direction": "羲掌拳指进，流火网消指天伤刀分斩颈，羲五德再生，太虚指穿剑肩爆血肉化无；羲颈仅血伤。孟再传音愿契约未签，先不提前说真降服，末才解释策略。",
      "evidence": [
        "v04-c0199:p0026",
        "v04-c0199:p0037"
      ]
    },
    {
      "paragraph_start": 38,
      "paragraph_end": 48,
      "label": "双葬星河仍冲破，孟神通中止吐血",
      "direction": "四武刀剑撞衍两重葬星河，貌似为古符争时间但实际未催；羲小伤冲过撞脚，孟倒飞法天四臂消吐血淡金黯，不轻伤真实不伪造。羲调整再追仍活。",
      "evidence": [
        "v04-c0199:p0038",
        "v04-c0199:p0048"
      ]
    },
    {
      "paragraph_start": 49,
      "paragraph_end": 60,
      "label": "两德问责与唯我刀，心灵矛盾铺垫揭示",
      "direction": "孟元神声责退让求和仍灭口不合圣功，塔水摇；天伤入神掌唯我刀塔水消，旁白解释从始没真逃求饶、以刀剑讲杀机故事。德心矛盾削弱非全功散，心问我是谁归属通道未明留疑，羲短暂混乱呆滞。",
      "evidence": [
        "v04-c0199:p0049",
        "v04-c0199:p0060"
      ]
    },
    {
      "paragraph_start": 61,
      "paragraph_end": 62,
      "label": "流火收冰眼现，拜拜未催",
      "direction": "孟收流火冰眼晶魄实在手笑出拜拜，两字现场声；到此无实催冰眼、羲死亡、宝物掉落或战完疗伤。",
      "evidence": [
        "v04-c0199:p0061",
        "v04-c0199:p0062"
      ]
    }
  ],
