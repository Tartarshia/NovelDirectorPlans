{
  "schema_version": 1,
  "chapter_id": "v04-c0140",
  "title": "第一百四十章 无相",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "f1b629d20504c0e93656ffadf0981a3e2811fd176f631c5e69a4f45ec4a3d54d",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S15",
  "pov": "何高交锋含高感知转何七评价，三家战场再琅琊与巨塔逃逸",
  "attribution_caution": "137临界138四重139稳境至本章不变；何压的是半步法身非半步外景。九指身份从63揭明但姓名仍未明，乾元信息来自高遗言。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 16,
      "label": "剑蛊随吐纳入体而失目标",
      "direction": "高实虚两类剑蛊融元气，防御硬功难防、闭吐纳会衰弱。何七确压半步法身，仍吐纳诱入；高喜后失去目标，不能把何无相演成仅速度快或藏身水中。",
      "evidence": [
        "v04-c0140:p0001",
        "v04-c0140:p0016"
      ]
    },
    {
      "paragraph_start": 17,
      "paragraph_end": 30,
      "label": "无相胜剑蛊与神掌修正",
      "direction": "何七声自信后处处剑气碎蛊，残高一虫重伤，胜负明确。高猜神掌致能，何纠正本已做到只神掌补圆润；高认输，何承认其法不知玄机者难敌，不演高从无价值。",
      "evidence": [
        "v04-c0140:p0017",
        "v04-c0140:p0030"
      ]
    },
    {
      "paragraph_start": 31,
      "paragraph_end": 39,
      "label": "支脉代价与遗言",
      "direction": "剑庄残经多支共探、先代法身缺陷及何父祖短命来自完善功法；何赞探索却不认可邪路。高告符令在乾元，转化差错耗寿、东极丹一甲子为其述；托弘剑庄后蛊碎死亡。何未取得符令、乾元未在场。",
      "evidence": [
        "v04-c0140:p0031",
        "v04-c0140:p0039"
      ]
    },
    {
      "paragraph_start": 40,
      "paragraph_end": 49,
      "label": "祖神气息与王家主杀敌",
      "direction": "塔引强气何仍从容。洛书藏水生限制蓝血控制，王破枢机而对手感透明非读心实证；卦象束缚后一剑杀外景巅峰者凝水蓝石，未分配战利。",
      "evidence": [
        "v04-c0140:p0040",
        "v04-c0140:p0049"
      ]
    },
    {
      "paragraph_start": 50,
      "paragraph_end": 59,
      "label": "阮老加力与何七清场",
      "direction": "四对五原占优未杀；祖神气息起阮老伸手按琴似衰老，裂天变地曲强控，众杀招何七剑游终结五位。别把50–51预估写成提前全死，何杀与阮控都保留。",
      "evidence": [
        "v04-c0140:p0050",
        "v04-c0140:p0059"
      ]
    },
    {
      "paragraph_start": 60,
      "paragraph_end": 67,
      "label": "孟获知掩护与六人撤离",
      "direction": "阮摇光告孟主力海底，孟此时才恍然；提开启护阵是意图未明完成。九指本章确蓝血，六人一宗师二绝顶三普通外景，知敌仍强且返海两三日遂撤，未袭阮。",
      "evidence": [
        "v04-c0140:p0060",
        "v04-c0140:p0067"
      ]
    },
    {
      "paragraph_start": 68,
      "paragraph_end": 73,
      "label": "祖神助塔飞逃",
      "direction": "祭司压手气入塔，翼展喷气虚化向青冥外射出，是欲逃且启动，不能提前判成功或祖神实体降世，更不能现代飞船定类。",
      "evidence": [
        "v04-c0140:p0068",
        "v04-c0140:p0073"
      ]
    }
  ],
