{
  "schema_version": 1,
  "chapter_id": "v04-c0248",
  "title": "第二百四十八章 矩子归来",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "2c3d947c2f0a1591592c32d6e8c8773221ad278243356bb742b9f8968cea6f72",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S27",
  "pov": "封神归墨家与长期治陈；仙迹交易用符真正落地、回墓见墨苦难",
  "attribution_caution": "新符实启动入封神14月但没晋宗师没满期；新破空仿古一次未用不复旧古符。九娘6000借悟非卖树，孟收回；入影剑4000实售，年价本章未列余额不可强造明数。叶陆冲北仅计划，孟已离庄不仍留查。田已外景不猜重数，陈王真死贵族奢葬墨惨亡与受害明确，田掌清异只建议未政变。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 9,
      "label": "真离庄、叶法身感慨与陆冲北上计划",
      "direction": "叶轮回斗姆知孟意陆早察木雕破轮能猜，孟实出房离庄。叶宗师年磨法身感叹不能符一年必晋，陆拟北剑试斧动摇联盟测苏醒，叶建议同冲地仙更稳陆应非纯生死武道挑战，尚未北上或战成。",
      "evidence": [
        "v04-c0248:p0001",
        "v04-c0248:p0009"
      ]
    },
    {
      "paragraph_start": 11,
      "paragraph_end": 26,
      "label": "悟树收费售剑兑符时间、实用轮回符封神",
      "direction": "九娘付6000又悟道树自身过首梯快期，贪羡求折孟黑符6000早转；破空符仿古一次7300，入影剑售4000共新收10000兑破空与附年，已有昆仑用于防备理由无修理实催描。九娘盘悟孟收树实启动轮回符选封神，六道声明一年两月可近熟人未写具体选誰。",
      "evidence": [
        "v04-c0248:p0011",
        "v04-c0248:p0026"
      ]
    },
    {
      "paragraph_start": 28,
      "paragraph_end": 40,
      "label": "王陵祭陈王、田括外景与墨者两年苦难",
      "direction": "陈国上营郊田括去奢王陵陈王遇刺亡，贵族弑后泼墨家且奢葬讽刺。孟古黑冠剑洒酒我会归田识矩子惊喜，问别来无恙田已外景仍哽墨同伴死；陈掌权追捕贵族遮严组信念仍内奸诸因使墨惨死，未田都遇灭。",
      "evidence": [
        "v04-c0248:p0028",
        "v04-c0248:p0040"
      ]
    },
    {
      "paragraph_start": 41,
      "paragraph_end": 49,
      "label": "三策缺守义不弱、长期农机武育与陈势",
      "direction": "孟温承墨损己利众问陈；田说关税废商市兴百姓部分益，但贵族选出身失才奢不培民、征小国唐不满，一年邻仿去税商停。孟只利不义不弱难长、长期草木机关增农积钱习武鼓励选育需20/30/百年，提不谋万世。不是当场技术发明或已全民练成。",
      "evidence": [
        "v04-c0248:p0041",
        "v04-c0248:p0049"
      ]
    },
    {
      "paragraph_start": 50,
      "paragraph_end": 56,
      "label": "田记矩子语、救陈方案只刚提出",
      "direction": "田回味掏纸记、孟讶问田热忱教墨，孟酸爽嘴抽转救陈，田愿闻纸差落，孟首田掌权排异是谋划未政变已成或陈王复活，未宗师晋。",
      "evidence": [
        "v04-c0248:p0050",
        "v04-c0248:p0056"
      ]
    }
  ],
