{
  "schema_version": 1,
  "chapter_id": "v04-c0251",
  "title": "第二百五十一章 元磁之域",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "7cd6bdae1ee3ea96bc24d83326054fbf041d30d904ac41885d9c6f3c7ab0878f",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S27",
  "pov": "元磁质变压力中的粗入微阴阳维持半力、护甲接箭与刀势稳未结",
  "attribution_caution": "外景级入微实际新掌不是宗师晋，三十六元磁兽仍宗师后才能。昆仑11/72已实催可用，修理过程费用无写，别仍当当前断甲不能用。玄龟甲影裂不实体剑永久碎；口角血46、多白印74真实非幻，未死额贯。57箭毁半峰、33刀分峰不倒分开。末刀稳未中赤未胜负；维持半力导致不能连续极品催而非永久半境。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 21,
      "label": "元磁扰神指令、金莲法天与昆仑实催接箭",
      "direction": "身体左右下磁乱连神痛指令右尺只七寸，孟感真正宗师质变、宗师后才有元磁兽当前不能变。元神金莲定神法天巨八九挡体内磁，实全催昆仑层雾耗箭不减速箭自向上脸双眼中央白印，非已额穿重伤；孟认极品弓赤收嘲但信宗师非越胜。",
      "evidence": [
        "v04-c0251:p0001",
        "v04-c0251:p0021"
      ]
    },
    {
      "paragraph_start": 22,
      "paragraph_end": 38,
      "label": "新两臂阴阳转斥吸冲、刀偏山出一线天",
      "direction": "孟虚踏蓄天伤新双臂空手，赤拉弓庄严视短期敌，阴阳印两手转斥为吸小弧避箭正冲快；磁拉刀未抬够偏十丈斩孤峰自腰分二一指峡不塌。内神血抗磁但外刀身拉仍、赤识印变拉扯躲转，虚空传音空蛮无境不是已击中赤或切域全破。",
      "evidence": [
        "v04-c0251:p0022",
        "v04-c0251:p0038"
      ]
    },
    {
      "paragraph_start": 39,
      "paragraph_end": 54,
      "label": "流火罗网及玄龟接仍口血、闭目临微新感",
      "direction": "箭穿流火光网新左臂玄龟挡甲影裂焦消不剑实体毁，孟横飞倒退溢口血赤再拉。危越冷闭眼描地势每处磁力、陆入微回想细体各受力，赤趁呆急未满弓箭出全运域，未孟七重实际晋。",
      "evidence": [
        "v04-c0251:p0039",
        "v04-c0251:p0054"
      ]
    },
    {
      "paragraph_start": 55,
      "paragraph_end": 64,
      "label": "首次精准闪箭、外景级入微阴阳逐处半力",
      "direction": "孟左一步缩地时力准真避箭山半截炸无尘；赤惊孟适身不立进攻，不灭元始相阴阳印身刀延伸分小独阴阳对力抵，外景级粗微现掌维持半力不等同陆地仙深微，敌控身优势消非其攻击全部无效。",
      "evidence": [
        "v04-c0251:p0055",
        "v04-c0251:p0064"
      ]
    },
    {
      "paragraph_start": 65,
      "paragraph_end": 77,
      "label": "无量光仍弯攻击、双箭雨再催甲与刀轨稳",
      "direction": "赤强化域双箭，孟流火无量光被域折打诸峰孔，赤内得意还能扭攻击。双箭后撞前速雨后爆孟反不及再实催昆仑脸身多白印淡金减、分心阴阳难连续催极品。孟洒然天伤阴阳混刀轨稳定末阴阳三合问意暂内/声待审，未命中杀赤晋宗师。",
      "evidence": [
        "v04-c0251:p0065",
        "v04-c0251:p0077"
      ]
    }
  ],
