{
  "schema_version": 1,
  "chapter_id": "v04-c0218",
  "title": "第二百一十八章 外有敌，内不安",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "183acc9765818de6b0ce21c74fa9324490df285af48a46b1963bdd41c5f71786",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S22",
  "pov": "怒江限制与义军落脚、平海招揽杜重伤口述和营后监视",
  "attribution_caution": "江规则六道背景不靠外景随飞渡，杜重伤袭刺神兵未亲见皆平徐来源；平宗师是现场判、名朱未全实名。内监视明确未具名，孟拟变化和丹治都未成，阵营改投未发生。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 14,
      "label": "怒江难渡、齐显感兵锋，确认义军侧但船少",
      "direction": "到怒江神魔世界六道背景残气飞鸟不过外景难跃宗师水百丈、特殊船与底怪禁封。齐指金铁新能力三友惊未说明魔主；孟先疑朝廷岸后见18营旗确认义军侧。百船少战况不利为孟判断，改旧貌正投红衣营未实横渡。",
      "evidence": [
        "v04-c0218:p0001",
        "v04-c0218:p0014"
      ]
    },
    {
      "paragraph_start": 15,
      "paragraph_end": 26,
      "label": "守门冷、徐巍热引，身份掩饰保留",
      "direction": "孟以世外异人大宁旧友自称守门头通报冷，孟疑奸细原因未证。徐将热迎自名义军徐巍问来历，孟简短假装出生大宁、注意只提义军不红衣，到帐非杜。未亲见杜或公开轮回实况。",
      "evidence": [
        "v04-c0218:p0015",
        "v04-c0218:p0026"
      ]
    },
    {
      "paragraph_start": 27,
      "paragraph_end": 39,
      "label": "平海王宗师现场与杜重伤神兵护主的口述",
      "direction": "八尺秃三眼汉孟判断宗师，江阮备戒，徐介绍平海自称朱镇海军首领值此。杜日前武皇偷袭、顽石救神兵护主昏迷、三首领异心为平说未现场验证，孟惊任务神兵难。",
      "evidence": [
        "v04-c0218:p0027",
        "v04-c0218:p0039"
      ]
    },
    {
      "paragraph_start": 40,
      "paragraph_end": 49,
      "label": "医治请求被挡、平海忧民话招揽，孟暂虚应",
      "direction": "孟以药石救杜，平说丹无用昨天奸细刺加伤顽石封中营、杜若亡各自去，忧民求助本人；孟疑此人更有图谋未全知，悲假答杜不幸才助忧民者，非正式背主投平。平令徐给暂帐称替说见杜是否真去未证。",
      "evidence": [
        "v04-c0218:p0040",
        "v04-c0218:p0049"
      ]
    },
    {
      "paragraph_start": 50,
      "paragraph_end": 57,
      "label": "营后暂住、徐吹捧品级、察监视后拟变化探杜",
      "direction": "徐带帐吹平二品杜五品、没有神兵顽石则平该共主为其立场说，大家周旋无实吐。徐离江通天察强者监视孟亦知，内部传音不利；赵杜神兵宽慰，孟疑朝廷亦有神兵，计划变形找红衣熟人，杜若普通伤一丹足条件未实际治。",
      "evidence": [
        "v04-c0218:p0050",
        "v04-c0218:p0057"
      ]
    }
  ],
