{
  "schema_version": 1,
  "chapter_id": "v04-c0187",
  "title": "第一百八十七章 索命园",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "358d4eeaa05133020bd03328a1913c0ba200fea29196bd8ca4df38a02c6ebb4f",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S19",
  "pov": "索命园规则下克制本能与未决背击，神话跟进意图",
  "attribution_caution": "寿耗现象明显但数额未给、未补，尸体死因和凶手未证。孟背刺顾飘带实攻结果未知，北斗羲及闯入者镜头不在孟所知。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 17,
      "label": "知名桃园变血污与三条禁令",
      "direction": "孟回忆前世西游桃寿不是本界成熟规律，持流火天伤警戒。精神蔓遭血污蒙蔽收回，全力八九预危。顾告不回头不停步不取物，孟疑开雷封后己价值降、契约禁暗害仍可能隐瞒，问原因顾避答后实同行。",
      "evidence": [
        "v04-c0187:p0001",
        "v04-c0187:p0017"
      ]
    },
    {
      "paragraph_start": 18,
      "paragraph_end": 33,
      "label": "不停前行且双方近死亡变化",
      "direction": "不能飞，背后危险影过引本能转身，孟忆顾话强忍。见顾憔悴印青，眼映自己同样寿尽感，顾明确传音出去有办法补非已经恢复。侧看同伴不等向后回头，两人依旧不停。",
      "evidence": [
        "v04-c0187:p0018",
        "v04-c0187:p0033"
      ]
    },
    {
      "paragraph_start": 34,
      "paragraph_end": 46,
      "label": "死天将与回头禁忌推测",
      "direction": "孟认金甲天将法身气盛无生机、身前头后不同旧凝固，据姿势猜回头致死，未验证死因。背后人影更近，顾补最后可不回头背身出手，尚未见敌真身。",
      "evidence": [
        "v04-c0187:p0034",
        "v04-c0187:p0046"
      ]
    },
    {
      "paragraph_start": 47,
      "paragraph_end": 55,
      "label": "寿星血源与末刻实向后攻",
      "direction": "绕金将血更浓，孟顾见裂头额凸白须尸形，顾叫寿星，血从此漫全园明述，凶手未知。吹气极险，孟保持脑前天伤倒刺青紫雷、顾按虚空飘带后送，两人已攻但命中结果未描。",
      "evidence": [
        "v04-c0187:p0047",
        "v04-c0187:p0055"
      ]
    },
    {
      "paragraph_start": 57,
      "paragraph_end": 63,
      "label": "北斗羲现门准备传讯跟进",
      "direction": "两玄袍现云戴北斗与羲面具。北斗嗓沉哑，羲要先传消息再跟为天帝探阻二人，北斗劝等法身，羲称入桃园使北斗疑奇遇。传信跟入都未实际描，不揭羲真身与知识来源。",
      "evidence": [
        "v04-c0187:p0057",
        "v04-c0187:p0063"
      ]
    },
    {
      "paragraph_start": 65,
      "paragraph_end": 68,
      "label": "韩高听见有人闯碎片",
      "direction": "韩说门已开，高欲言突闻巨响有人进这片天庭，韩看入口说环扣。闯入者身份未名，不自动等同崔司马探队，也不写韩高已进索命园。",
      "evidence": [
        "v04-c0187:p0065",
        "v04-c0187:p0068"
      ]
    }
  ],
