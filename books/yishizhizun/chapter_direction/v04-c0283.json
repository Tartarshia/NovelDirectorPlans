{
  "schema_version": 1,
  "chapter_id": "v04-c0283",
  "title": "第二百八十三章 护短",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "9498e94ba30be760d469659c6b872cfe0e07d1e7ffbe99fef2456de6b923f49c",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S35",
  "pov": "陆冲迎敌、孟隔阵警示遭护短拒、顾凝像牵制与藏剑主攻",
  "attribution_caution": "孟41笃定是策略非独证，无面真身未定；李48为暗传音非公开口。顾像准法身不本体晋法身、神像非老母本尊；幽冥阵实开启但曹引主攻未已成功。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 12,
      "label": "陆冲气机锁定与留宗神兵，一心剑出鞘",
      "direction": "王氏不参战送八字为卜算信息，陆说概率并接受含自己法身陨险，不预言已兑现。冲和上洞三剑留宗只带自家兵，自家兵名没给。敌雷来陆平说来了拔一心剑，未完整交锋胜负。",
      "evidence": [
        "v04-c0283:p0001",
        "v04-c0283:p0012"
      ]
    },
    {
      "paragraph_start": 14,
      "paragraph_end": 23,
      "label": "长乐避战拥堵与民间信仰滋长",
      "direction": "受警示诸家实避长乐，短缺只是迹象；巷斗真实伤路人，路人入宅见白莲像主持带诵自己跟诵。各城无生与自强咏群体不同，不能指定后者宗教实名或全百姓皆信。",
      "evidence": [
        "v04-c0283:p0014",
        "v04-c0283:p0023"
      ]
    },
    {
      "paragraph_start": 25,
      "paragraph_end": 42,
      "label": "孟忧民命实际抵楼，隔阵提醒说得过实",
      "direction": "孟急结束战、菩萨阻大荼毒为预期不一切悲剧免。一天夜到藏剑楼已阵开启剑坟，求见苏孟声传禁阵非自动心传。邱地6护短稳谨拒开阵，持无生神兵不同老母。孟说23年前巨原杨案真无面、轮换皆假，为其强说42明叙仍顾猜，未独证。",
      "evidence": [
        "v04-c0283:p0025",
        "v04-c0283:p0042"
      ]
    },
    {
      "paragraph_start": 43,
      "paragraph_end": 57,
      "label": "藏剑楼熟人信任拒疑与孟压火",
      "direction": "马游怒内想同门可信，南宫怀疑孟假邪挑拨，李思浓暗传声指孟顾关系据流闻、羽点同意无口。邱护短拒，孟怒先压再提醒后青筋吐槽内。不已楼内任一人确叛或孟伤人破阵。",
      "evidence": [
        "v04-c0283:p0043",
        "v04-c0283:p0057"
      ]
    },
    {
      "paragraph_start": 59,
      "paragraph_end": 66,
      "label": "顾聚愿力凝像，两准法身像分头南下",
      "direction": "莫名草原诵经非顾已明确开口；顾琉璃珠似持、愿力神像同容包裹成女神，莲台入眉顾气略显，准法身战像非顾境晋法身或老母本尊降世。与六灭阎魔像分头南下骚扰救援注意，不已破宗/两像合一。",
      "evidence": [
        "v04-c0283:p0059",
        "v04-c0283:p0066"
      ]
    },
    {
      "paragraph_start": 67,
      "paragraph_end": 69,
      "label": "主攻曹引陪京藏剑楼，幽冥阵已开",
      "direction": "哈斯乌拉挥手口令前往陪京曹引急攻藏剑楼为主攻计划，未已到陪京/藏剑楼攻破。主路成员各势力已有叙，幽冥邪神阵刚开启实际更新此前仅拟布，具体效力战果未验。",
      "evidence": [
        "v04-c0283:p0067",
        "v04-c0283:p0069"
      ]
    }
  ],
