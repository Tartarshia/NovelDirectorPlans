  "title": "第二百四十章 金帐奸细",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "2a25fce5397b448a280687873b455a3345764e610bb0be77e5f598cf169d40da",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S25",
  "pov": "孤狼暗记引落魂涧、尸确死与雾影余线索判断",
  "attribution_caution": "石死41真尸确认更新239报灯边界，孤狼草面尸48应当身份推却灰化真观察。青/蓝不仁楼凌判雇金帐M推，54单暗影未精确定位名阶人数；58/60结论还线推而未实线找到。宝兵甲环留现场子女51带走非M收益。5/19离堡时段口供差保，40黑袍伏伤尸不凌换衣或伏尸。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 15,
      "label": "查父急离、反猜赴约及凌承照料",
      "direction": "堡非世传底薄乱依凌，子石小当实名同晓秀问仆黄昏书房急离管家佐证。凌告生死约两子女先惧后释认可M见证，凌以临时遇M及石会留命驳赴约途中袭说，许友家事都担真稳众。",
      "evidence": [
        "v04-c0240:p0001",
        "v04-c0240:p0015"
      ]
    },
    {
      "paragraph_start": 16,
      "paragraph_end": 32,
      "label": "M推突讯鸟鸣发现密纸、孤狼暗记",
      "direction": "M青衫道德沉静旁听后据生死必全神推突事消息，管周似晚饭鸟怕密书，晓秀密门最后纸三纹鹰金帐断尾狼落魂涧真物。周解释石为高氏画眉探草原秘密送孤儿金帐受信暗记，M推情报重急不实际读到内容，口供晚饭黄昏时间未硬改。",
      "evidence": [
        "v04-c0240:p0016",
        "v04-c0240:p0032"
      ]
    },
    {
      "paragraph_start": 33,
      "paragraph_end": 44,
      "label": "义恩草原责任同行、慧眼找枯林真尸与剑杀分析",
      "direction": "凌卷周M因画眉纯阳北皇家义跟，开窍兄妹由外景长老携真到涧M慧眼迹降，枯林两尸石伏黑宝护脑后细伤翻身家哭确认死。M观察判一剑破神脑控气余地纯刺没贪，山可毁是假量评不真毁山，装备都留不是Mloot。",
      "evidence": [
        "v04-c0240:p0033",
        "v04-c0240:p0044"
      ]
    },
    {
      "paragraph_start": 45,
      "paragraph_end": 53,
      "label": "不仁楼阶推、疑孤狼灰化与雇主金帐未证",
      "direction": "凌判青/蓝灭口女恐报仇难，草面尸应孤狼剑毁触灰真未物证实名。纯专业故灰化是雇主要求为推，M忧重大情报断，子女环无事收父兵尸雇谁未知M猜金帐八九成非确古尔多单。",
      "evidence": [
        "v04-c0240:p0045",
        "v04-c0240:p0053"
      ]
    },
    {
      "paragraph_start": 54,
      "paragraph_end": 60,
      "label": "感雾影戒掌未交战、影退推出尚有线索",
      "direction": "M预感闭眼水雾影窥难定位想蓝刺来不及取刀剑用掌戒，影察退无攻击杀者实名，众问M宣青蓝仍旁故还有线索是推未找到新物。",
      "evidence": [
        "v04-c0240:p0054",
        "v04-c0240:p0060"
      ]
    }
  ],
