{
  "schema_version": 1,
  "chapter_id": "v04-c0151",
  "title": "第一百五十一章 实力不够眼光存",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "5d2a6a54c6dd11e050c44e9360b177bce6b323f7381f88e30d2837426bc681d6",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S16",
  "pov": "孟受截天元神危机、反击夺旗双线，末恶念压制",
  "attribution_caution": "独立元神法天象地与后肉身巨化分场；东极丹吞服消耗，定海珠未明损毁、旗全力两次不扣。末再次伤重不能沿中段丹疗状态写全好。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 30,
      "label": "元神金佛抗截天仍伤",
      "direction": "金莲只缓精神威压，肉身内景等无法调动，元神独施法天象地催真意，借当前意境勉强精神层唯我独尊；15补与玉书兰柯时孟也再悟，非已能常规完整第一掌。佛剑碰撞孟撞墙胸陷面伤，恶念29明确宗师级残力，上古眼光仍在。",
      "evidence": [
        "v04-c0151:p0001",
        "v04-c0151:p0030"
      ]
    },
    {
      "paragraph_start": 31,
      "paragraph_end": 40,
      "label": "烙印抗夺与元神遁离",
      "direction": "旗继续飞，孟催自烙印抗争，推恶念影响有限不信无条件收宝。恶念再剑切虚空，孟迎风变化元神遁离在完成前脱囚。未回归未夺回，不能将逃出改成硬破完成牢笼。",
      "evidence": [
        "v04-c0151:p0031",
        "v04-c0151:p0040"
      ]
    },
    {
      "paragraph_start": 41,
      "paragraph_end": 54,
      "label": "定海珠定水与丹药实耗",
      "direction": "孟巨身两头四臂投未成形定海珠，短定旗及水事物；48吞东极长生丹伤力速复，实际消耗。日陨毁内结构但外镇压阵存，恶念玄武守住，不是真的全墓封印毁。",
      "evidence": [
        "v04-c0151:p0041",
        "v04-c0151:p0054"
      ]
    },
    {
      "paragraph_start": 55,
      "paragraph_end": 70,
      "label": "开天与双分身争旗",
      "direction": "孟静动拔刀开天裂玄武，恶念自行崩解转道灭破坏，非本体已死。孟分身欲趁攻夺旗被恶念分身阻，两分身相缠未胜，旗没有到孟手。",
      "evidence": [
        "v04-c0151:p0055",
        "v04-c0151:p0070"
      ]
    },
    {
      "paragraph_start": 71,
      "paragraph_end": 78,
      "label": "道灭道生二次重伤",
      "direction": "孟筋斗步退，敌破灭未起剑衔尾欺进，三宝如意拳挡后吐血缩身，拳臂无生机而未写断落或永久不可治。恶念本体近旗不帮分身，全面压制本章止，未拿定旗未杀孟。",
      "evidence": [
        "v04-c0151:p0071",
        "v04-c0151:p0078"
      ]
    }
  ],
