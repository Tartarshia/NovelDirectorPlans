  "title": "第二百九十章 只手能翻天下浪",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "f3837ecc92e414de712059d8d841e48156b66606f03537934a2ef0df1883baf5",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S36",
  "pov": "古残灵神道求生、苏陆特征论剑与韩佛法自道破塔",
  "attribution_caution": "古法身毁不全灭真灵，投神髓求助尚未融合成。苏陆有传说特征不正式传说，十年约未来。韩波光刀未名，灰宗师仍未实名，妖逃实际但未全尽。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 7,
      "label": "冰山海面苏助陆毁古法身、天诛斧混洞逃",
      "direction": "斧剑追至冰海，苏来剑停斧裂光灭半雷火，陆微剑渗防斩天罚体微结构崩气消。天斧九痕混洞吸己强力迫陆回防，拔高似更高层如九天仅类比，苏后剑斩空斧消；未斧被夺毁/古真灵全灭。",
      "evidence": [
        "v04-c0290:p0001",
        "v04-c0290:p0007"
      ]
    },
    {
      "paragraph_start": 8,
      "paragraph_end": 19,
      "label": "陆苏对话残灵与特征、约十年论剑、陆惜提前晋",
      "direction": "陆9确古残一点真灵苏10法身毁药石无用；苏12陆略具传说特征13十年挑战陆14答好，非现在决斗/两人完整证传说。陆16惜17苏为战提前晋未尽全功，18若追极可能投影性格影响疯是风险非苏已经疯，19陆内塞翁思，不流逝十年。",
      "evidence": [
        "v04-c0290:p0008",
        "v04-c0290:p0019"
      ]
    },
    {
      "paragraph_start": 21,
      "paragraph_end": 30,
      "label": "斧破层禁到长生天神髓、香火再生机制说明",
      "direction": "斧降禁阶斩开入苍青愿力祖灵武士界到香火海珠，古真灵成容透明风烛实际活27识长生天界神髓珠；28–30神珠慢生及神真身死珠在香火在几年十几年可诞、珠毁光香火千几万年为一般机制非眼前已再生/大满人复活。",
      "evidence": [
        "v04-c0290:p0021",
        "v04-c0290:p0030"
      ]
    },
    {
      "paragraph_start": 31,
      "paragraph_end": 39,
      "label": "古权衡夺舍与神道、投珠求斧未融合完",
      "direction": "古32只真灵不可能直接复法身、夺舍再修几十年排斥风险为内估，33转珠望几年十几年神体地仙可期非已新证。35决断36/37实骂冲疯38真灵投珠呼斧兄助，39无宗师修为独融成养分为叙述限，斧具体帮助融合成功未写。",
      "evidence": [
        "v04-c0290:p0031",
        "v04-c0290:p0039"
      ]
    },
    {
      "paragraph_start": 41,
      "paragraph_end": 44,
      "label": "玄心返人藏招妖幡、完美人化法与魂灯迟暗",
      "direction": "塔先慢镇妖，玄心返人收招妖幡等时机怕妖身被发现难逃，43内赞妖皇遗完美人化法特定/法身当面全力查才可能识。韩似潜入未发现、杀长老魂灯缓暗如时光迟缓，非长老复活/灯已灭/全寺都完全知道。",
      "evidence": [
        "v04-c0290:p0041",
        "v04-c0290:p0044"
      ]
    },
    {
      "paragraph_start": 45,
      "paragraph_end": 54,
      "label": "韩门前返回成功线索、佛法桥接阎魔帝身、悠然吟",
      "direction": "韩与灰发宗师重新现门额前，46欣喜感慨，47上古秘辛宙光碎衍阿难净土仅真意少物因传说唯一、最贵真净土在少林后山筹谋终于成功。48眼六臂阎魔帝者眉心万字正逆桥49旧糅六灭与天帝玉册上自证阎魔帝身50法身后停滞今佛法连九幽九天方向51解说；没有完整获得未知神兵/正式晋地仙/归还义子。52右波光长刀53/54实际吟诗稳潇洒不讥狂乱。",
      "evidence": [
        "v04-c0290:p0045",
        "v04-c0290:p0054"
      ]
    },
    {
      "paragraph_start": 55,
      "paragraph_end": 58,
      "label": "时光刀光使塔结界一时崩解、妖王群遁实逃",
      "direction": "刀顺秘道到塔门琉璃腐朽门化泥、时光冲刷结界暂崩，57实际妖吼58妖王气趁窗冲塔后众遁跟，未塔所有舍利毁/寺全灭/具体妖实名与全部逃尽。",
      "evidence": [
        "v04-c0290:p0055",
        "v04-c0290:p0058"
      ]
    }
  ],
