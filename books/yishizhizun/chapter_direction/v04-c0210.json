{
  "schema_version": 1,
  "chapter_id": "v04-c0210",
  "title": "第二百一十章 杀鸡儆猴",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "604fa8d5c99994080d6e978d322474ff810a6b5f74c5c5e2029c931a973478d9",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S20",
  "pov": "孟分析三敌心理，两次范围攻遮援、假身诱发宝物再袭离别",
  "attribution_caution": "攻击假的孟不算真实死亡或代灾符确定耗，法天两头四臂本章明示。最大秘密未交、两命名援者与万虫未到；源妖魔授首为招法核心非击杀证据。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 17,
      "label": "秘法收买失败、小如以更大秘密求救",
      "direction": "血婴声称血衣早得法立功可传、抓后搜魂皆口供；宋猜两魔异蛊控制孟认可。孟点不急动手、小如判断待援，继以罗刹没得最大秘密交换救援并实际蛊誓，孟因义愤原也愿助，听吩咐未给秘密内容。",
      "evidence": [
        "v04-c0210:p0001",
        "v04-c0210:p0017"
      ]
    },
    {
      "paragraph_start": 18,
      "paragraph_end": 35,
      "label": "五重自评与择血婴保守为破绽",
      "direction": "孟自评单对三强有把握但枯骨可能逃，联手需慢分化却援将至，古符逃仅预案。异蛊原理不明不敢用唯我；血婴点名兽神蛮祖未到，自己以秘蛊记录判无名力有限。孟判断血婴嫡系求稳不愿搏命，左剑起身决定即战。",
      "evidence": [
        "v04-c0210:p0018",
        "v04-c0210:p0035"
      ]
    },
    {
      "paragraph_start": 36,
      "paragraph_end": 48,
      "label": "先攻最强、雷霆范围攻迫两援防守",
      "direction": "右雷刀左剑，剑阵攻枯骨引血婴珠和离别钩待援，枯骨本枯骨重开智六重可污泽迟速属叙述。孟法天巨身雷刀，枯骨五六丈骨掌迎，雷海波及外围山林，众外景挡余波，未写击杀。",
      "evidence": [
        "v04-c0210:p0036",
        "v04-c0210:p0048"
      ]
    },
    {
      "paragraph_start": 49,
      "paragraph_end": 60,
      "label": "连续刀剑压枯骨，大日再断锁定",
      "direction": "雷海让血婴无法锁定发珠改印莲防，离别吐血仍挡。孟刀剑压枯骨焦化非毁，雷散敌珠与小弓候机；流火大日普照加道传寰宇皮毛第二范围光迫再防，未神佛显身或新悟全道传。",
      "evidence": [
        "v04-c0210:p0049",
        "v04-c0210:p0060"
      ]
    },
    {
      "paragraph_start": 61,
      "paragraph_end": 69,
      "label": "缩身是诱饵，敌珠箭掌击假身",
      "direction": "敌见缩身欲刀剑再发，血婴急于阻混乱先发珠离别箭射弓崩、枯骨掌击，假身粉碎非孟死亡。分身或替死物只是敌猜，具体术材未明，枯骨悟两次遮援诱副车。",
      "evidence": [
        "v04-c0210:p0061",
        "v04-c0210:p0069"
      ]
    },
    {
      "paragraph_start": 70,
      "paragraph_end": 75,
      "label": "真身两头四臂突袭，杀鸡儆猴意图尚待结果",
      "direction": "孟在离别身后现巨身两头四臂双刀双剑葬星河，两敌喊小心离别危险煞白。目标吓退血婴破联合，章末没写离别死亡、师徒突围或援至，不替后章补战果。",
      "evidence": [
        "v04-c0210:p0070",
        "v04-c0210:p0075"
      ]
    }
  ],
