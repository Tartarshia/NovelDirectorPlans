{
  "schema_version": 1,
  "chapter_id": "v04-c0308",
  "title": "第三百零八章 幻魔之域",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "2feff8aa28faf6e7380f029ee3fe9636b835cfd241d99273c3dcc66952516968",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S39",
  "pov": "幽冥设幻域与金帐互防、孟救猎者获双线索",
  "attribution_caution": "幽冥2新认身不倒灌307未名，幻域开秘与捕叶是拟未成。射日弓五人持明确非孟获。哈宗存量口供、魔君古史据说保界。匿名猎34死、孟斩蟒无材料获，西北准备未到，少年愿强不收徒。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 14,
      "label": "幽冥身份与魔君秘境幻域计划",
      "direction": "2叙述明确生死无常宗幽冥帝君，血黄雾水声变万里地图红点北林万年冻湖。5魔君潜修地6–10古史区分魔君魔主、据说坐化；12–14宗藏完整知秘地，开秘境秘法造百里幻域精神隔幻分宗师多凌少最后叶陆令须全力为提议，尚没开启抓人。",
      "evidence": [
        "v04-c0308:p0001",
        "v04-c0308:p0014"
      ]
    },
    {
      "paragraph_start": 15,
      "paragraph_end": 25,
      "label": "哈斯应计又防下黑手、五人与射日弓",
      "direction": "哈先想打一二宗师止追，今想重创正道气陆走火为意图非实果。17要先查秘境18棺北飞19秘密传音不可分免自身也活肉，20一行5宗师持神兵射日弓不是已孟得。22–24哈称幽冥大宗师本门宗师只一守坛活死人、强提六重，为敌知识/心理安抚未实际无风险。25分距兼避神兵一网和互援。",
      "evidence": [
        "v04-c0308:p0015",
        "v04-c0308:p0025"
      ]
    },
    {
      "paragraph_start": 27,
      "paragraph_end": 39,
      "label": "部族猎蟒误判蜕化、匿名猎人死亡",
      "direction": "毛皮男女猎人四方向包围有一男一女少年，非固定人数四人。银鳞十丈蟒吞雪羊，矛七寸失中躯无痕、头凸寒流34冻一猎无生气死。首领惊蜕抓自女想逃，蟒风吸断木众退，少年惧蛇神是比喻非真神认证。",
      "evidence": [
        "v04-c0308:p0027",
        "v04-c0308:p0039"
      ]
    },
    {
      "paragraph_start": 40,
      "paragraph_end": 45,
      "label": "孟缓刀吸蟒两断、男孩见识",
      "direction": "少年见黑劲背刀孟，41拔刀慢斩暗扭吸蟒主动迎42二断肉电死，未具名招/新境或取材料。43孟问人踪后男孩呆44–45内疑南方帝国强者慑一刀，是少年视角不能预填帝国名或已拜师。",
      "evidence": [
        "v04-c0308:p0040",
        "v04-c0308:p0045"
      ]
    },
    {
      "paragraph_start": 46,
      "paragraph_end": 51,
      "label": "冰湖北路猎物跑、西北冰谷影与少年愿望",
      "direction": "首领先谢后忆清晨北冰湖路猎物全跑、又孩子西北冰谷人影当鬼，均口述不实鬼。孟两处疑多伙但未证，按习惯左从南准备先西北，50背影消失林，未到冰谷遇敌。少年男女咬牙呆萌生出部族求强的愿望，不已同行/收徒。",
      "evidence": [
        "v04-c0308:p0046",
        "v04-c0308:p0051"
      ]
    }
  ],
