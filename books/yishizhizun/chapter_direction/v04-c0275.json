  "title": "第二百七十五章 再临巴彦",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "ad16080818677bad1fbe99ab31df5c3fea7af1aee95763cde9293c32aab38c9a",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S33",
  "pov": "六欲焦点逆心通密约与两针交付、改道巴彦再见戒杀本人",
  "attribution_caution": "六欲旧念推孟/顾欲史身份口猜非全知；已抓萨仁是托拟交代非事实，恶鬼珠落土针实收未射、未立约誓；墓碑非声、戒杀本人已现身未擒，口声与传心/浮念区分。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 11,
      "label": "陶邪遗物收取、念收防读与准备交代的托",
      "direction": "六欲问血泥马刀环处理，顾凝心托借巫术心通仅微念、假极恶离距放空，4/5为六欲依据旧念揣行动不是独立孟内证。托口收回后交金帐、8已抓萨仁是将来借口非已抓事实，10说话念起被六欲听11托实收两人残物。",
      "evidence": [
        "v04-c0275:p0001",
        "v04-c0275:p0011"
      ]
    },
    {
      "paragraph_start": 12,
      "paragraph_end": 22,
      "label": "六欲欲谋自控、消息路线与恶鬼珠实际落土",
      "direction": "托木然下美姿令六欲欲炽；强制采补动机非真实同意关系。17口报萨仁似怪伤收花送墨尔松/巴彦是问讯来源报告、未亲验伤。18/19色空反噬自控教内机理，20两人加极恶可反杀是战评推。21恶鬼珠实际滑土22先到峡伪迹是假若无人计划未见执行。",
      "evidence": [
        "v04-c0275:p0012",
        "v04-c0275:p0022"
      ]
    },
    {
      "paragraph_start": 23,
      "paragraph_end": 33,
      "label": "逆用心通秘密提议、孟回复念与无契同意",
      "direction": "23明六欲逆心通内传可避旁窥、围陶此前此法酝酿新解释。六欲24/26/29/31/33传心不口说，孟25/28/30/32浮念被读非嘴声；顾无生及似失处子/苏孟首功是六欲说法猜测非身份性经历事实。方案针情欲弱身待擒萨仁再射，孟念同意未射/未擒。",
      "evidence": [
        "v04-c0275:p0023",
        "v04-c0275:p0033"
      ]
    },
    {
      "paragraph_start": 34,
      "paragraph_end": 37,
      "label": "两红针实际交付与利益担保、恶鬼另手",
      "direction": "六欲内欲后平复34两暗红针滑地35假孟实收，非未来仅承诺。36未签契未誓、六欲相信利益人心为保是主观，37针只是恶鬼机会失败备用。托32已抹痕准备离去，遗物未正式交金帐。",
      "evidence": [
        "v04-c0275:p0034",
        "v04-c0275:p0037"
      ]
    },
    {
      "paragraph_start": 38,
      "paragraph_end": 43,
      "label": "公开改巴彦路线与六欲接受绕路",
      "direction": "孟口先巴彦自预感38、顾39公然援以狼王坟认为萨仁凭吊，是其判断未源独证早洞悉定位秘术。六欲40口同意41/42内当绕路/若人在则和极恶配合，43真转飞巴彦，恶鬼峡计划未实际取代当前到谷。",
      "evidence": [
        "v04-c0275:p0038",
        "v04-c0275:p0043"
      ]
    },
    {
      "paragraph_start": 44,
      "paragraph_end": 51,
      "label": "多伦苏海春水、墓前戒杀本人再见",
      "direction": "44海解冻谷春草，四人降落潜入分锁逃路45非已被潜而必未察。46道人蓝袍冷杀墓前枯枝与春对照，48碑铁升墓文字不是狼王台词/新复活。49转身确戒杀即萨仁高娃50似发现众51口总算来了，没开战/擒成/治伤解斧秘。",
      "evidence": [
        "v04-c0275:p0044",
        "v04-c0275:p0051"
      ]
    }
  ],
