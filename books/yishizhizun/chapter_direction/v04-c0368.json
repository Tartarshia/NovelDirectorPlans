{
  "schema_version": 1,
  "chapter_id": "v04-c0368",
  "title": "第三百六十八章 古墓之战",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "d0bafdd8da5e458e7bcf7ab89279b57fa198cc7c4a63ec9ee8f4d495846ab897",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S52",
  "pov": "以身为饵定位宗门与召援破阵",
  "attribution_caution": "两实际口37/44同归幽冥，其他引号都是称物/术招/比喻。北极真龙地仙遗蜕近地仙实非苏完整传说；孟30九重实晋28过去只是有力压抑。弟子21烧化与红尸41被神吞分开，最后45灯灭内容未揭。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 11,
      "label": "北极真龙遗蜕来历、守宗限制与祭品",
      "direction": "真龙尸地仙遗蜕体更强近地仙实战，中古宗主转神取弱智逆死失败却聪明守阵。醒需祭否则短、离小千界天罚无法出带。龙吟使孟暂失靠元心唯尊护，阴曹府君尸棺被吞祭，积尸历灭宗被龙与右底蕴耗空历史，不当前全宗已灭。",
      "evidence": [
        "v04-c0368:p0001",
        "v04-c0368:p0011"
      ]
    },
    {
      "paragraph_start": 12,
      "paragraph_end": 18,
      "label": "真龙寒域与苏人仙特征压制",
      "direction": "古墓冻结爪跨几十里百里冰球，苏不受束无处在后太上天地初击脑鳞少碎，龙冰流不能触高处。18明有传说特征的人仙压近地仙龙，还斩帝棺阻阵恢复，一人包围为分位协作不苏已经完整传说或龙已死。",
      "evidence": [
        "v04-c0368:p0012",
        "v04-c0368:p0018"
      ]
    },
    {
      "paragraph_start": 19,
      "paragraph_end": 23,
      "label": "孟持真骨火刀、弟子火化与祖尸反扑",
      "direction": "左骨右灵宝刀退出门禁事背刀伤尸，真火涌烧化操尸弟子死，尸气灭火怒长十丈指甲神兵近剑合围。尸王未此刻死，孟未已用黄泉骨秘法取巧；弟子不末宗师。",
      "evidence": [
        "v04-c0368:p0019",
        "v04-c0368:p0023"
      ]
    },
    {
      "paragraph_start": 24,
      "paragraph_end": 34,
      "label": "意志贯身、九重正式突破与软硬协同",
      "direction": "身元细结构灵性整体意信贯，各环自纳高涨气压低智尸。三月前东海有力量一直未试压到今，30实际九重不是之前已晋；僵尸非活死人不变天克，神兵法天象地体力加气势技能压尸多伤。尸尚未被孟最终杀，不直接晋半步法身。",
      "evidence": [
        "v04-c0368:p0024",
        "v04-c0368:p0034"
      ]
    },
    {
      "paragraph_start": 35,
      "paragraph_end": 42,
      "label": "幽冥怒吼开右神棺、吞尸迎陆",
      "direction": "帝君禁棺挡一击黄泉骨真身露感陆近喊同归。右棺黑骨血肉双角先天神尸造黄泉失败成鬼神地仙不见苍天，开坐吸红尸连孟不能阻。神迎陆苏又围龙帝阵，尚无陆神战果、尸王被吞是祭消非孟斩杀终果。",
      "evidence": [
        "v04-c0368:p0035",
        "v04-c0368:p0042"
      ]
    },
    {
      "paragraph_start": 43,
      "paragraph_end": 45,
      "label": "幽冥受伤退末棺、第二同归威胁",
      "direction": "生死笔挡仍不敌苏伤退最后棺，第二同归说冰冷，掌风三灯灭。棺内容未开露、不同归已爆/宗灭/帝已死。两句完全相同台词先怒后冷需演态势变化，不复制同一吼。",
      "evidence": [
        "v04-c0368:p0043",
        "v04-c0368:p0045"
      ]
    }
  ],
