  "title": "第二百八十九章 天外神剑",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "87dfa773e3c610ec774bf778a5b2c905610d7b44b4b733845ebed63338a85746",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S36",
  "pov": "苏自认他我成法身，跨场剑斩蒙南与认知修正；陆追护古天斧",
  "attribution_caution": "蒙南真死、古残昏被斧救未死；苏70焚陨71再现必须保连续。传说是法王惊呼后自修为人仙攻击力，未正式证传说。孟未出场不更新恢复，冲无新死亡明确宣。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 9,
      "label": "诛仙阵死寂与天诛斧救古、陆大北追",
      "direction": "收缩十来里死寂吸能物质、天地排斥填平；陆悲不解自估再一盏茶古到限，并非作者全知解释冲任务。九痕天诛斧实际劈开裹残缺昏迷古北遁，陆持剑追交击越草原到雪木之地，古未死、斧未夺、冲未新口或明确死亡判词。",
      "evidence": [
        "v04-c0289:p0001",
        "v04-c0289:p0009"
      ]
    },
    {
      "paragraph_start": 11,
      "paragraph_end": 27,
      "label": "镜照诸界自认苏、太上道体三者融合",
      "direction": "湖剑客/雪山飞剑青衣/白衣剑客各自认苏，集体无形联系入冷清本体。剑气各性质与太上道体相重肉元寸寸融，26苏就是道体明确法身成，积累无瓶颈；他我各世界不可擅填人数姓名或全知苏正式证传说。江感无处不在为当时观感。",
      "evidence": [
        "v04-c0289:p0011",
        "v04-c0289:p0027"
      ]
    },
    {
      "paragraph_start": 28,
      "paragraph_end": 46,
      "label": "混沌雷临与天外剑追蒙南跨距",
      "direction": "混沌雷落苏拔剑、江震聋白光后见师在高处，未写剑佩兵名或雷损门人。蒙南欲绕晋腹地尚未行灭城，苏四面剑逼他数万里逃、用珍符到瀚海仍追。蒙内惊与苏冷淡不用追得满头急汗，对无处不在的机制尚留悬念。",
      "evidence": [
        "v04-c0289:p0028",
        "v04-c0289:p0046"
      ]
    },
    {
      "paragraph_start": 48,
      "paragraph_end": 60,
      "label": "苏同时接四法身、夔背心中剑与法王惊传说",
      "direction": "空舍身渐退太离重伤稳，法王占夔上风一时胜不了且阻不住逃，云罗持平。苏剑分四攻太离法王夔罗，蒙南线未弃；四者猜苏成法身与顾蒙疑是集体内问非口定科普。夔飞高难近又背苏刺背、法王58实惊传说后遁险贯，未夔/太离/罗被杀。",
      "evidence": [
        "v04-c0289:p0048",
        "v04-c0289:p0060"
      ]
    },
    {
      "paragraph_start": 62,
      "paragraph_end": 78,
      "label": "蒙南试短窗反杀法身、苏再现终斩主持",
      "direction": "蒙观察苏出剑短暂可攻却先硬受逃寺开禁。禁未阻首剑、两头三臂断，蒙抓窗口黑莲解体烈火与禁困真苏法身70焚陨。71又苏凸显剑眉心72蒙死73–77讣录明确杀者。保70真实文字与71续现连续，不直接消苏为假幻象或补确定复活机制。天榜新入但无具体名次，寺其他人/黑莲后库存未写。",
      "evidence": [
        "v04-c0289:p0062",
        "v04-c0289:p0078"
      ]
    },
    {
      "paragraph_start": 80,
      "paragraph_end": 83,
      "label": "法王靠符离本界入真空、修正一步传说猜想",
      "direction": "前后六方剑压法王难还手，80若非虚空道怕已伤为反事实不是已贯伤；81符裹往不此界，82真空家乡松气认苏确不可能追此。83他判断不可能一步传说、仅人仙攻击力似不能持久，保知识源与未验证限制，不正式境界传说/全宇宙无处不在。",
      "evidence": [
        "v04-c0289:p0080",
        "v04-c0289:p0083"
      ]
    }
  ],
