{
  "schema_version": 1,
  "chapter_id": "v04-c0191",
  "title": "第一百九十一章 剑来",
  "source_sha256": "81d109bc9b9804da55a322da3ed77ca4e318542ccfd97c619ff6e8938acf0bd5",
  "chapter_sha256": "628c582e609b088300419160254553325e1110379e7f366e61553650dda19f7f",
  "status": "draft_after_sequential_read",
  "granularity": "chapter_and_scene",
  "stage_id": "V04-S19",
  "pov": "羲拦北斗暗袭被破、顾困羲与人皇剑破场失算",
  "attribution_caution": "人皇剑不同司马天子剑，两人未取宝归家。羲被困北斗重伤alive，法王被逼退未败亡；天罚压制此时实崩，后续能力状态须再读。顾真火路为推断，孟没已识高览姓名。",
  "scenes": [
    {
      "paragraph_start": 1,
      "paragraph_end": 17,
      "label": "谪仙池旁羲挡路与明拳",
      "direction": "孟实见谪仙碑不取池水赶契约。羲前挡自称等久，宗师五太五德拳混淆法理受场压十不一，孟认其路线早到难解，圣德不偷袭是其理解，尚未见真火路线证。",
      "evidence": [
        "v04-c0191:p0001",
        "v04-c0191:p0017"
      ]
    },
    {
      "paragraph_start": 18,
      "paragraph_end": 49,
      "label": "顾容拳后孟夹击圣德滑剑",
      "direction": "羲拳穿顾漩涡，顾一指容劲后荡避锋；场缩差不等神都全禁。孟元始八九适混沌刀分阴阳，变刀越拇指挑肩被护塔泯灭，流火杀刺圣德滑只削发，顾飘带助脱，孟觉暗敌佯乱露破绽。",
      "evidence": [
        "v04-c0191:p0018",
        "v04-c0191:p0049"
      ]
    },
    {
      "paragraph_start": 51,
      "paragraph_end": 56,
      "label": "韩高分路法王借碎空两堵",
      "direction": "六路两台各三明确，高雷路韩火路想顾此失彼，法王融破虚空交替截暂可阻非胜两人。尚没离此或已被杀。",
      "evidence": [
        "v04-c0191:p0051",
        "v04-c0191:p0056"
      ]
    },
    {
      "paragraph_start": 58,
      "paragraph_end": 75,
      "label": "诱北斗重伤退、顾困羲实往前",
      "direction": "北斗偷玉枕改前刺被孟等流火分光击多秘宝碎鲜血重伤退斩妖台，没死亡没缴获。羲五德凤凰闯飘带后顾分虚空牢笼实困，不杀猜真火路抢先前催孟传音。",
      "evidence": [
        "v04-c0191:p0058",
        "v04-c0191:p0075"
      ]
    },
    {
      "paragraph_start": 77,
      "paragraph_end": 83,
      "label": "人皇剑实亮与环境压崩",
      "direction": "高逼退法王但雷路不足三成，担后崔实际摊手喊剑来腰剑亮人族万象，人皇剑由法王惊叫。剑光使整个天罚压制尽崩残龙雷消，法王退几丈未死，不能保持之后十不一限制必持续。",
      "evidence": [
        "v04-c0191:p0077",
        "v04-c0191:p0083"
      ]
    },
    {
      "paragraph_start": 85,
      "paragraph_end": 88,
      "label": "顾失态与孟心理阴影减",
      "direction": "顾感人皇气俏脸变低语剑名，孟称第二次失态，不等全书总共仅两次。从近无破绽转至少也有未料事，心理阴影消些非彻底无戒备或已知其全盘。",
      "evidence": [
        "v04-c0191:p0085",
        "v04-c0191:p0088"
      ]
    }
  ],
